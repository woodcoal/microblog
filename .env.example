# 睦谈环境变量示例
#
# 使用方式：复制为 .env，再按部署环境修改。不要把 .env、生产凭证或真实密钥提交到仓库。
# Node standalone 在每次服务启动时读取当前目录的 .env；修改 .env 后必须重启 ./start.sh 或 PM2 进程。
#
# 最小启动配置：
# 1. DATABASE_PROVIDER / DATABASE_URL：默认 SQLite 配置可直接启动；使用 MySQL 时必须同时替换连接串。
# 2. JWT_SECRET：开发环境可暂用下方占位值，生产环境必须替换为随机且足够长的私密值。
# 3. SITE_URL：部署到非本机地址时应改为站点对外访问的完整 URL。

# ==============================================================================
# 运行环境与站点地址
# 这一组决定数据库、上传文件和站点生成绝对链接的位置；启动前优先确认。
# ==============================================================================

# 数据库驱动：仅支持 sqlite 或 mysql。默认使用 sqlite。
DATABASE_PROVIDER="sqlite"

# 当前运行库：SQLite 使用 file: URL，MySQL 使用 mysql:// URL。
# 相对路径以项目运行目录为基准；生产环境请使用专用数据库和备份策略。
DATABASE_URL="file:./prisma/dev.db"

# 仅供验收测试使用，必须与开发库、生产库完全隔离；不参与站点运行时连接。
TEST_DATABASE_URL="file:./prisma/test.db"

# MySQL 8+ / MariaDB 连接示例：切换 DATABASE_PROVIDER=mysql 后，取消注释并填写安全的连接信息。
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/microblog"
# TEST_DATABASE_URL="mysql://user:password@127.0.0.1:3306/microblog_test"
# MySQL QA 会用该管理连接创建随机临时库，测试后自动删除；不要填生产凭证。
# MYSQL_QA_ADMIN_URL="mysql://qa_user:password@127.0.0.1:3306/dev"
# 当前账号没有 CREATE DATABASE 权限时，显式启用受控的既有 dev QA 库模式。
# 测试结束会删除 dev 库全部业务表；仅可用于专用 QA 库，禁止指向生产库。
# MYSQL_QA_EXISTING_DATABASE="false"
# MYSQL_QA_EXISTING_DATABASE_NAME="dev"

# 站点对外基础 URL，用于生成 canonical、邮件链接、Sitemap 等绝对地址。
# 本地开发可使用 http://localhost:4321；生产环境改为实际的 https URL。
SITE_URL="http://localhost:4321"

# 文件上传目录。当前实现使用本地文件系统，不是对象存储；运行进程必须拥有读写权限。
UPLOAD_DIR="./uploads"

# ==============================================================================
# 认证与安全
# JWT_SECRET 是生产环境必填的私密配置；其余项用于控制会话和外部 API 的安全边界。
# ==============================================================================

# JWT 签名密钥。下方仅为开发占位值，生产环境务必替换，且不要写入日志、提交记录或 issue。
JWT_SECRET="mutan-dev-secret-change-in-production"

# JWT 有效期，单位为天；默认 7 天。修改后新签发的令牌按新值计算。
JWT_EXPIRES_DAYS=7

# ==============================================================================
# 注册、账号与站点内容
# 默认值适合本地启动；按需调整注册开关、站点文案、保留用户名和内容展示策略。
# ==============================================================================

# 是否允许新用户注册。设置为 false 关闭注册；默认 true。
ALLOW_REGISTRATION=true

# 追加保留用户名，多个值用英文逗号分隔；例如 "test,moderator,system"。
# 内置保留词始终生效，不能通过此项覆盖；留空表示不追加。
EXTRA_RESERVED_USERNAMES=""

# 被禁用账号在页面上展示的提示文案。
DISABLED_USER_MESSAGE="该用户已被禁用"

# 站点标题与描述，也会用于页面元信息和 API 文档标题。
SITE_TITLE="睦谈"
SITE_DESCRIPTION="世间纷纷扰扰，此处和睦相谈"

# 站点 Logo/Favicon 的绝对或站点内 URL；留空分别回退到 public/logo.svg 和 public/favicon.svg。
SITE_LOGO_URL=""
SITE_FAVICON_URL=""

# 启用的内容模式，英文逗号分隔；合法值为 weibo、forum、blog，至少保留一个。
# 默认开放三种模式；例如只运行论坛可写为 SITE_MODES="forum"。
SITE_MODES="weibo,forum,blog"

# 各模式的显示名称，留空使用默认名称“微博 / 论坛 / 博客”。
# 仅需改展示文案时配置对应项，不要改模式标识本身。
# SITE_MODE_WEIBO="微博"
# SITE_MODE_FORUM="论坛"
# SITE_MODE_BLOG="博客"

# 全站最多置顶帖子数，以及每个用户最多置顶帖子数。
MAX_GLOBAL_PINNED_POSTS=3
MAX_USER_PINNED_POSTS=1

# 热门排序公式，必须是单行 JSON；权重范围为 0-10，decayHours 范围为 1-720，不能把全部权重设为 0。
# version 当前使用 v2；无效 JSON 或越界值会回退到内置默认值。
TRENDING_FORMULA='{"version":"v2","wLikes":1,"wBookmarks":2,"wComments":3,"decayHours":48}'

# 微博媒体区域最大宽度，单位 px；必须是 480-1920 的整数，默认 640。
WEIBO_MEDIA_MAX_WIDTH_PX=640

# 帖子密码验证有效期当前由运行时代码固定为 10 分钟，暂无可配置环境变量。

# ==============================================================================
# 邮箱验证与邮件投递
# 令牌有效期/重发冷却均为分钟或秒；邮件默认不投递，避免开发测试误发真实邮件。
# 邮件默认禁用。管理员保存 SMTP 后，SMTP 永远优先于旧 webhook。
# ==============================================================================

# 邮箱验证链接有效期（分钟）和同一账号的重发冷却（秒）。默认 30 / 60。
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# 找回密码令牌有效期（分钟）和同一账号的请求冷却（秒）。默认 30 / 60。
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# 安全换绑邮箱令牌有效期（分钟）和重发冷却（秒）。默认 30 / 60。
EMAIL_CHANGE_TOKEN_TTL_MINUTES=30
EMAIL_CHANGE_RESEND_COOLDOWN_SECONDS=60

# 邮件投递模式：disabled（默认，不投递）、test（测试占位，不投递）或 webhook（调用受信任网关）。
MAIL_DELIVERY_MODE="disabled"

# 仅 MAIL_DELIVERY_MODE=webhook 时需要：填写接收邮件请求的 HTTP/HTTPS webhook 地址；生产环境建议使用 HTTPS。
# MAIL_DELIVERY_WEBHOOK_URL="https://mail-gateway.example.internal/send"

# 可选的 webhook Authorization 请求头。只能放在运行期机密配置中，禁止提交真实令牌。
# MAIL_DELIVERY_WEBHOOK_AUTHORIZATION="Bearer <runtime-secret>"

# SMTP 密码加密密钥。开发环境可不设置（不配置 SMTP 密码时无需）；
# 生产环境建议设置为随机 32 字节的 base64 或 64 位 hex；禁止提交真实值。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CONFIG_ENCRYPTION_KEY="<base64-32-byte-key>"

# ==============================================================================
# 外部 API 安全
# 这一组控制 /api/v1 与 /api/agent 的开关、跨域来源、限流和请求体上限。
# ==============================================================================

# 是否启用两组外部 API；默认均启用。设为 false 时对应入口返回 404。
API_V1_ENABLED=true
API_AGENT_ENABLED=true

# Agent 服务端入口密钥。启用 Agent API 时必须提供，不能留空；生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_AGENT_KEY="<generate-a-32-byte-secret>"

# 是否向公网公开 /api/docs 和 /api/docs.json。false 时仅回环、RFC 1918 私有网段及链路本地 IP 可访问。
# 反向代理部署时，Astro Node adapter 看到的是代理连接地址；代理必须位于受信任内网，且不要把客户端转发头当作访问凭据。
API_DOCS_PUBLIC=false

# CORS 来源白名单：self 表示当前站点同源；多个绝对来源用英文逗号分隔，不支持通配符。
API_CORS_ORIGINS="self"

# 每个 IP + 路由的限流窗口（秒），以及读、写、上传请求的次数上限。
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_READ=60
API_RATE_LIMIT_WRITE=20
API_RATE_LIMIT_UPLOAD=10

# 普通请求体和上传请求体上限，单位为字节。
# 上传入口仅由 API_UPLOAD_BODY_LIMIT_BYTES 控制，不与普通请求上限互相抬高。
# 当前示例约为 1 MiB / 10 MiB。
API_BODY_LIMIT_BYTES=1048576
API_UPLOAD_BODY_LIMIT_BYTES=10485760

# ==============================================================================
# 日志、观测与开发调试
# 当前代码没有额外的日志级别、监控地址或调试开关环境变量；日志按进程标准输出/错误输出处理。
# 不要在此自行添加未被运行时代码读取的配置项。
# ==============================================================================
