# 数据库连接（本地 SQLite）
DATABASE_URL="file:./prisma/dev.db"

# JWT 密钥（生产环境务必更换）
JWT_SECRET="mutan-dev-secret-change-in-production"

# JWT 有效期（天）
JWT_EXPIRES_DAYS=7

# 上传目录（本地开发）
UPLOAD_DIR="./uploads"

# 站点 URL（用于生成绝对链接）
SITE_URL="http://localhost:4321"

# 站点设置
SITE_TITLE="睦谈"
SITE_DESCRIPTION="世间纷纷扰扰，此处和睦相谈"
# 站点 Logo URL（留空则使用 public/logo.svg）
SITE_LOGO_URL=""
# 站点 Favicon URL（留空则使用 public/favicon.svg）
SITE_FAVICON_URL=""
ALLOW_REGISTRATION=true
PASSWORD_PROTECT_EXPIRE_MINUTES=10
DISABLED_USER_MESSAGE="该用户已被禁用"
MAX_GLOBAL_PINNED_POSTS=3
MAX_USER_PINNED_POSTS=1
TRENDING_FORMULA=""

# 额外保留用户名（逗号分隔，追加到内置保留词列表）
EXTRA_RESERVED_USERNAMES=""

# 启用的站点模式，逗号分隔（weibo, forum, blog），至少选一个
SITE_MODES=weibo, forum, blog

# Gorse 推荐引擎（未设置 GORSE_ENDPOINT 则全局停用推荐功能）
# gorse-in-one 单节点模式端口为 8088，集群模式 Server 节点端口为 8087
# GORSE_ENDPOINT="http://127.0.0.1:8088"
# GORSE_API_KEY=""
