# 数据库类型：sqlite（默认）或 mysql。切换后请重新执行 db:generate 和 db:migrate。
DATABASE_PROVIDER="sqlite"

# SQLite 连接（默认）
DATABASE_URL="file:./prisma/dev.db"
TEST_DATABASE_URL="file:./prisma/test.db"

# MySQL 8+ 连接示例：切换时将 DATABASE_PROVIDER 改为 mysql，并替换上面两项。
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/microblog"
# TEST_DATABASE_URL="mysql://user:password@127.0.0.1:3306/microblog_test"

# JWT 密钥（生产环境务必更换）
JWT_SECRET="mutan-dev-secret-change-in-production"

# JWT 有效期（天）
JWT_EXPIRES_DAYS=7

# 上传目录（本地开发）
UPLOAD_DIR="./uploads"

# 站点 URL（用于生成绝对链接）
SITE_URL="http://localhost:4321"

# 邮箱验证。默认 disabled：开发/测试绝不发送真实邮件；生产可选受信任 webhook 网关。
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# 密码重置令牌与邮箱验证令牌用途隔离；请求始终返回同一语义，避免账号枚举。
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
MAIL_DELIVERY_MODE=disabled
# MAIL_DELIVERY_MODE=webhook
# MAIL_DELIVERY_WEBHOOK_URL="https://mail-gateway.example.internal/send"
# 仅在运行期机密配置中提供，不得提交。
# MAIL_DELIVERY_WEBHOOK_AUTHORIZATION="Bearer ..."

# 站点设置
SITE_TITLE="睦谈"
SITE_DESCRIPTION="世间纷纷扰扰，此处和睦相谈"
# 站点 Logo URL（留空则使用 public/logo.svg）
SITE_LOGO_URL=""
# 站点 Favicon URL（留空则使用 public/favicon.svg）
SITE_FAVICON_URL=""
ALLOW_REGISTRATION=true
PASSWORD_PROTECT_EXPIRE_MINUTES=10
DISABLED_USER_MESSAGE="该用户已被禁用"
MAX_GLOBAL_PINNED_POSTS=3
MAX_USER_PINNED_POSTS=1
TRENDING_FORMULA='{"version":"v2","wLikes":1,"wBookmarks":2,"wComments":3,"decayHours":48}'
# 微博媒体区域最大宽度（px，480-1920 的整数，默认 640）
WEIBO_MEDIA_MAX_WIDTH_PX=640

# API 安全基线
# CORS 来源白名单，self 表示当前请求的同源地址；多个来源用逗号分隔
API_CORS_ORIGINS=self
# 是否启用 /api/v1 外部 JSON API（默认 true）
API_V1_ENABLED=true
# 是否启用 /api/agent 兼容 API（默认 true）
API_AGENT_ENABLED=true
# 限流窗口（秒）及每个 IP + 路由的请求数上限
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_READ=60
API_RATE_LIMIT_WRITE=20
API_RATE_LIMIT_UPLOAD=10
# API 普通请求体和上传请求体上限（字节）
API_BODY_LIMIT_BYTES=1048576
API_UPLOAD_BODY_LIMIT_BYTES=10485760

# 额外保留用户名（逗号分隔，追加到内置保留词列表）
EXTRA_RESERVED_USERNAMES=""

# 启用的站点模式，逗号分隔（weibo, forum, blog），至少选一个
SITE_MODES=weibo, forum, blog

# 模式显示别名（留空使用默认名称：微博/论坛/博客）
# SITE_MODE_WEIBO=微博
# SITE_MODE_FORUM=论坛
# SITE_MODE_BLOG=博客
