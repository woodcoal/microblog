{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"$description": "轻量级多用户社区的内容优先界面规范；以克制的信息层级、可读性和跨频道一致性为核心。",
	"color": {
		"$type": "color",
		"primary": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.31, 0.275, 0.898],
				"hex": "#4f46e5"
			}
		},
		"primaryHover": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.263, 0.22, 0.792],
				"hex": "#4338ca"
			}
		},
		"text": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.102, 0.102, 0.18],
				"hex": "#1a1a2e"
			}
		},
		"muted": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.392, 0.455, 0.545],
				"hex": "#64748b"
			}
		},
		"background": {
			"$value": {
				"colorSpace": "srgb",
				"components": [1, 1, 1],
				"hex": "#ffffff"
			}
		},
		"surface": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.973, 0.98, 0.988],
				"hex": "#f8fafc"
			}
		},
		"border": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.886, 0.91, 0.941],
				"hex": "#e2e8f0"
			}
		},
		"danger": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.937, 0.267, 0.267],
				"hex": "#ef4444"
			}
		},
		"success": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.082, 0.502, 0.239],
				"hex": "#15803d"
			}
		}
	},
	"spacing": {
		"1": {
			"$value": {
				"value": 4,
				"unit": "px"
			}
		},
		"2": {
			"$value": {
				"value": 8,
				"unit": "px"
			}
		},
		"3": {
			"$value": {
				"value": 12,
				"unit": "px"
			}
		},
		"4": {
			"$value": {
				"value": 16,
				"unit": "px"
			}
		},
		"5": {
			"$value": {
				"value": 20,
				"unit": "px"
			}
		},
		"6": {
			"$value": {
				"value": 24,
				"unit": "px"
			}
		},
		"8": {
			"$value": {
				"value": 32,
				"unit": "px"
			}
		},
		"10": {
			"$value": {
				"value": 40,
				"unit": "px"
			}
		},
		"12": {
			"$value": {
				"value": 48,
				"unit": "px"
			}
		},
		"$type": "dimension"
	},
	"rounded": {
		"$type": "dimension",
		"sm": {
			"$value": {
				"value": 6,
				"unit": "px"
			}
		},
		"md": {
			"$value": {
				"value": 8,
				"unit": "px"
			}
		},
		"lg": {
			"$value": {
				"value": 12,
				"unit": "px"
			}
		},
		"xl": {
			"$value": {
				"value": 16,
				"unit": "px"
			}
		}
	},
	"typography": {
		"display": {
			"$type": "typography",
			"$value": {
				"fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans SC, Microsoft YaHei, sans-serif",
				"fontSize": {
					"value": 2.75,
					"unit": "rem"
				},
				"fontWeight": 800,
				"letterSpacing": {
					"value": -0.055,
					"unit": "em"
				}
			}
		},
		"h1": {
			"$type": "typography",
			"$value": {
				"fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans SC, Microsoft YaHei, sans-serif",
				"fontSize": {
					"value": 1.75,
					"unit": "rem"
				},
				"fontWeight": 800,
				"letterSpacing": {
					"value": -0.04,
					"unit": "em"
				}
			}
		},
		"body-md": {
			"$type": "typography",
			"$value": {
				"fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans SC, Microsoft YaHei, sans-serif",
				"fontSize": {
					"value": 0.9375,
					"unit": "rem"
				},
				"fontWeight": 400
			}
		}
	}
}
