		"@prisma/adapter-libsql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@scalar/api-reference": "^1.57.5",
		"astro": "^6.4.4",
		"bcryptjs": "^3.0.3",
		"dompurify": "^3.4.8",
		"dotenv": "^17.4.2",
		"jose": "^6.2.3",
		"marked": "^18.0.5",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@prisma/config": "^7.8.0",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"prettier": "^3.8.3",
