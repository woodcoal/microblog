{
	"name": "mutan",
	"type": "module",
	"version": "1.26.817",
	"description": "睦谈 — 轻量级多用户微博系统",
	"author": "MuTan",
	"license": "MIT",
	"homepage": "https://github.com/woodcoal/microblog",
	"repository": {
		"type": "git",
		"url": "https://github.com/woodcoal/microblog.git"
	},
	"bugs": {
		"url": "https://github.com/woodcoal/microblog/issues"
	},
	"private": true,
	"scripts": {
		"typecheck": "astro check",
		"lint": "eslint .",
		"lint:format": "npm run format:check",
		"db:prepare": "prisma generate && prisma migrate deploy",
		"predev": "npm run db:prepare",
		"dev": "astro dev",
		"prebuild": "npm run db:prepare",
		"build": "astro build",
		"prestart": "npm run db:prepare",
		"preview": "astro preview",
		"start": "node -r dotenv/config dist/server/entry.mjs",
		"prepm2": "npm run db:prepare",
		"pm2": "pm2 start ecosystem.config.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:status": "prisma migrate status",
		"db:studio": "prisma studio",
		"db:seed": "npx tsx prisma/seed.ts",
		"db:setup": "prisma generate && prisma migrate deploy && npx tsx prisma/seed.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:api-v1": "node scripts/run-api-test.mjs api-v1",
		"test:api-agent": "node scripts/run-api-test.mjs api-agent",
		"test:password-reset-delivery-failure": "node scripts/run-api-test.mjs password-reset-delivery-failure",
		"test:admin-auth": "node scripts/run-api-test.mjs admin-auth",
		"test:admin-audit": "node scripts/run-admin-audit-test.mjs",
		"test:mysql-qa": "node scripts/run-mysql-qa.mjs",
		"test:admin-moderation-ui": "tsx --test tests/admin-moderation-ui.test.ts",
		"test:blog-assets": "node scripts/run-blog-assets-test.mjs",
		"test:blog-assets-ui": "tsx --test tests/blog-assets-ui.test.ts",
		"test:site-copy": "tsx --test tests/site-copy-renderer.test.ts",
		"test:site-config": "tsx --test tests/site-config.test.ts",
		"test:color-contrast": "tsx --test tests/primary-color-contrast.test.ts",
		"test:post-detail-browser": "node scripts/run-post-detail-browser-test.mjs",
		"test:recommend-users": "node scripts/run-recommend-users-test.mjs",
		"pub": "node scripts/pack-output.mjs"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.2",
		"@astrojs/react": "^6.0.2",
		"@libsql/client": "^0.17.4",
		"@prisma/adapter-libsql": "^7.9.1",
		"@prisma/adapter-mariadb": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@scalar/api-reference": "^1.65.0",
		"@tiptap/core": "^3.30.1",
		"@tiptap/extension-bubble-menu": "^3.30.1",
		"@tiptap/extension-code-block-lowlight": "^3.30.1",
		"@tiptap/extension-image": "^3.30.1",
		"@tiptap/extension-link": "^3.30.1",
		"@tiptap/extension-placeholder": "^3.30.1",
		"@tiptap/extension-task-item": "^3.30.1",
		"@tiptap/extension-task-list": "^3.30.1",
		"@tiptap/extension-underline": "^3.30.1",
		"@tiptap/pm": "^3.30.1",
		"@tiptap/react": "^3.30.1",
		"@tiptap/starter-kit": "^3.30.1",
		"@tiptap/suggestion": "^3.30.1",
		"astro": "^7.2.2",
		"bcryptjs": "^3.0.3",
		"dompurify": "^3.4.13",
		"dotenv": "^17.4.2",
		"jose": "^6.2.8",
		"lowlight": "^3.3.0",
		"mariadb": "^3.5.3",
		"marked": "^18.0.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tippy.js": "^6.3.7",
		"tiptap-markdown": "^0.9.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@prisma/config": "^7.9.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prisma": "^7.9.1",
		"puppeteer": "^25.7.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"allowScripts": {
		"@prisma/engines@7.8.0": true,
		"esbuild@0.27.7": true,
		"esbuild@0.28.0": true,
		"prisma@7.8.0": true,
		"sharp@0.34.5": true
	}
}