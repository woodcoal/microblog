	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"start": "node -r dotenv/config dist/server/entry.mjs",
		"pm2": "pm2 start ecosystem.config.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
