---
/**
 * 频道列表页的辅助发现区。
 *
 * 只接受页面已查询到的真实入口数据，避免为布局填充虚构内容；在窄屏由
 * 内容壳收起，主列表仍保持完整可用。
 */
export interface ChannelAsideItem {
	title: string;
	href: string;
	meta?: string;
	icon?: string;
}

export interface ChannelAsideSection {
	title: string;
	description?: string;
	items: ChannelAsideItem[];
}

interface Props {
	/** 发现区块最多展示两个，避免右栏喧宾夺主。 */
	sections: ChannelAsideSection[];
	label?: string;
}

const { sections, label = '发现内容' } = Astro.props;
const visibleSections = sections
	.filter((section) => section.items.length > 0)
	.slice(0, 2)
	.map((section) => ({ ...section, items: section.items.slice(0, 5) }));
---

{
	visibleSections.length > 0 && (
		<aside class="channel-aside" aria-label={label}>
			{visibleSections.map((section) => (
				<section
					class="channel-aside-section"
					aria-labelledby={`channel-aside-${section.title}`}
				>
					<h2 class="channel-aside-title" id={`channel-aside-${section.title}`}>
						{section.title}
					</h2>
					{section.description && (
						<p class="channel-aside-description">{section.description}</p>
					)}
					<nav class="channel-aside-list" aria-label={`${section.title}入口`}>
						{section.items.map((item) => (
							<a href={item.href} class="channel-aside-link">
								{item.icon && (
									<span class="channel-aside-icon" aria-hidden="true">
										{item.icon}
									</span>
								)}
								<span class="channel-aside-copy">
									<span class="channel-aside-item-title">{item.title}</span>
									{item.meta && (
										<span class="channel-aside-meta">{item.meta}</span>
									)}
								</span>
							</a>
						))}
					</nav>
				</section>
			))}
		</aside>
	)
}
