---
/**
 * 内容浏览页的统一响应式壳。
 *
 * 左侧由频道或搜索导航填充，中间保持受控阅读列，右侧只在页面提供真实发现
 * 数据时渲染。任务型页面不使用此组件，避免为布局挤压其主流程。
 */
interface Props {
	/** 左侧导航的无障碍名称；single 变体不渲染导航。 */
	navLabel?: string;
	/** 允许页面在发现数据为空时显式收起右栏。 */
	hasAside?: boolean;
	/** 由页面语义而非频道名称决定的布局形态。 */
	variant?: 'three-column' | 'nav-main' | 'main-aside' | 'single';
}

const {
	navLabel,
	hasAside = Astro.slots.has('aside'),
	variant = hasAside ? 'three-column' : 'nav-main'
} = Astro.props;
const rendersNav = variant === 'three-column' || variant === 'nav-main';
const rendersAside = hasAside && (variant === 'three-column' || variant === 'main-aside');
---

<div class="channel-shell-frame">
	<div class:list={['channel-shell', `channel-shell--${variant}`]}>
		{
			rendersNav && (
				<aside class="channel-shell__nav layout-sidebar" aria-label={navLabel}>
					<slot name="nav" />
				</aside>
			)
		}
		<main class="channel-shell__main layout-main">
			<slot />
		</main>
		{
			rendersAside && (
				<aside class="channel-shell__aside" aria-label="辅助内容">
					<slot name="aside" />
				</aside>
			)
		}
	</div>
</div>

<script>
	const tooltipId = 'channel-navigation-tooltip';
	const tabletQuery = globalThis.matchMedia('(min-width: 768px) and (max-width: 1023px)');
	const tooltip =
		document.getElementById(tooltipId) ??
		document.body.appendChild(document.createElement('div'));

	tooltip.id = tooltipId;
	tooltip.className = 'channel-navigation-tooltip';
	tooltip.setAttribute('role', 'tooltip');
	tooltip.setAttribute('aria-hidden', 'true');

	let activeLink: HTMLAnchorElement | undefined;

	function positionTooltip(link: HTMLAnchorElement) {
		const bounds = link.getBoundingClientRect();
		const navigationBounds = link
			.closest<HTMLElement>('.channel-shell__nav')
			?.getBoundingClientRect();
		tooltip.style.left = `${Math.round((navigationBounds?.right ?? bounds.right) + 8)}px`;
		tooltip.style.top = `${Math.round(bounds.top + bounds.height / 2)}px`;
	}

	function showTooltip(link: HTMLAnchorElement) {
		if (!tabletQuery.matches) return;
		const label = link.getAttribute('aria-label');
		if (!label) return;

		activeLink?.removeAttribute('aria-describedby');
		activeLink = link;
		tooltip.textContent = label;
		link.setAttribute('aria-describedby', tooltipId);
		tooltip.dataset.visible = 'true';
		tooltip.setAttribute('aria-hidden', 'false');
		positionTooltip(link);
	}

	function hideTooltip(link?: HTMLAnchorElement) {
		if (link && link !== activeLink) return;
		activeLink?.removeAttribute('aria-describedby');
		activeLink = undefined;
		delete tooltip.dataset.visible;
		tooltip.setAttribute('aria-hidden', 'true');
	}

	for (const navigation of document.querySelectorAll<HTMLElement>('.channel-shell__nav')) {
		navigation.addEventListener('pointerover', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>(
				'.sidebar-link[aria-label]'
			);
			if (link && navigation.contains(link)) showTooltip(link);
		});
		navigation.addEventListener('pointerout', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>(
				'.sidebar-link[aria-label]'
			);
			if (link && !link.contains(event.relatedTarget as Node | null)) hideTooltip(link);
		});
		navigation.addEventListener('focusin', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>(
				'.sidebar-link[aria-label]'
			);
			if (link && navigation.contains(link)) showTooltip(link);
		});
		navigation.addEventListener('focusout', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>(
				'.sidebar-link[aria-label]'
			);
			if (link) hideTooltip(link);
		});
	}

	addEventListener('resize', () => {
		if (activeLink) showTooltip(activeLink);
	});
	addEventListener(
		'scroll',
		() => {
			if (activeLink) positionTooltip(activeLink);
		},
		{ capture: true }
	);
	tabletQuery.addEventListener('change', () => hideTooltip());
</script>
