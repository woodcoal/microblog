---
/**
 * 内容浏览列表的共享三栏壳。
 *
 * 左侧由频道或搜索导航填充，中间保持受控阅读列，右侧只在页面提供真实发现
 * 数据时渲染。任务型页面不使用此组件，避免为布局挤压其主流程。
 */
interface Props {
	/** 左侧导航的无障碍名称。 */
	navLabel: string;
	/** 允许页面在发现数据为空时显式收起右栏。 */
	hasAside?: boolean;
	/** 频道可选的响应式布局变体。 */
	variant?: 'forum';
}

const { navLabel, hasAside = Astro.slots.has('aside'), variant } = Astro.props;
---

<div
	class:list={[
		'layout-wide',
		{ 'layout-wide-with-aside': hasAside, 'layout-wide-forum': variant === 'forum' }
	]}
>
	<aside class="layout-sidebar" aria-label={navLabel}>
		<slot name="nav" />
	</aside>
	<div class="layout-main">
		<slot />
	</div>
	{
		hasAside && (
			<div class="layout-discovery-sidebar">
				<slot name="aside" />
			</div>
		)
	}
</div>
