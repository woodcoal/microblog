---
/** 可复用的原生悬浮菜单壳，调用方通过默认插槽提供菜单内容。 */
interface Props {
	label: string;
	className?: string;
}

const { label, className } = Astro.props;
---

<details class:list={['floating-menu', className]}>
	<summary aria-label={label} title={label}>
		<span class="floating-menu-icon" aria-hidden="true">☰</span>
		<span class="sr-only">{label}</span>
	</summary>
	<div class="floating-menu-panel">
		<slot />
	</div>
</details>
