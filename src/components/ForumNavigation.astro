---
/**
 * 论坛频道的大屏侧栏导航。
 *
 * 窄屏的入口由 ForumFloatingMenu 放入各页面的文案区；本组件只负责大屏侧栏，
 * 避免同一 DOM 同时承担两种定位方式。
 */
import ForumNavigationItems from './ForumNavigationItems.astro';

interface Props {
	/** 主题详情沿用同一菜单内容，仅追加详情页侧栏定位类。 */
	presentation?: 'channel' | 'detail';
}

const { presentation = 'channel' } = Astro.props;
---

<nav
	class:list={[
		'forum-category-sidebar',
		'forum-navigation--sidebar',
		{ 'post-detail-local-nav': presentation === 'detail' }
	]}
	aria-label="论坛导航"
>
	<ForumNavigationItems idPrefix="forum-sidebar" />
</nav>
