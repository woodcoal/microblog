---
/**
 * 论坛频道的大屏侧栏导航。
 *
 * 窄屏的入口由 ForumTopMenu 放入页面顶部；本组件只负责大屏侧栏，
 * 避免同一 DOM 同时承担两种定位方式。
 */
import ForumNavigationItems from './ForumNavigationItems.astro';
---

<nav class="forum-category-sidebar forum-navigation--sidebar" aria-label="论坛导航">
	<ForumNavigationItems idPrefix="forum-sidebar" />
</nav>
