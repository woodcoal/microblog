---
/**
 * 帖子编辑表单组件（Astro 原生版本）
 *
 * 预填充当前内容，提供字数统计、图片/附件管理，
 * 使用 Astro Actions 替代 fetch API 调用。
 * 提交成功后跳转到帖子详情页。
 */
import { actions } from 'astro:actions';
import { POST_CONTENT_MAX_LENGTH } from '@/lib/config';

/** 已有媒体信息（从服务端传入） */
interface ExistingMedia {
	/** Media 记录 ID */
	id: string;
	/** FileStorage 记录 ID */
	fileStorageId: string;
	/** 文件类型 */
	fileType: string;
	/** 原始文件名 */
	originalName: string;
	/** 文件访问 URL */
	url: string;
}

/**
 * 组件属性
 *
 * @property postId - 帖子 ID
 * @property initialContent - 当前帖子内容（用于预填充）
 * @property username - 作者用户名（用于跳转）
 * @property initialMedia - 当前帖子的媒体列表
 * @property initialVisibility - 当前可见度设置
 */
interface Props {
	postId: string;
	initialContent: string;
	username: string;
	initialMedia?: ExistingMedia[];
	initialVisibility?: string;
}

const {
	postId,
	initialContent,
	username,
	initialMedia = [],
	initialVisibility = 'public'
} = Astro.props;

// 编辑框不应显示历史模板或回显数据带入的前导空白。
const initialEditorContent = initialContent.trimStart();

/** 图片最大数量 */
const MAX_IMAGES = 9;

// 分类已有媒体
const existingImages = initialMedia.filter((m) => m.fileType === 'image');
const existingAttachments = initialMedia.filter((m) => m.fileType === 'attachment');

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasExistingImages = existingImages.length > 0;
const hasExistingAttachments = existingAttachments.length > 0;
const initialImageCount = existingImages.length;
const canAddImage = initialImageCount < MAX_IMAGES;

// 将已有媒体数据序列化为 JSON，供客户端脚本使用
const existingMediaJson = JSON.stringify(initialMedia);
---

<form
	class="post-edit-form"
	id={`post-edit-form-${postId}`}
	data-post-id={postId}
	data-username={username}
	data-max-images={MAX_IMAGES}
	data-max-length={POST_CONTENT_MAX_LENGTH}
	data-existing-media={existingMediaJson}
>
	<div class="form-group">
		<textarea
			class="form-input post-edit-textarea"
			placeholder="编辑你的帖子..."
			maxlength={POST_CONTENT_MAX_LENGTH}
			rows="6"
			aria-label="帖子内容"
			set:text={initialEditorContent}
		/>

		<!-- 可见度选择器 -->
		<div class="post-edit-visibility">
			<select class="form-input post-edit-visibility-select" name="visibility">
				<option value="public" selected={initialVisibility === 'public'}>🌐 公开</option>
				<option value="logged_in" selected={initialVisibility === 'logged_in'}
					>🔐 登录用户可见</option
				>
				<option value="followers" selected={initialVisibility === 'followers'}
					>👥 粉丝可见</option
				>
				<option value="following" selected={initialVisibility === 'following'}
					>🤝 我关注的人可见</option
				>
				<option value="private" selected={initialVisibility === 'private'}
					>🔒 仅自己可见</option
				>
				<option value="password" selected={initialVisibility === 'password'}
					>🔑 密码保护</option
				>
				<option value="users" selected={initialVisibility === 'users'}
					>👤 指定用户可见</option
				>
			</select>
		</div>

		<!-- 密码输入框（visibility=password 时显示） -->
		<div
			class="post-edit-password-field"
			style={initialVisibility === 'password' ? '' : 'display:none'}
		>
			<input
				type="password"
				class="form-input"
				name="postPassword"
				placeholder="设置新密码（留空则保持原密码）..."
			/>
		</div>

		<!-- 用户名输入框（visibility=users 时显示） -->
		<div
			class="post-edit-users-field"
			style={initialVisibility === 'users' ? '' : 'display:none'}
		>
			<input
				type="text"
				class="form-input"
				name="allowedUsernames"
				placeholder="输入用户名，逗号分隔（如：alice,bob）"
			/>
		</div>

		<!-- 当前图片 -->
		{
			hasExistingImages && (
				<div class="post-edit-section" data-section="existing-images">
					<h4 class="post-edit-section-title">当前图片</h4>
					<div class="post-edit-previews">
						{existingImages.map((media) => (
							<div
								class="post-edit-preview-item"
								data-media-id={media.id}
								data-file-storage-id={media.fileStorageId}
								data-file-type={media.fileType}
							>
								<img src={media.url} alt={media.originalName} />
								<button
									type="button"
									class="post-edit-preview-remove"
									data-action="remove-existing"
								>
									×
								</button>
							</div>
						))}
					</div>
				</div>
			)
		}

		<!-- 新上传图片容器 -->
		<div class="post-edit-section" data-section="new-images" style="display:none">
			<h4 class="post-edit-section-title">新增图片</h4>
			<div class="post-edit-previews"></div>
		</div>

		<!-- 当前附件 -->
		{
			hasExistingAttachments && (
				<div class="post-edit-section" data-section="existing-attachments">
					<h4 class="post-edit-section-title">当前附件</h4>
					<div class="post-edit-attachments">
						{existingAttachments.map((media) => (
							<div
								class="post-edit-attachment-item"
								data-media-id={media.id}
								data-file-storage-id={media.fileStorageId}
								data-file-type={media.fileType}
							>
								<span>📎 {media.originalName}</span>
								<button
									type="button"
									class="post-edit-attachment-remove"
									data-action="remove-existing"
								>
									删除
								</button>
							</div>
						))}
					</div>
				</div>
			)
		}

		<!-- 新上传附件容器 -->
		<div class="post-edit-section" data-section="new-attachments" style="display:none">
			<h4 class="post-edit-section-title">新增附件</h4>
			<div class="post-edit-attachments"></div>
		</div>

		<!-- 上传按钮 -->
		<div class="post-edit-upload" role="button" aria-label="拖拽或点击上传文件">
			{
				canAddImage && (
					<label class="post-edit-upload-btn">
						<input
							type="file"
							accept="image/*"
							multiple
							class="post-edit-file-input"
							data-upload-type="image"
							style="display:none"
						/>
						📷 添加图片
					</label>
				)
			}
			<label class="post-edit-upload-btn">
				<input
					type="file"
					accept=".pdf,.zip,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rar,.7z"
					multiple
					class="post-edit-file-input"
					data-upload-type="attachment"
					style="display:none"
				/>
				📎 添加附件
			</label>
			<span class="post-edit-upload-count">
				图片 {initialImageCount}/{MAX_IMAGES}
			</span>
		</div>

		<div class="post-edit-footer">
			<span class="post-edit-count" data-count-display>
				{initialEditorContent.length}/{POST_CONTENT_MAX_LENGTH}
			</span>
			<div class="post-edit-actions">
				<a href={`/${username}/${postId}`} class="btn btn-outline">取消</a>
				<button
					class="btn btn-primary"
					type="submit"
					disabled={!initialEditorContent.trim()}
				>
					保存修改
				</button>
			</div>
		</div>
	</div>
	<p class="form-error" data-error-display style="display:none"></p>
</form>

<script>
	/**
	 * 帖子编辑表单客户端交互逻辑
	 *
	 * 功能：
	 * - 拦截 form submit，调用 actions.updatePost
	 * - 图片上传：调用 actions.uploadMedia
	 * - 可见度切换时显示/隐藏密码和用户输入框
	 * - 字数统计实时更新
	 * - 保存成功后跳转到帖子详情页
	 */
	import { actions } from 'astro:actions';
	import { escapeHtml } from '@/lib/html';

	// 为所有编辑表单绑定事件
	document.querySelectorAll<HTMLFormElement>('.post-edit-form').forEach((form) => {
		const textarea = form.querySelector<HTMLTextAreaElement>('.post-edit-textarea')!;
		const visibilitySelect = form.querySelector<HTMLSelectElement>(
			'.post-edit-visibility-select'
		)!;
		const passwordField = form.querySelector<HTMLDivElement>('.post-edit-password-field');
		const usersField = form.querySelector<HTMLDivElement>('.post-edit-users-field');
		const countDisplay = form.querySelector<HTMLSpanElement>('[data-count-display]')!;
		const errorDisplay = form.querySelector<HTMLParagraphElement>('[data-error-display]')!;
		const submitBtn = form.querySelector<HTMLButtonElement>('.btn-primary')!;
		const uploadCount = form.querySelector<HTMLSpanElement>('.post-edit-upload-count');
		const newImagesSection = form.querySelector<HTMLElement>('[data-section="new-images"]');
		const newImagesContainer =
			newImagesSection?.querySelector<HTMLElement>('.post-edit-previews');
		const newAttachmentsSection = form.querySelector<HTMLElement>(
			'[data-section="new-attachments"]'
		);
		const newAttachmentsContainer =
			newAttachmentsSection?.querySelector<HTMLElement>('.post-edit-attachments');

		// 从 data 属性读取配置
		const postId = form.dataset.postId || '';
		const username = form.dataset.username || '';
		const maxImages = parseInt(form.dataset.maxImages || '9', 10);
		const maxLength = parseInt(form.dataset.maxLength || '1000', 10);

		// 客户端状态：已有媒体（保留的）和新上传文件
		// 已有媒体：{ id, fileStorageId, fileType, originalName, url }
		let existingMedia: Array<{
			id: string;
			fileStorageId: string;
			fileType: string;
			originalName: string;
			url: string;
		}> = JSON.parse(form.dataset.existingMedia || '[]');

		// 新上传文件：{ id, url, fileType, originalName }
		let newFiles: Array<{
			id: string;
			url: string;
			fileType: string;
			originalName: string;
		}> = [];

		let uploading = false;
		let loading = false;

		if (!textarea || !visibilitySelect || !countDisplay || !errorDisplay || !submitBtn) return;

		/**
		 * 显示错误信息
		 *
		 * @param message - 错误提示文本
		 */
		function showError(message: string) {
			errorDisplay.textContent = message;
			errorDisplay.style.display = 'block';
		}

		/** 隐藏错误信息 */
		function hideError() {
			errorDisplay.style.display = 'none';
			errorDisplay.textContent = '';
		}

		/**
		 * 计算当前图片总数（已有 + 新增）
		 */
		function getImageCount(): number {
			const existingImageCount = existingMedia.filter((m) => m.fileType === 'image').length;
			const newImageCount = newFiles.filter((f) => f.fileType === 'image').length;
			return existingImageCount + newImageCount;
		}

		/**
		 * 更新图片计数显示
		 */
		function updateImageCount() {
			if (uploadCount) {
				uploadCount.textContent = `图片 ${getImageCount()}/${maxImages}`;
			}
		}

		/**
		 * 更新字数统计和提交按钮状态
		 */
		function updateCount() {
			const len = textarea.value.length;
			countDisplay.textContent = `${len}/${maxLength}`;

			// 超过 90% 时添加红色样式
			const threshold = maxLength * 0.9;
			if (len > threshold) {
				countDisplay.classList.add('text-danger');
			} else {
				countDisplay.classList.remove('text-danger');
			}

			// 内容非空且未超限时启用提交按钮
			const canSubmit = textarea.value.trim().length > 0 && len <= maxLength;
			submitBtn.disabled = !canSubmit || loading;
		}

		/**
		 * 上传文件到服务器
		 *
		 * 调用 actions.uploadMedia 上传文件，成功后添加到 newFiles 列表并更新 UI。
		 *
		 * @param file - 要上传的 File 对象
		 * @param fileType - 文件类型：'image' 或 'attachment'
		 */
		async function uploadFile(file: File, fileType: 'image' | 'attachment') {
			const formData = new FormData();
			formData.append('file', file);
			formData.append('fileType', fileType);
			const result = await actions.uploadMedia(formData);

			if (result.data) {
				newFiles.push(result.data);
				renderNewFiles();
				updateImageCount();
			} else {
				showError(result.error?.message || '上传失败');
			}
		}

		/**
		 * 渲染新上传文件的预览
		 */
		function renderNewFiles() {
			// 渲染新图片
			const newImages = newFiles.filter((f) => f.fileType === 'image');
			if (newImagesContainer && newImagesSection) {
				if (newImages.length > 0) {
					newImagesSection.style.display = '';
					newImagesContainer.innerHTML = newImages
						.map(
							(file) => `
						<div class="post-edit-preview-item" data-new-file-id="${escapeHtml(file.id)}" data-file-type="${escapeHtml(file.fileType)}">
							<img src="${escapeHtml(file.url)}" alt="${escapeHtml(file.originalName)}" />
							<button type="button" class="post-edit-preview-remove" data-action="remove-new">×</button>
						</div>
					`
						)
						.join('');
				} else {
					newImagesSection.style.display = 'none';
					newImagesContainer.innerHTML = '';
				}
			}

			// 渲染新附件
			const newAttachments = newFiles.filter((f) => f.fileType === 'attachment');
			if (newAttachmentsContainer && newAttachmentsSection) {
				if (newAttachments.length > 0) {
					newAttachmentsSection.style.display = '';
					newAttachmentsContainer.innerHTML = newAttachments
						.map(
							(file) => `
						<div class="post-edit-attachment-item" data-new-file-id="${escapeHtml(file.id)}" data-file-type="${escapeHtml(file.fileType)}">
							<span>📎 ${escapeHtml(file.originalName)}</span>
							<button type="button" class="post-edit-attachment-remove" data-action="remove-new">删除</button>
						</div>
					`
						)
						.join('');
				} else {
					newAttachmentsSection.style.display = 'none';
					newAttachmentsContainer.innerHTML = '';
				}
			}
		}

		// 实时字数统计
		textarea.addEventListener('input', updateCount);

		// 可见度切换时显示/隐藏密码和用户输入框
		visibilitySelect.addEventListener('change', () => {
			const vis = visibilitySelect.value;
			if (passwordField) {
				passwordField.style.display = vis === 'password' ? '' : 'none';
			}
			if (usersField) {
				usersField.style.display = vis === 'users' ? '' : 'none';
			}
		});

		// 文件上传处理
		form.querySelectorAll<HTMLInputElement>('.post-edit-file-input').forEach((input) => {
			input.addEventListener('change', async (e) => {
				const files = (e.target as HTMLInputElement).files;
				if (!files) return;

				const uploadType = input.dataset.uploadType as 'image' | 'attachment';
				hideError();

				// 图片数量限制检查
				if (uploadType === 'image') {
					const remaining = maxImages - getImageCount();
					const imageFiles = Array.from(files).slice(0, remaining);

					if (imageFiles.length === 0) {
						showError(`图片最多 ${maxImages} 张`);
						return;
					}

					uploading = true;
					await Promise.all(imageFiles.map((f) => uploadFile(f, 'image')));
					uploading = false;
				} else {
					uploading = true;
					await Promise.all(Array.from(files).map((f) => uploadFile(f, 'attachment')));
					uploading = false;
				}

				// 清空 file input，允许重复选择同一文件
				input.value = '';
			});
		});

		// 删除已有媒体（事件委托）
		form.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;

			// 删除已有媒体
			if (target.matches('[data-action="remove-existing"]')) {
				const item = target.closest('[data-media-id]');
				if (!item) return;
				const mediaId = (item as HTMLElement).dataset.mediaId || '';
				existingMedia = existingMedia.filter((m) => m.id !== mediaId);
				item.remove();
				updateImageCount();
				return;
			}

			// 删除新上传文件
			if (target.matches('[data-action="remove-new"]')) {
				const item = target.closest('[data-new-file-id]');
				if (!item) return;
				const fileId = (item as HTMLElement).dataset.newFileId || '';
				newFiles = newFiles.filter((f) => f.id !== fileId);
				renderNewFiles();
				updateImageCount();
				return;
			}
		});

		// 表单提交
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			hideError();

			const content = textarea.value.trim();

			// 前端基础校验
			if (!content) {
				showError('请输入帖子内容');
				return;
			}

			if (content.length > maxLength) {
				showError(`内容不能超过 ${maxLength} 个字符`);
				return;
			}

			const visibility = visibilitySelect.value;

			// 可见度相关校验
			if (visibility === 'password') {
				const passwordInput = form.querySelector<HTMLInputElement>(
					'input[name="postPassword"]'
				);
				if (passwordInput && !passwordInput.value.trim()) {
					showError('请设置帖子访问密码');
					return;
				}
			}

			if (visibility === 'users') {
				const usernamesInput = form.querySelector<HTMLInputElement>(
					'input[name="allowedUsernames"]'
				);
				if (usernamesInput && !usernamesInput.value.trim()) {
					showError('请输入允许查看的用户名');
					return;
				}
			}

			loading = true;
			submitBtn.disabled = true;
			submitBtn.textContent = '保存中...';

			// 合并已有媒体和新上传文件的 fileStorageId
			const mediaIds = [
				...existingMedia.map((m) => m.fileStorageId),
				...newFiles.map((f) => f.id)
			];

			// 构建请求参数
			const input: Record<string, unknown> = {
				postId,
				content,
				visibility,
				mediaIds
			};

			// visibility=password 时，添加密码
			if (visibility === 'password') {
				const passwordInput = form.querySelector<HTMLInputElement>(
					'input[name="postPassword"]'
				);
				if (passwordInput) {
					input.password = passwordInput.value.trim();
				}
			}

			// visibility=users 时，查询用户名对应的用户 ID
			if (visibility === 'users') {
				const usernamesInput = form.querySelector<HTMLInputElement>(
					'input[name="allowedUsernames"]'
				);
				if (usernamesInput) {
					const usernames = usernamesInput.value
						.split(',')
						.map((s) => s.trim())
						.filter(Boolean);

					if (usernames.length > 0) {
						const searchResult = await actions.searchUsers({ usernames });
						if (searchResult.data && searchResult.data.items.length > 0) {
							input.allowedUserIds = searchResult.data.items.map(
								(u: { id: string }) => u.id
							);
						} else {
							showError('未找到指定用户');
							loading = false;
							submitBtn.disabled = false;
							submitBtn.textContent = '保存修改';
							return;
						}
					}
				}
			}

			// 调用 updatePost action
			const result = await actions.updatePost(input as any);

			if (result.error) {
				// 未登录时跳转登录页
				const errStatus = (result.error as any).status;
				if (errStatus === 401) {
					window.location.href = '/login';
					return;
				}
				showError(result.error.message || '保存失败');
			} else if (result.data) {
				// 编辑成功，跳转到帖子详情页
				window.location.href = `/${username}/${postId}`;
			} else {
				showError('编辑失败');
			}

			loading = false;
			submitBtn.disabled = false;
			submitBtn.textContent = '保存修改';
		});
	});
</script>
