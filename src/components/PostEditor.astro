---
/**
 * 发帖表单组件（Astro 原生）
 *
 * 功能：
 * - textarea 输入框，带字数统计
 * - 可见度选择（7 级）
 * - 图片上传（点击、拖拽、粘贴，最多 9 张）
 * - 上传进度条（XMLHttpRequest 追踪上传进度）
 * - Emoji 选择器（分类浏览，点击插入光标位置）
 * - 草稿自动保存/恢复（localStorage，1 秒防抖）
 * - 通过 Astro Actions 创建帖子和搜索用户
 */
import { POST_CONTENT_MAX_LENGTH } from '@/lib/config';

interface Props {
	/** 是否在挂载时恢复草稿 */
	restoreDraft?: boolean;
	/** 编辑态所需的帖子 ID；未传入时为创建态 */
	postId?: string;
	/** 编辑成功后的跳转用户名 */
	username?: string;
	/** 编辑态初始内容 */
	initialContent?: string;
	/** 编辑态初始可见度 */
	initialVisibility?: string;
	/** 编辑态需要回显并允许移除的媒体 */
	initialMedia?: ExistingMedia[];
}

interface ExistingMedia {
	id: string;
	fileStorageId: string;
	fileType: string;
	originalName: string;
	url: string;
}

const {
	restoreDraft = false,
	postId,
	username,
	initialContent = '',
	initialVisibility = 'public',
	initialMedia = []
} = Astro.props;
const isEdit = Boolean(postId);
// 兼容修复前保存的内容，并通过 set:text 避免 Astro 模板缩进成为 textarea 值。
const initialEditorContent = initialContent.trimStart();

/** 图片最大数量 */
const MAX_IMAGES = 9;
---

<form
	class="post-editor"
	data-restore-draft={String(restoreDraft || isEdit)}
	data-mode={isEdit ? 'edit' : 'create'}
	data-post-id={postId}
	data-username={username}
	data-existing-media={JSON.stringify(initialMedia)}
>
	{/* 草稿恢复提示 */}
	<div class="post-editor-draft-hint" id="draft-hint" style="display:none">
		📝 已恢复上次未发布的草稿
	</div>

	<div class="form-group">
		<textarea
			class="form-input post-editor-textarea"
			id="post-content"
			placeholder="分享你的想法..."
			maxlength={POST_CONTENT_MAX_LENGTH}
			rows="4"
			set:text={initialEditorContent}
		/>

		{/* 可见度选择器 */}
		<div class="post-editor-visibility">
			<select class="form-input post-editor-visibility-select" id="post-visibility">
				<option value="public" selected={initialVisibility === 'public'}>🌐 公开</option>
				<option value="logged_in" selected={initialVisibility === 'logged_in'}
					>🔐 登录用户可见</option
				>
				<option value="followers" selected={initialVisibility === 'followers'}
					>👥 粉丝可见</option
				>
				<option value="following" selected={initialVisibility === 'following'}
					>🤝 我关注的人可见</option
				>
				<option value="private" selected={initialVisibility === 'private'}
					>🔒 仅自己可见</option
				>
				<option value="password" selected={initialVisibility === 'password'}
					>🔑 密码保护</option
				>
				<option value="users" selected={initialVisibility === 'users'}
					>👤 指定用户可见</option
				>
			</select>
		</div>

		{/* 密码输入框（visibility=password 时显示） */}
		<div
			class="post-editor-password"
			id="password-field"
			style={initialVisibility === 'password' ? '' : 'display:none'}
		>
			<input
				type="password"
				class="form-input"
				id="post-password"
				placeholder="设置访问密码..."
			/>
		</div>

		{/* 用户名输入框（visibility=users 时显示） */}
		<div
			class="post-editor-users"
			id="users-field"
			style={initialVisibility === 'users' ? '' : 'display:none'}
		>
			<input
				type="text"
				class="form-input"
				id="post-allowed-usernames"
				placeholder="输入用户名，逗号分隔（如：alice,bob）"
			/>
		</div>

		{/* 工具栏：图片上传 + Emoji */}
		<div class="post-editor-toolbar">
			<div class="post-editor-toolbar-actions">
				<div
					class="post-editor-upload"
					id="upload-area"
					role="button"
					tabindex="0"
					aria-label="点击或拖拽上传图片"
				>
					<label class="post-editor-upload-btn" id="upload-label">
						<input
							type="file"
							accept="image/jpeg,image/png,image/gif,image/webp"
							multiple
							id="file-input"
							style="display:none"
						/>
						📷 图片
					</label>
					<label class="post-editor-upload-btn" id="video-label">
						<input
							type="file"
							accept="video/mp4"
							id="video-input"
							style="display:none"
						/>
						🎬 视频
					</label>
					<label class="post-editor-upload-btn" id="attachment-label">
						<input
							type="file"
							accept=".pdf,.zip,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rar,.7z"
							multiple
							id="attachment-input"
							style="display:none"
						/>
						📎 附件
					</label>
				</div>
				<button
					type="button"
					class="post-editor-emoji-btn"
					id="emoji-toggle"
					aria-label="选择表情"
					aria-expanded="false"
				>
					😊
				</button>
			</div>
			<span class="post-editor-upload-count" id="upload-count">
				0/{MAX_IMAGES}
			</span>
		</div>

		{/* 上传进度条 */}
		<div class="post-editor-progress" id="upload-progress" style="display:none">
			<div class="post-editor-progress-bar" id="progress-bar" style="width:0%"></div>
		</div>

		{/* Emoji 选择器（原生 dialog） */}
		<dialog class="emoji-picker-dialog" id="emoji-dialog">
			<div class="emoji-picker">
				{/* 分类标签栏 */}
				<div class="emoji-picker-categories" id="emoji-categories"></div>
				{/* Emoji 网格 */}
				<div class="emoji-picker-grid">
					<div class="emoji-picker-group">
						<div class="emoji-picker-group-label" id="emoji-group-label"></div>
						<div class="emoji-picker-items" id="emoji-items"></div>
					</div>
				</div>
			</div>
		</dialog>

		{/* 图片预览 */}
		<div class="post-editor-previews" id="image-previews" style="display:none"></div>

		<div class="post-editor-footer">
			<span class="post-editor-count" id="char-count">
				0/{POST_CONTENT_MAX_LENGTH}
			</span>
			<div class="post-editor-actions">
				{
					isEdit && (
						<a href={`/${username}/${postId}`} class="btn btn-outline">
							取消
						</a>
					)
				}
				<button class="btn btn-primary" type="submit" id="submit-btn" disabled>
					{isEdit ? '保存修改' : '发布'}
				</button>
			</div>
		</div>
	</div>
	<p class="form-error" id="form-error" role="alert" aria-live="assertive" style="display:none">
	</p>
</form>

<script>
	/**
	 * PostEditor 客户端脚本
	 *
	 * 处理表单交互逻辑：
	 * - 表单提交 → 调用 actions.createPost
	 * - 图片上传 → 调用运行期 /api/upload
	 * - 可见度切换 → 显示/隐藏密码和用户输入框
	 * - 字数统计 → 实时更新
	 * - 草稿自动保存 → localStorage 防抖
	 * - Emoji 选择器 → 原生 dialog + 分类浏览
	 */
