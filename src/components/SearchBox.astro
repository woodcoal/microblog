---
/**
 * 搜索输入框组件
 *
 * 原生 HTML 表单，提交后跳转到搜索页面。
 * 无需客户端 JS，完全服务端渲染。
 * 支持 mode 和 categoryId 隐藏字段传递。
 *
 * @prop initialQuery - 初始搜索关键词（从 URL 参数恢复）
 * @prop placeholder - 输入框占位文本
 * @prop tab - 当前标签页（搜索时保持）
 * @prop mode - 当前 mode 过滤（搜索时保持）
 * @prop categoryId - 当前分类过滤（搜索时保持）
 * @prop inputId - 输入框 ID，供实时建议精确绑定
 */
import SearchSuggest from '@/components/SearchSuggest.astro';

interface Props {
	initialQuery?: string;
	placeholder?: string;
	tab?: string;
	mode?: string;
	categoryId?: string;
	inputId?: string;
}

const {
	initialQuery = '',
	placeholder = '搜索...',
	tab = 'posts',
	mode = 'all',
	categoryId = '',
	inputId = 'search-page-input'
} = Astro.props;
---

<form class="search-form" action="/search" method="GET">
	<!-- 保持当前标签页 -->
	<input type="hidden" name="tab" value={tab} />
	<!-- 保持当前 mode 过滤 -->
	<input type="hidden" name="mode" value={mode} />
	<!-- 保持当前分类过滤 -->
	{categoryId && <input type="hidden" name="categoryId" value={categoryId} />}
	<div class="search-input-wrap">
		<span class="search-input-icon" aria-hidden="true">🔍</span>
		<input
			id={inputId}
			type="text"
			class="form-input search-input"
			name="q"
			value={initialQuery}
			placeholder={placeholder}
			aria-label="搜索关键词"
		/>
		<SearchSuggest inputId={inputId} mode={mode} />
		{
			initialQuery && (
				<a
					href={tab === 'users' ? '/search?tab=users' : '/search'}
					class="search-clear-btn"
					aria-label="清除搜索"
				>
					✕
				</a>
			)
		}
	</div>
	<button type="submit" class="btn btn-primary search-btn"> 搜索 </button>
</form>
