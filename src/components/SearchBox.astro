---
/**
 * 搜索输入框组件
 *
 * 原生 HTML 表单，提交后跳转到搜索页面。
 * 无需客户端 JS，完全服务端渲染。
 *
 * @prop initialQuery - 初始搜索关键词（从 URL 参数恢复）
 * @prop placeholder - 输入框占位文本
 * @prop tab - 当前标签页（搜索时保持）
 */
interface Props {
	initialQuery?: string;
	placeholder?: string;
	tab?: string;
}

const { initialQuery = '', placeholder = '搜索...', tab = 'posts' } = Astro.props;
---

<form class="search-form" action="/search" method="GET">
	<!-- 保持当前标签页 -->
	<input type="hidden" name="tab" value={tab} />
	<div class="search-input-wrap">
		<span class="search-input-icon" aria-hidden="true">🔍</span>
		<input
			type="text"
			class="form-input search-input"
			name="q"
			value={initialQuery}
			placeholder={placeholder}
			aria-label="搜索关键词"
		/>
		{
			initialQuery && (
				<a
					href={tab === 'users' ? '/search?tab=users' : '/search'}
					class="search-clear-btn"
					aria-label="清除搜索"
				>
					✕
				</a>
			)
		}
	</div>
	<button type="submit" class="btn btn-primary search-btn"> 搜索 </button>
</form>
