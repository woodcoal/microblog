---
/**
 * 搜索结果展示组件
 *
 * 服务端渲染搜索结果，支持帖子/用户标签页切换和游标分页。
 * 标签页切换和分页均通过 URL 参数实现，无需客户端 JS。
 *
 * @prop tab - 当前标签页（all、posts 或 users）
 * @prop query - 搜索关键词
 * @prop posts - 帖子搜索结果列表
 * @prop nextPostsCursor - 帖子分页游标（null 表示无更多）
 * @prop users - 用户搜索结果列表
 * @prop nextUsersCursor - 用户分页游标（null 表示无更多）
 * @prop currentCursor - 当前分页游标（用于构建"上一页"链接）
 */
import { renderMarkdown } from '@/lib/markdown';
import { formatRelativeTime } from '@/lib/utils';
import { getModeLabel } from '@/lib/config';
import { escapeHtml } from '@/lib/html';

/**
 * 对 HTML 内容中的关键词包裹高亮标记
 *
 * 在渲染后的 HTML 中查找纯文本部分的关键词，
 * 将其包裹在 <mark class="search-highlight"> 中。
 * 避免替换 HTML 标签内的属性值。
 *
 * @param html - 渲染后的 HTML 内容
 * @param keyword - 搜索关键词
 * @returns 高亮处理后的 HTML
 */
function highlightKeyword(html: string, keyword: string): string {
	if (!keyword) return html;
	// 转义正则特殊字符
	const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	// 仅匹配标签外的文本内容（在 > 和 < 之间）
	const regex = new RegExp(`(>[^<]*)(${escaped})([^<]*<)`, 'gi');
	return html.replace(regex, '$1<mark class="search-highlight">$2</mark>$3');
}

/** 帖子搜索结果数据 */
interface PostResult {
	id: string;
	content: string;
	createdAt: string;
	isPinned: boolean;
	isGlobalPinned: boolean;
	likeCount: number;
	mode?: string;
	title?: string;
	categoryId?: string;
	category?: {
		id: string;
		name: string;
		slug: string;
		mode: string;
	};
	user: {
		id: string;
		username: string;
		displayName: string;
		avatarUrl: string;
	};
	tags: { id: string; name: string }[];
}

/** 用户搜索结果数据 */
interface UserResult {
	id: string;
	username: string;
	displayName: string;
	avatarUrl: string;
	bio: string;
	followerCount: number;
	followingCount: number;
	postCount: number;
}

interface Props {
	tab: 'all' | 'posts' | 'users';
	query: string;
	sort: 'latest' | 'popular';
	modeFilter?: string;
	categoryIdFilter?: string;
	posts: PostResult[];
	nextPostsCursor: string | null;
	users: UserResult[];
	nextUsersCursor: string | null;
	currentCursor?: string;
}

const {
	tab,
	query,
	sort,
	modeFilter = 'all',
	categoryIdFilter = '',
	posts,
	nextPostsCursor,
	users,
	nextUsersCursor
} = Astro.props as Props;

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const showPosts = tab !== 'users';
const showUsers = tab !== 'posts';
const isAllTab = tab === 'all';
const hasNoQuery = !query;
const hasPosts = posts.length > 0;
const hasMorePosts = !!nextPostsCursor;
const hasUsers = users.length > 0;
const hasMoreUsers = !!nextUsersCursor;

/** 构建帖子分页链接，保持所有筛选参数 */
const postsPaginationBase = `/search?q=${encodeURIComponent(query)}&tab=${tab}&sort=${sort}&mode=${modeFilter}${categoryIdFilter ? `&categoryId=${categoryIdFilter}` : ''}`;
const usersPaginationBase = `/search?q=${encodeURIComponent(query)}&tab=${tab}`;
---

{
	hasNoQuery ? (
		<div class="empty-state">
			<p>请输入搜索关键词</p>
		</div>
	) : (
		<div class="search-result-groups">
			{showPosts && (
				<section class="search-result-group" aria-labelledby={isAllTab ? 'search-post-results' : undefined}>
					{isAllTab && <h2 id="search-post-results" class="search-result-group-title">内容</h2>}
					{!hasPosts ? <div class="empty-state"><p>没有找到相关帖子</p></div> : (
						<div class="search-result-list">
							{posts.map((post) => {
								const htmlContent = highlightKeyword(renderMarkdown(post.content), query);
								const relativeTime = formatRelativeTime(new Date(post.createdAt));
								const isPinned = post.isPinned || post.isGlobalPinned;
								const postMode = post.mode || 'weibo';
								const modeLabel = postMode === 'forum' ? getModeLabel('forum') : postMode === 'blog' ? getModeLabel('blog') : null;
								const kind = modeLabel || getModeLabel('weibo');
								return <article class="search-result-item"><span class="search-result-kind">{kind}</span><div class="search-result-content"><h2><a href={`/${post.user.username}/${post.id}`}>{post.title || post.content.slice(0, 50)}</a></h2><div class="search-result-excerpt" set:html={htmlContent} /><p class="search-result-meta">{post.user.displayName} · {kind} · {post.likeCount} 赞 · {relativeTime}{isPinned && ' · 已置顶'}</p></div></article>;
							})}
							{hasMorePosts && <a href={`${postsPaginationBase}&cursor=${nextPostsCursor}`} class="btn btn-outline load-more-btn">加载更多</a>}
						</div>
					)}
				</section>
			)}
			{showUsers && (
				<section class="search-result-group" aria-labelledby={isAllTab ? 'search-user-results' : undefined}>
					{isAllTab && <h2 id="search-user-results" class="search-result-group-title">用户</h2>}
					{!hasUsers ? <div class="empty-state"><p>没有找到相关用户</p></div> : (
						<div class="search-result-list">
							{users.map((user) => <article class="search-result-item"><span class="search-result-kind">用户</span><div class="search-result-content"><h2><a href={`/${user.username}`}>{user.displayName}</a></h2>{user.bio && <p class="search-result-excerpt" set:html={highlightKeyword(escapeHtml(user.bio), query)} />}<p class="search-result-meta">@{user.username} · {user.followerCount} 粉丝 · 已发布 {user.postCount} 条内容</p></div></article>)}
							{hasMoreUsers && <a href={`${usersPaginationBase}&cursor=${nextUsersCursor}`} class="btn btn-outline load-more-btn">加载更多</a>}
						</div>
					)}
				</section>
			)}
		</div>
	)
}
