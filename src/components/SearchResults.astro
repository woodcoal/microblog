---
/**
 * 搜索结果展示组件
 *
 * 服务端渲染搜索结果，支持帖子/用户标签页切换和游标分页。
 * 标签页切换和分页均通过 URL 参数实现，无需客户端 JS。
 *
 * @prop tab - 当前标签页（all、posts 或 users）
 * @prop query - 搜索关键词
 * @prop posts - 帖子搜索结果列表
 * @prop nextPostsCursor - 帖子分页游标（null 表示无更多）
 * @prop users - 用户搜索结果列表
 * @prop nextUsersCursor - 用户分页游标（null 表示无更多）
 * @prop currentCursor - 当前分页游标（用于构建"上一页"链接）
 */
import { renderMarkdown } from '@/lib/markdown';
import { formatRelativeTime } from '@/lib/utils';
import { getModeLabel } from '@/lib/config';
import { escapeHtml } from '@/lib/html';
import PostCard from '@/components/PostCard.astro';
import ForumTopicList from '@/components/ForumTopicList.astro';
import BlogArticleList from '@/components/BlogArticleList.astro';

/**
 * 对 HTML 内容中的关键词包裹高亮标记
 *
 * 在渲染后的 HTML 中查找纯文本部分的关键词，
 * 将其包裹在 <mark class="search-highlight"> 中。
 * 避免替换 HTML 标签内的属性值。
 *
 * @param html - 渲染后的 HTML 内容
 * @param keyword - 搜索关键词
 * @returns 高亮处理后的 HTML
 */
function highlightKeyword(html: string, keyword: string): string {
	if (!keyword) return html;
	// 转义正则特殊字符
	const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	// 仅匹配标签外的文本内容（在 > 和 < 之间）
	const regex = new RegExp(`(>[^<]*)(${escaped})([^<]*<)`, 'gi');
	return html.replace(regex, '$1<mark class="search-highlight">$2</mark>$3');
}

/** 综合搜索表格的正文列最多保留 100 个字符，避免长文本挤占其他字段。 */
function getSearchResultPreview(value: string): string {
	const normalized = value.replace(/\s+/g, ' ').trim();
	return normalized.length > 100 ? `${normalized.slice(0, 100)}…` : normalized;
}

/** 帖子搜索结果数据 */
interface PostResult {
	id: string;
	content: string;
	createdAt: string;
	isPinned: boolean;
	isGlobalPinned: boolean;
	likeCount: number;
	commentCount: number;
	mode?: string;
	title?: string;
	customCategory?: string | null;
	categoryId?: string;
	category?: {
		id: string;
		name: string;
		slug: string;
		mode: string;
	};
	user: {
		id: string;
		username: string;
		displayName: string;
		avatarUrl: string;
	};
	tags: { id: string; name: string }[];
}

/** 用户搜索结果数据 */
interface UserResult {
	id: string;
	username: string;
	displayName: string;
	avatarUrl: string;
	bio: string;
	followerCount: number;
	followingCount: number;
	postCount: number;
	createdAt: string;
}

type AllResult =
	| { type: 'post'; createdAt: string; value: PostResult }
	| { type: 'user'; createdAt: string; value: UserResult };

interface Props {
	tab: 'all' | 'posts' | 'users';
	query: string;
	sort: 'latest' | 'popular';
	modeFilter?: string;
	categoryIdFilter?: string;
	posts: PostResult[];
	nextPostsCursor: string | null;
	users: UserResult[];
	nextUsersCursor: string | null;
	allResults: AllResult[];
	nextAllCursor: string | null;
	currentCursor?: string;
}

const {
	tab,
	query,
	sort,
	modeFilter = 'all',
	categoryIdFilter = '',
	posts,
	nextPostsCursor,
	users,
	nextUsersCursor,
	allResults,
	nextAllCursor
} = Astro.props as Props;

const isAllTab = tab === 'all';
const hasNoQuery = !query;
const hasPosts = posts.length > 0;
const hasMorePosts = !!nextPostsCursor;
const isUsersTab = tab === 'users';
const hasUsers = users.length > 0;
const hasMoreUsers = !!nextUsersCursor;
const hasAllResults = allResults.length > 0;
const hasMoreAllResults = !!nextAllCursor;
const isWeiboResults = tab === 'posts' && modeFilter === 'weibo';
const isForumResults = tab === 'posts' && modeFilter === 'forum';
const isBlogResults = tab === 'posts' && modeFilter === 'blog';

/** 构建帖子分页链接，保持所有筛选参数 */
const postsPaginationBase = `/search?q=${encodeURIComponent(query)}&tab=${tab}&sort=${sort}&mode=${modeFilter}${categoryIdFilter ? `&categoryId=${categoryIdFilter}` : ''}`;
const allPaginationBase = `/search?q=${encodeURIComponent(query)}&tab=all&mode=all`;
const usersPaginationBase = `/search?q=${encodeURIComponent(query)}&tab=users`;
---

{
	hasNoQuery ? (
		<div class="empty-state">
			<p>请输入搜索关键词</p>
		</div>
	) : isAllTab ? (
		!hasAllResults ? (
			<div class="empty-state">
				<p>没有找到相关内容或用户</p>
			</div>
		) : (
			<div class="search-all-results-table-wrap">
				<table class="search-all-results-table">
					<colgroup>
						<col class="search-all-results-type-column" />
						<col />
						<col class="search-all-results-author-column" />
						<col class="search-all-results-time-column" />
					</colgroup>
					<thead>
						<tr>
							<th scope="col">类型</th>
							<th scope="col">内容</th>
							<th scope="col">作者</th>
							<th scope="col">时间</th>
						</tr>
					</thead>
					<tbody>
						{allResults.map((result) => {
							if (result.type === 'post') {
								const post = result.value;
								const preview = getSearchResultPreview(post.title || post.content);
								const relativeTime = formatRelativeTime(new Date(post.createdAt));
								const postMode = post.mode || 'weibo';
								const kind = getModeLabel(postMode);
								return (
									<tr>
										<td class="search-all-results-type">{kind}</td>
										<td class="search-all-results-content" title={preview}>
											<a href={`/${post.user.username}/${post.id}`}>
												{preview}
											</a>
										</td>
										<td class="search-all-results-author">
											<a href={`/${post.user.username}`}>
												{post.user.displayName}
											</a>
										</td>
										<td class="search-all-results-time">
											<time datetime={post.createdAt}>{relativeTime}</time>
										</td>
									</tr>
								);
							}

							const user = result.value;
							return (
								<tr>
									<td class="search-all-results-type">用户</td>
									<td class="search-all-results-content" title={user.displayName}>
										<a href={`/${user.username}`}>
											{getSearchResultPreview(user.displayName)}
										</a>
									</td>
									<td
										class="search-all-results-author"
										title={`@${user.username}`}
									>
										<a href={`/${user.username}`}>@{user.username}</a>
									</td>
									<td class="search-all-results-time">
										<time datetime={user.createdAt}>
											{formatRelativeTime(new Date(user.createdAt))}
										</time>
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
				{hasMoreAllResults && (
					<a
						href={`${allPaginationBase}&cursor=${nextAllCursor}`}
						class="btn btn-outline load-more-btn"
					>
						加载更多
					</a>
				)}
			</div>
		)
	) : isUsersTab ? (
		!hasUsers ? (
			<div class="empty-state">
				<p>没有找到相关用户</p>
			</div>
		) : (
			<div class="search-result-list">
				{users.map((user) => (
					<article class="search-result-item">
						<span class="search-result-kind">用户</span>
						<div class="search-result-content">
							<h2>
								<a href={`/${user.username}`}>{user.displayName}</a>
							</h2>
							{user.bio && (
								<p
									class="search-result-excerpt"
									set:html={highlightKeyword(escapeHtml(user.bio), query)}
								/>
							)}
							<p class="search-result-meta">
								@{user.username} · {user.followerCount} 粉丝 · 已发布{' '}
								{user.postCount} 条内容
							</p>
						</div>
					</article>
				))}
				{hasMoreUsers && (
					<a
						href={`${usersPaginationBase}&cursor=${nextUsersCursor}`}
						class="btn btn-outline load-more-btn"
					>
						加载更多
					</a>
				)}
			</div>
		)
	) : !hasPosts ? (
		<div class="empty-state">
			<p>没有找到相关帖子</p>
		</div>
	) : (
		<>
			{isWeiboResults && (
				<div class="post-list">
					{posts.map((post) => (
						<PostCard
							post={post}
							htmlContent={renderMarkdown(post.content)}
							likeCount={post.likeCount}
							commentCount={post.commentCount}
							tags={post.tags}
						/>
					))}
				</div>
			)}
			{isForumResults && (
				<ForumTopicList
					posts={posts.map((post) => ({
						...post,
						title: post.title ?? null,
						category: post.category ?? null,
						createdAt: new Date(post.createdAt),
						_count: { comments: post.commentCount }
					}))}
				/>
			)}
			{isBlogResults && (
				<BlogArticleList
					posts={posts.map((post) => ({
						...post,
						title: post.title ?? null,
						category: post.category ?? null,
						createdAt: new Date(post.createdAt),
						customCategory: post.customCategory ?? null,
						_count: { likes: post.likeCount, comments: post.commentCount }
					}))}
				/>
			)}
			{!isWeiboResults && !isForumResults && !isBlogResults && (
				<div class="search-result-list">
					{posts.map((post) => {
						const htmlContent = highlightKeyword(renderMarkdown(post.content), query);
						return (
							<article class="search-result-item">
								<span class="search-result-kind">
									{getModeLabel(post.mode || 'weibo')}
								</span>
								<div class="search-result-content">
									<h2>
										<a href={`/${post.user.username}/${post.id}`}>
											{post.title || post.content.slice(0, 50)}
										</a>
									</h2>
									<div class="search-result-excerpt" set:html={htmlContent} />
									<p class="search-result-meta">
										{post.user.displayName} ·{' '}
										{formatRelativeTime(new Date(post.createdAt))}
									</p>
								</div>
							</article>
						);
					})}
				</div>
			)}
			{hasMorePosts && (
				<a
					href={`${postsPaginationBase}&cursor=${nextPostsCursor}`}
					class="btn btn-outline load-more-btn"
				>
					加载更多
				</a>
			)}
		</>
	)
}
