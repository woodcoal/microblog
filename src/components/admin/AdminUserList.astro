---
/**
 * 管理后台 - 用户列表组件
 *
 * 服务端渲染用户表格，支持：
 * - 搜索：URL 参数 ?search=xxx
 * - 禁用/启用：通过 fetch 请求对应 API，刷新页面
 * - 分页：URL 参数 ?page=xxx
 *
 * @prop users - 用户列表
 * @prop total - 总数
 * @prop page - 当前页码
 * @prop totalPages - 总页数
 * @prop hasPrev - 是否有上一页
 * @prop hasNext - 是否有下一页
 * @prop search - 当前搜索关键词
 */

/** 用户数据结构 */
interface UserData {
	id: string;
	username: string;
	displayName: string;
	email: string;
	role: string;
	isDisabled: boolean;
	createdAt: string;
	emailVerifiedAt: string | null;
	lastLoginAt: string | null;
	lastActiveAt: string | null;
	loginCount: number;
}

interface Props {
	users: UserData[];
	total: number;
	page: number;
	totalPages: number;
	hasPrev: boolean;
	hasNext: boolean;
	search: string;
	emailOwnershipEnabled: boolean;
}

const { users, total, page, totalPages, hasPrev, hasNext, search, emailOwnershipEnabled } =
	Astro.props;

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasUsers = users.length > 0;
const prevPage = page - 1;
const nextPage = page + 1;
const searchParam = search ? `&search=${encodeURIComponent(search)}` : '';

function formatAdminDate(value: string | null): string {
	if (!value) return '暂无记录';
	return new Date(value).toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
		hour: '2-digit',
		minute: '2-digit'
	});
}
---

<!-- 搜索栏 -->
<div class="admin-user-toolbar">
	<form class="admin-search-bar" action="/admin/users" method="GET">
		<input
			type="text"
			class="admin-search-input"
			name="search"
			value={search}
			placeholder="搜索用户名或邮箱..."
			aria-label="搜索用户名或邮箱"
		/>
		<button type="submit" class="btn btn-primary"> 搜索 </button>
	</form>
	<button type="button" class="btn btn-primary" id="create-user-open">添加用户</button>
	<button type="button" class="btn btn-danger" id="purge-unverified-empty-users">
		清理未验证空账号
	</button>
</div>

<!-- 添加用户对话框 -->
<dialog id="create-user-dialog" class="admin-modal" aria-labelledby="create-user-title">
	<form id="create-user-form" novalidate>
		<h2 class="admin-modal-title" id="create-user-title">添加用户</h2>
		<div class="form-group">
			<label class="form-label" for="create-user-username">用户名</label>
			<input
				id="create-user-username"
				class="form-input"
				name="username"
				type="text"
				required
				minlength="3"
				maxlength="20"
				pattern="[a-zA-Z0-9_]{3,20}"
				autocomplete="username"
				placeholder="3-20 位字母、数字或下划线"
			/>
		</div>
		<div class="form-group">
			<label class="form-label" for="create-user-display-name">显示名（可选）</label>
			<input
				id="create-user-display-name"
				class="form-input"
				name="displayName"
				type="text"
				placeholder="默认使用用户名"
			/>
		</div>
		<div class="form-group">
			<label class="form-label" for="create-user-email">邮箱</label>
			<input
				id="create-user-email"
				class="form-input"
				name="email"
				type="email"
				required
				autocomplete="email"
			/>
		</div>
		<div class="form-group">
			<label class="form-label" for="create-user-password">密码</label>
			<input
				id="create-user-password"
				class="form-input"
				name="password"
				type="password"
				required
				minlength="8"
				autocomplete="new-password"
				placeholder="至少 8 个字符"
			/>
		</div>
		<div class="form-group">
			<label class="form-label" for="create-user-role">角色</label>
			<select id="create-user-role" class="form-input" name="role">
				<option value="user">用户</option>
				<option value="admin">管理员</option>
			</select>
		</div>
		<div class="admin-modal-actions">
			<button type="button" class="btn btn-outline" id="create-user-cancel">取消</button>
			<button type="submit" class="btn btn-primary" id="create-user-submit">创建用户</button>
		</div>
	</form>
</dialog>

<!-- 管理员用户名编辑：独立于用户自助额度。 -->
<dialog id="rename-user-dialog" class="admin-modal" aria-labelledby="rename-user-title">
	<form id="rename-user-form" novalidate>
		<h2 class="admin-modal-title" id="rename-user-title">修改用户名</h2>
		<p class="form-hint">管理员修改不消耗该用户的一次自助改名机会；旧用户名会保留并跳转。</p>
		<input type="hidden" id="rename-user-id" name="userId" />
		<div class="form-group">
			<label class="form-label" for="rename-user-username">新用户名</label>
			<input
				id="rename-user-username"
				class="form-input"
				name="username"
				type="text"
				required
				maxlength="20"
				autocomplete="off"
				aria-describedby="rename-user-message"
			/>
		</div>
		<p id="rename-user-message" class="form-msg" role="alert" aria-live="assertive"></p>
		<div class="admin-modal-actions">
			<button type="button" class="btn btn-outline" id="rename-user-cancel">取消</button>
			<button type="submit" class="btn btn-primary" id="rename-user-submit">保存用户名</button
			>
		</div>
	</form>
</dialog>

<!-- 批量操作栏 -->
<div class="admin-batch-bar" id="batch-bar" style="display: none;">
	<span class="admin-batch-count">已选择 <strong id="batch-count">0</strong> 项</span>
	<div class="admin-batch-actions">
		<button type="button" class="admin-btn-sm admin-btn-sm-danger" data-batch="disable"
			>批量禁用</button
		>
		<button type="button" class="admin-btn-sm admin-btn-sm-primary" data-batch="enable"
			>批量启用</button
		>
	</div>
</div>

<!-- 用户表格 -->
<div class="admin-table-wrapper">
	<table class="admin-table">
		<thead>
			<tr>
				<th><input type="checkbox" id="select-all-users" aria-label="全选" /></th>
				<th>用户名</th>
				<th>显示名</th>
				<th>邮箱</th>
				<th>角色</th>
				<th>状态</th>
				<th>邮箱验证</th>
				<th>注册时间</th>
				<th>最后登录</th>
				<th>最后活跃</th>
				<th>登录次数</th>
				<th>操作</th>
			</tr>
		</thead>
		<tbody>
			{
				users.map((user) => {
					const isAdmin = user.role === 'admin';
					const roleBadgeClass = isAdmin ? 'admin-badge-admin' : 'admin-badge-user';
					const roleLabel = isAdmin ? '管理员' : '用户';
					const statusBadgeClass = user.isDisabled
						? 'admin-badge-disabled'
						: 'admin-badge-active';
					const statusLabel = user.isDisabled ? '已禁用' : '正常';
					const actionLabel = user.isDisabled ? '启用' : '禁用';
					const actionBtnClass = user.isDisabled
						? 'admin-btn-sm-primary'
						: 'admin-btn-sm-danger';
					const isEmailVerified = user.emailVerifiedAt !== null;
					const verificationBadgeClass = isEmailVerified
						? 'admin-badge-active'
						: emailOwnershipEnabled
							? 'admin-badge-unverified'
							: 'admin-badge-user';
					const verificationLabel = isEmailVerified ? '已验证' : '未验证';
					const formattedDate = formatAdminDate(user.createdAt);
					const formattedLastLogin = formatAdminDate(user.lastLoginAt);
					const formattedLastActive = formatAdminDate(user.lastActiveAt);

					return (
						<tr>
							<td>
								<input
									type="checkbox"
									class="batch-checkbox"
									data-id={user.id}
									aria-label={`选择用户 ${user.username}`}
								/>
							</td>
							<td>
								<a
									href={`/${user.username}`}
									target="_blank"
									rel="noopener noreferrer"
								>
									{user.username}
								</a>
							</td>
							<td>{user.displayName}</td>
							<td>{user.email}</td>
							<td>
								<span class={`admin-badge ${roleBadgeClass}`}>{roleLabel}</span>
							</td>
							<td>
								<span class={`admin-badge ${statusBadgeClass}`}>{statusLabel}</span>
							</td>
							<td>
								<span
									class={`admin-badge ${verificationBadgeClass}`}
									aria-label={`邮箱${verificationLabel}${
										!isEmailVerified && emailOwnershipEnabled
											? '，当前需完成验证'
											: ''
									}`}
								>
									{verificationLabel}
								</span>
							</td>
							<td>{formattedDate}</td>
							<td>{formattedLastLogin}</td>
							<td>{formattedLastActive}</td>
							<td>{user.loginCount}</td>
							<td>
								<div class="admin-actions">
									<button
										type="button"
										class={`admin-btn-sm ${actionBtnClass}`}
										data-action={user.isDisabled ? 'enable' : 'disable'}
										data-user-id={user.id}
									>
										{actionLabel}
									</button>
									<button
										type="button"
										class="admin-btn-sm admin-btn-sm-primary"
										data-rename-user-id={user.id}
										data-rename-username={user.username}
									>
										改用户名
									</button>
								</div>
							</td>
						</tr>
					);
				})
			}
			{
				!hasUsers && (
					<tr>
						<td colspan="12" class="admin-empty-cell">
							暂无用户数据
						</td>
					</tr>
				)
			}
		</tbody>
	</table>
</div>

<!-- 分页 -->
<div class="admin-pagination">
	{
		hasPrev ? (
			<a href={`/admin/users?page=${prevPage}${searchParam}`} class="admin-pagination-btn">
				上一页
			</a>
		) : (
			<span class="admin-pagination-btn admin-pagination-btn-disabled">上一页</span>
		)
	}
	<span class="admin-pagination-info">
		第 {page} / {totalPages} 页，共 {total} 条
	</span>
	{
		hasNext ? (
			<a href={`/admin/users?page=${nextPage}${searchParam}`} class="admin-pagination-btn">
				下一页
			</a>
		) : (
			<span class="admin-pagination-btn admin-pagination-btn-disabled">下一页</span>
		)
	}
</div>

<script>
	import { actions } from 'astro:actions';
	import { runReasonedAdminAction } from '@/scripts/admin-reason-dialog';

	function moderateUsers(action: 'disable' | 'enable', ids: string[]): void {
		runReasonedAdminAction({
			title: action === 'disable' ? '禁用用户' : '启用用户',
			description: `将对 ${ids.length} 个用户执行${action === 'disable' ? '禁用' : '启用'}操作。`,
			submit: async ({ reason, requestId }) => {
				const result = await actions.batchUsers({ action, ids, reason, requestId });
				if (result.error) throw new Error(result.error.message || '用户状态更新失败');
				return { affected: result.data?.affected ?? 0 };
			},
			onSuccess: () => window.location.reload()
		});
	}

	function purgeUnverifiedEmptyUsers(): void {
		runReasonedAdminAction({
			title: '物理删除未验证空账号',
			description:
				'将物理删除所有未完成邮箱验证、从未登录或活跃、未发布内容且没有任何业务关系的普通账号。验证过的账号不会受影响，此操作不可恢复。',
			confirmLabel: '确认物理删除',
			allowZeroAffected: true,
			submit: async ({ reason, requestId }) => {
				const result = await actions.purgeUnverifiedEmptyUsers({ reason, requestId });
				if (result.error) throw new Error(result.error.message || '清理未验证空账号失败');
				return { affected: result.data?.affected ?? 0 };
			},
			onSuccess: () => window.location.reload()
		});
	}

	const createUserDialog = document.getElementById('create-user-dialog') as HTMLDialogElement;
	const createUserForm = document.getElementById('create-user-form') as HTMLFormElement;
	const createUserOpen = document.getElementById('create-user-open');
	const createUserCancel = document.getElementById('create-user-cancel');
	const createUserSubmit = document.getElementById('create-user-submit') as HTMLButtonElement;
	const renameUserDialog = document.getElementById('rename-user-dialog') as HTMLDialogElement;
	const renameUserForm = document.getElementById('rename-user-form') as HTMLFormElement;
	const renameUserId = document.getElementById('rename-user-id') as HTMLInputElement;
	const renameUserUsername = document.getElementById('rename-user-username') as HTMLInputElement;
	const renameUserMessage = document.getElementById('rename-user-message') as HTMLElement;
	const renameUserSubmit = document.getElementById('rename-user-submit') as HTMLButtonElement;

	const purgeUnverifiedEmptyUsersButton = document.getElementById('purge-unverified-empty-users');
	purgeUnverifiedEmptyUsersButton?.addEventListener('click', purgeUnverifiedEmptyUsers);
	createUserOpen?.addEventListener('click', () => {
		createUserForm.reset();
		createUserDialog.showModal();
		(document.getElementById('create-user-username') as HTMLInputElement | null)?.focus();
	});

	createUserCancel?.addEventListener('click', () => {
		createUserDialog.close();
	});

	createUserDialog?.addEventListener('click', (event) => {
		if (event.target === createUserDialog) {
			createUserDialog.close();
		}
	});

	createUserForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const formData = new FormData(createUserForm);
		const username = String(formData.get('username') || '').trim();
		const displayName = String(formData.get('displayName') || '').trim();
		const email = String(formData.get('email') || '').trim();
		const password = String(formData.get('password') || '');
		const role = formData.get('role');

		if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
			await MutanDialog.alert('用户名只能包含字母、数字和下划线，长度 3-20 个字符');
			return;
		}
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
			await MutanDialog.alert('邮箱格式无效');
			return;
		}
		if (password.length < 8) {
			await MutanDialog.alert('密码长度不能少于 8 个字符');
			return;
		}
		if (role !== 'user' && role !== 'admin') {
			await MutanDialog.alert('角色无效，请重新选择');
			return;
		}

		createUserSubmit.disabled = true;
		createUserSubmit.setAttribute('aria-busy', 'true');
		try {
			const result = await actions.createUser({
				username,
				displayName: displayName || undefined,
				email,
				password,
				role
			});
			if (result.error) {
				await MutanDialog.alert(result.error.message || '创建用户失败');
				return;
			}

			createUserDialog.close();
			window.location.reload();
		} catch (error) {
			const message = error instanceof Error ? error.message : '创建用户失败，请稍后重试';
			await MutanDialog.alert(message || '创建用户失败，请稍后重试');
		} finally {
			createUserSubmit.disabled = false;
			createUserSubmit.removeAttribute('aria-busy');
		}
	});

	document.querySelectorAll('[data-rename-user-id]').forEach((button) => {
		button.addEventListener('click', () => {
			const target = button as HTMLElement;
			renameUserId.value = target.dataset.renameUserId ?? '';
			renameUserUsername.value = target.dataset.renameUsername ?? '';
			renameUserMessage.textContent = '';
			renameUserDialog.showModal();
			renameUserUsername.focus();
			renameUserUsername.select();
		});
	});

	document.getElementById('rename-user-cancel')?.addEventListener('click', () => {
		renameUserDialog.close();
	});

	renameUserDialog?.addEventListener('click', (event) => {
		if (event.target === renameUserDialog) renameUserDialog.close();
	});

	renameUserForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		renameUserMessage.textContent = '';
		renameUserSubmit.disabled = true;
		renameUserSubmit.setAttribute('aria-busy', 'true');
		try {
			const result = await actions.renameUser({
				userId: renameUserId.value,
				username: renameUserUsername.value
			});
			if (result.error) {
				renameUserMessage.textContent = result.error.message || '用户名修改失败';
				return;
			}
			renameUserDialog.close();
			window.location.reload();
		} catch (error) {
			renameUserMessage.textContent =
				error instanceof Error ? error.message : '用户名修改失败，请稍后重试';
		} finally {
			renameUserSubmit.disabled = false;
			renameUserSubmit.removeAttribute('aria-busy');
		}
	});

	/**
	 * 用户管理操作交互逻辑
	 *
	 * 通过 data-action 属性识别操作类型，
	 * 使用 Astro Actions 调用对应操作。
	 * 操作类型：
	 * - disable → 禁用用户
	 * - enable  → 启用用户
	 */
	document.querySelectorAll('[data-action="disable"], [data-action="enable"]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const action = (btn as HTMLElement).dataset.action;
			const userId = (btn as HTMLElement).dataset.userId || '';
			if ((action !== 'disable' && action !== 'enable') || !userId) return;
			moderateUsers(action, [userId]);
		});
	});

	// 批量操作逻辑
	const batchBar = document.getElementById('batch-bar');
	const batchCount = document.getElementById('batch-count');
	const selectAll = document.getElementById('select-all-users') as HTMLInputElement;
	const checkboxes = document.querySelectorAll('.batch-checkbox') as NodeListOf<HTMLInputElement>;

	/** 更新批量操作栏显示状态 */
	function updateBatchBar() {
		const checked = document.querySelectorAll('.batch-checkbox:checked');
		const count = checked.length;
		if (batchCount) batchCount.textContent = String(count);
		if (batchBar) batchBar.style.display = count > 0 ? 'flex' : 'none';
		if (selectAll) selectAll.checked = count > 0 && count === checkboxes.length;
	}

	// 全选/取消全选
	selectAll?.addEventListener('change', () => {
		checkboxes.forEach((cb) => {
			cb.checked = selectAll.checked;
		});
		updateBatchBar();
	});

	// 单个复选框变化时更新批量栏
	checkboxes.forEach((cb) => {
		cb.addEventListener('change', updateBatchBar);
	});

	// 批量操作按钮点击
	document.querySelectorAll('[data-batch]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const action = (btn as HTMLElement).dataset.batch;
			if (action !== 'disable' && action !== 'enable') return;
			const checkedIds = Array.from(document.querySelectorAll('.batch-checkbox:checked'))
				.map((cb) => (cb as HTMLInputElement).dataset.id)
				.filter((id): id is string => Boolean(id));

			if (checkedIds.length === 0) {
				await MutanDialog.alert('请先选择项目', { title: '提示' });
				return;
			}

			moderateUsers(action, checkedIds);
		});
	});
</script>

<style>
	.admin-user-toolbar {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-2);
	}
	.admin-user-toolbar .admin-search-bar {
		flex: 1;
	}
	.admin-batch-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 1rem;
		margin-bottom: 0.75rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.admin-batch-count {
		font-size: 0.875rem;
		color: var(--color-muted);
	}
	.admin-batch-actions {
		display: flex;
		gap: 0.5rem;
	}
	@media (max-width: 640px) {
		.admin-user-toolbar {
			align-items: stretch;
			flex-direction: column;
		}
	}
</style>
