---
import BookmarkButton from '@/components/BookmarkButton.astro';
import CommentList from '@/components/CommentList.astro';
import FollowButton from '@/components/FollowButton.astro';
import ForumTopMenu from '@/components/ForumTopMenu.astro';
import LikeButton from '@/components/LikeButton.astro';
import WeiboMediaGallery from '@/components/WeiboMediaGallery.astro';
import WeiboPostActions from '@/components/WeiboPostActions.astro';
import WeiboPostHeader from '@/components/WeiboPostHeader.astro';
import WeiboVideo from '@/components/WeiboVideo.astro';
import { getAsideExcerpt } from '@/lib/post-detail';
import { formatRelativeTime } from '@/lib/utils';
import type { PostDetailModel } from '@/lib/post-detail';
import { getModeLabel } from '@/lib/config';

interface Props {
	model: PostDetailModel;
}

const { model } = Astro.props;
const {
	post,
	isAuthor,
	isFollower,
	needPassword,
	isDeleted,
	isLocked,
	canPin,
	images,
	videos,
	thumbnail,
	attachments,
	hasAttachments,
	isWeiboPost,
	postTags,
	hasTags,
	mentionedUsers,
	hasMentions,
	likeCount,
	likeUsers,
	liked,
	bookmarkCount,
	bookmarked,
	commentSortOrder,
	serializedComments,
	commentCount,
	currentUserForComponent,
	isWeibo,
	isForum,
	isBlog,
	postMode,
	previousBlog,
	nextBlog,
	blogCategoryLabel,
	detailHtmlContent,
	visibilityLabel,
	hasTitle
} = model;
const hasImageMedia = images.length > 0;
const hasVideos = videos.length > 0;
---

<div class={`post-detail-primary post-detail-layout post-detail-layout-${postMode}`}>
	{isForum && <ForumTopMenu />}
	<div class="post-detail-topbar">
		<nav class="post-detail-breadcrumb" aria-label="详情导航">
			{
				isForum ? (
					<a href={post.category ? `/forum/${post.category.slug}` : '/forum'}>
						← {getModeLabel('forum')}
						{post.category ? ` / ${post.category.name}` : ''}
					</a>
				) : isBlog ? (
					<a href={post.category ? `/blog/${post.category.slug}` : '/blog'}>
						←
						{blogCategoryLabel !== getModeLabel('blog')
							? ` / ${blogCategoryLabel}`
							: ''}
					</a>
				) : (
					<a href="/weibo">← {getModeLabel('weibo')}</a>
				)
			}
		</nav>
		{
			isAuthor && !isDeleted && (isWeibo ? !isLocked : true) && (
				<div class="post-detail-owner-toolbar" aria-label="作者操作">
					{!isLocked && (
						<a href={`/${post.user.username}/${post.id}/edit`} class="btn btn-outline">
							编辑
						</a>
					)}
					<button
						class="btn btn-danger"
						id="delete-btn"
						data-post-id={post.id}
						data-username={post.user.username}
						type="button"
					>
						删除
					</button>
					{!isWeibo && post.isEdited && (
						<a
							href={`/${post.user.username}/${post.id}/revisions`}
							class="btn btn-outline"
						>
							版本历史
						</a>
					)}
					{canPin && (
						<button
							class="btn btn-outline"
							id="pin-btn"
							data-post-id={post.id}
							data-pinned={post.isPinned ? 'true' : 'false'}
							type="button"
						>
							{post.isPinned ? '取消置顶' : '置顶'}
						</button>
					)}
				</div>
			)
		}
	</div>
	<article class="post-detail" data-post-mode={post.mode}>
		<p class="ux-detail-kicker">
			{
				post.mode === 'forum'
					? `${post.category?.name ?? getModeLabel('forum')} · 讨论主题`
					: post.mode === 'blog'
						? blogCategoryLabel
						: getModeLabel('weibo') + '动态'
			}
		</p>
		{
			isWeibo && !isDeleted && (
				<h1 class="post-detail-weibo-title">
					{post.title || `${post.user.displayName} 的${getModeLabel('weibo')}动态`}
				</h1>
			)
		}
		{
			isForum && !isDeleted ? (
				/* 论坛模式：版块主题、标题、作者与操作在同一主题卡片内。 */
				<div class="post-detail-forum-header">
					{hasTitle && <h1 class="post-detail-forum-title">{post.title}</h1>}
					<div class="post-detail-header">
						<a href={`/${post.user.username}`} class="post-detail-author">
							{post.user.avatarUrl ? (
								<img
									src={post.user.avatarUrl}
									alt={post.user.displayName}
									class="post-detail-avatar"
									loading="lazy"
								/>
							) : (
								<div class="post-detail-avatar post-detail-avatar-placeholder">
									{post.user.displayName.charAt(0).toUpperCase()}
								</div>
							)}
							<div class="post-detail-author-info">
								<span class="post-detail-name">{post.user.displayName}</span>
								<span class="post-detail-username">
									@{post.user.username} · {formatRelativeTime(post.createdAt)}
								</span>
							</div>
						</a>
						<div class="post-detail-forum-actions" aria-label="作者与帖子操作">
							<FollowButton
								username={post.user.username}
								initialFollowing={isFollower}
								isSelf={isAuthor}
							/>
							<BookmarkButton
								postId={post.id}
								initialBookmarked={bookmarked}
								initialBookmarkCount={bookmarkCount}
								textOnly={true}
							/>
						</div>
					</div>
				</div>
			) : isBlog && !isDeleted ? (
				/* 博客模式：文章标题 + 分类 + 发布日期 */
				<div class="post-detail-blog-header">
					{hasTitle && <h1 class="post-detail-blog-title">{post.title}</h1>}
					<div class="post-detail-blog-meta">
						<a href={`/${post.user.username}`} class="post-detail-author">
							{post.user.avatarUrl ? (
								<img
									src={post.user.avatarUrl}
									alt={post.user.displayName}
									class="post-detail-avatar"
									loading="lazy"
								/>
							) : (
								<div class="post-detail-avatar post-detail-avatar-placeholder">
									{post.user.displayName.charAt(0).toUpperCase()}
								</div>
							)}
							<div class="post-detail-author-info">
								<span class="post-detail-name">{post.user.displayName}</span>
								<span class="post-detail-username">
									{post.createdAt.toLocaleDateString('zh-CN', {
										year: 'numeric',
										month: 'long',
										day: 'numeric'
									})}{' '}
									· 喜欢 {likeCount} · 收藏 {bookmarkCount} · {commentCount}{' '}
									条讨论
								</span>
							</div>
						</a>
						{post.isEdited && (
							<span class="post-detail-edited">
								已编辑 ·{' '}
								<time datetime={post.updatedAt.toISOString()}>
									{formatRelativeTime(post.updatedAt)}
								</time>
							</span>
						)}
					</div>
				</div>
			) : (
				/* 微博模式：与列表复用同一作者信息行。 */
				<WeiboPostHeader
					user={post.user}
					createdAt={post.createdAt}
					updatedAt={post.updatedAt}
					isEdited={post.isEdited && !isDeleted}
				/>
			)
		}

		{
			needPassword && (
				<div class="post-detail-password-gate" id="password-gate">
					<p class="post-detail-password-hint">🔑 这条帖子需要密码才能查看</p>
					<div class="post-detail-password-form">
						<input
							type="password"
							id="post-password-input"
							class="form-input"
							placeholder="请输入访问密码"
						/>
						<button type="button" id="verify-password-btn" class="btn btn-primary">
							验证
						</button>
					</div>
					<p
						class="post-detail-password-error"
						id="password-error"
						style="display:none;color:var(--color-danger);font-size:0.8125rem;margin-top:0.5rem;"
					/>
				</div>
			)
		}

		<!-- 微博模式标题 -->
		{
			isWeibo && hasTitle && !isDeleted && !needPassword && (
				<h2 class="post-detail-subtitle">{post.title}</h2>
			)
		}

		{
			isBlog && thumbnail && !isDeleted && !needPassword && (
				<figure class="post-detail-blog-thumbnail">
					<img src={`/media/${thumbnail.id}`} alt="文章缩略图" loading="lazy" />
				</figure>
			)
		}

		<!-- 帖子内容（密码保护时默认隐藏，验证后显示） -->
		<div
			class="post-detail-content"
			set:html={detailHtmlContent}
			id="post-content"
			style={needPassword ? 'display:none' : undefined}
		/>
		{!isDeleted && !needPassword && <p class="post-detail-visibility">{visibilityLabel}</p>}

		<!-- 标签列表 -->
		{
			hasTags && !isDeleted && !needPassword && (
				<div class="post-detail-tags">
					{postTags.map((tag) => (
						<a href={`/tags/${tag.name}`} class="post-detail-tag">
							{tag.name}
						</a>
					))}
				</div>
			)
		}

		<!-- 提及用户列表 -->
		{
			hasMentions && !isDeleted && !needPassword && (
				<div class="post-detail-mentions">
					<span class="post-detail-mentions-label">提及：</span>
					{mentionedUsers.map((user) => (
						<a href={`/${user.username}`} class="post-detail-mention">
							@{user.username}
						</a>
					))}
				</div>
			)
		}

		{
			hasImageMedia &&
				!isDeleted &&
				!needPassword &&
				(isWeiboPost ? (
					<WeiboMediaGallery images={images} lightbox />
				) : isBlog ? (
					<section
						class="post-detail-body-media"
						aria-labelledby="post-detail-body-media-title"
					>
						<h2 id="post-detail-body-media-title">正文媒体</h2>
						<div
							class={`post-detail-images post-detail-images-${images.length >= 5 ? 'grid' : images.length}`}
						>
							{images.map((media) => (
								<div class="post-detail-image-item">
									<img
										src={`/media/${media.id}/display`}
										alt=""
										loading="lazy"
										data-lightbox="true"
										data-lightbox-src={`/media/${media.id}/original`}
									/>
								</div>
							))}
						</div>
					</section>
				) : (
					<div
						class={`post-detail-images post-detail-images-${images.length >= 5 ? 'grid' : images.length}`}
					>
						{images.map((media) => (
							<div class="post-detail-image-item">
								<img
									src={`/media/${media.id}/display`}
									alt=""
									loading="lazy"
									data-lightbox="true"
									data-lightbox-src={`/media/${media.id}/original`}
								/>
							</div>
						))}
					</div>
				))
		}

		{
			hasVideos &&
				!isDeleted &&
				!needPassword &&
				videos.map((media) => <WeiboVideo media={media} />)
		}

		{
			hasAttachments && !isDeleted && !needPassword && (
				<section
					class="post-detail-attachments"
					aria-labelledby="post-detail-attachments-title"
				>
					<h2 id="post-detail-attachments-title">附件</h2>
					{attachments.map((media) => (
						<a
							href={`/media/${media.id}/download`}
							class="post-detail-attachment"
							download
						>
							📎 {media.originalName || '附件'}
							<span class="post-detail-attachment-size">
								({(media.fileStorage.fileSize / 1024).toFixed(1)} KB)
							</span>
						</a>
					))}
				</section>
			)
		}

		<!-- 点赞区域：单行布局，头像 + 数量 + 用户头像列表 -->
		{
			!isDeleted && !needPassword && !isBlog && (
				<div class="post-detail-like" id="post-like-section">
					{isWeibo ? (
						<WeiboPostActions
							postId={post.id}
							username={post.user.username}
							likeCount={likeCount}
							liked={liked}
							bookmarkCount={bookmarkCount}
							bookmarked={bookmarked}
							commentCount={commentCount}
						/>
					) : (
						<>
							<LikeButton
								postId={post.id}
								initialLiked={liked}
								initialLikeCount={likeCount}
								textOnly={true}
							/>
							<BookmarkButton
								postId={post.id}
								initialBookmarked={bookmarked}
								initialBookmarkCount={bookmarkCount}
								textOnly={true}
							/>
							<a href="#post-comments" class="post-detail-comment-link">
								回复 {commentCount}
							</a>
						</>
					)}
					{likeUsers.length > 0 && (
						<div class="like-users" id="like-users-list">
							{likeUsers.slice(0, 10).map((u) =>
								u.deletedAt ? (
									<span
										class="like-user-avatar like-user-avatar-anonymous"
										aria-label="已注销用户"
										title="已注销用户"
									>
										<span class="like-avatar-placeholder" aria-hidden="true">
											已
										</span>
									</span>
								) : (
									<a
										href={`/${u.username}`}
										class="like-user-avatar"
										title={u.displayName}
									>
										{u.avatarUrl ? (
											<img
												src={u.avatarUrl}
												alt={u.displayName}
												loading="lazy"
											/>
										) : (
											<span class="like-avatar-placeholder">
												{u.displayName.charAt(0).toUpperCase()}
											</span>
										)}
									</a>
								)
							)}
							{likeUsers.length > 10 && (
								<span
									class="like-users-more"
									title={`还有 ${likeUsers.length - 10} 人点赞`}
								>
									+{likeUsers.length - 10}
								</span>
							)}
						</div>
					)}
				</div>
			)
		}
		{
			isBlog && !isDeleted && !needPassword && (previousBlog || nextBlog) && (
				<nav class="post-detail-article-nav" aria-label="同作者文章导航">
					{previousBlog ? (
						<a href={`/${post.user.username}/${previousBlog.id}`}>
							<span>上一篇</span>
							<strong>
								{previousBlog.title || getAsideExcerpt(previousBlog.content, 48)}
							</strong>
						</a>
					) : (
						<span class="post-detail-article-nav-empty">上一篇：没有更早的文章</span>
					)}
					{nextBlog ? (
						<a href={`/${post.user.username}/${nextBlog.id}`}>
							<span>下一篇</span>
							<strong>
								{nextBlog.title || getAsideExcerpt(nextBlog.content, 48)}
							</strong>
						</a>
					) : (
						<span class="post-detail-article-nav-empty">下一篇：没有更新的文章</span>
					)}
				</nav>
			)
		}
	</article>

	<!-- 评论区域 -->
	{
		isLocked && !isDeleted && !needPassword && (
			<section class="post-detail-comments" id="post-comments">
				<p class="post-detail-locked-hint">🔒 帖子已锁定，评论不可见</p>
			</section>
		)
	}
	{
		!isDeleted && !needPassword && !isLocked && (
			<section class="post-detail-comments" id="post-comments">
				<CommentList
					postId={post.id}
					currentUser={currentUserForComponent}
					initialComments={serializedComments}
					initialSort={commentSortOrder}
					commentCount={commentCount}
					presentation={isForum ? 'forum' : isBlog ? 'blog' : 'weibo'}
				/>
			</section>
		)
	}
</div>
<style is:global>
	.post-detail {
		padding: 1rem 0;
	}
	.post-detail-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}
	.post-detail-author {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--color-text);
	}
	.post-detail-author:hover .post-detail-name {
		color: var(--color-primary);
	}
	.post-detail-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.post-detail-avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-size: 1rem;
		font-weight: 600;
	}
	.post-detail-author-info {
		display: flex;
		flex-direction: column;
	}
	.post-detail-name {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
	}
	.post-detail-username {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
	.post-detail-time-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}
	.post-detail-time {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
	.post-detail-edited {
		font-size: 0.75rem;
		color: var(--color-muted);
	}
	.post-detail-owner-toolbar {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-left: auto;
	}
	.post-detail-owner-toolbar .btn {
		min-height: 2.25rem;
		padding: 0.375rem 0.625rem;
	}
	.post-detail-content {
		font-size: 1rem;
		line-height: 1.7;
		word-break: break-word;
		padding: 0.5rem 0;
	}
	.post-detail-content p {
		margin-bottom: 0.75rem;
	}
	.post-detail-content p:last-child {
		margin-bottom: 0;
	}
	.post-detail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 0.5rem;
	}
	.post-detail-tag {
		display: inline-block;
		padding: 0.125rem 0.5rem;
		font-size: 0.75rem;
		color: var(--color-primary);
		background: var(--color-surface);
		border-radius: 1rem;
		text-decoration: none;
		transition: background 0.2s;
	}
	.post-detail-tag:hover {
		background: color-mix(in srgb, var(--color-text) 8%, var(--color-surface));
	}
	.post-detail-mentions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
		margin-top: 0.5rem;
	}
	.post-detail-mentions-label {
		font-size: 0.75rem;
		color: var(--color-muted);
	}
	.post-detail-mention {
		font-size: 0.75rem;
		color: var(--color-primary);
		text-decoration: none;
	}
	.post-detail-mention:hover {
		text-decoration: underline;
	}
	.post-detail-images {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.post-detail-images-1 {
		grid-template-columns: 1fr;
	}
	.post-detail-images-1 img {
		width: 100%;
		border-radius: 0.375rem;
	}

	.post-detail-images-2 {
		grid-template-columns: 1fr 1fr;
	}

	.post-detail-images-3 {
		grid-template-columns: 2fr 1fr;
		grid-template-rows: 1fr 1fr;
	}
	.post-detail-images-3 .post-detail-image-item:first-child {
		grid-row: 1 / 3;
	}

	.post-detail-images-4 {
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
	}

	.post-detail-images-grid {
		grid-template-columns: 1fr 1fr 1fr;
	}

	.post-detail-image-item {
		background: var(--color-surface);
		border-radius: 0.375rem;
		overflow: hidden;
	}
	.post-detail-image-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		cursor: pointer;
		transition: transform 0.2s;
		display: block;
	}
	.post-detail-image-item img:hover {
		transform: scale(1.02);
	}
	.post-detail-attachments {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.post-detail-attachment {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.5rem 0.75rem;
		background: var(--color-surface);
		border-radius: 0.375rem;
		text-decoration: none;
		color: var(--color-text);
		font-size: 0.875rem;
		transition: background 0.2s;
	}
	.post-detail-attachment:hover {
		background: color-mix(in srgb, var(--color-text) 8%, var(--color-surface));
	}
	.post-detail-attachment-size {
		color: var(--color-muted);
		font-size: 0.75rem;
	}
	.post-detail-like {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
	}
	.post-detail-article-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}
	.post-detail-article-nav a,
	.post-detail-article-nav-empty {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
		color: var(--color-text);
		font-size: 0.875rem;
	}
	.post-detail-article-nav a {
		text-decoration: none;
	}
	.post-detail-article-nav a:hover strong {
		color: var(--color-primary);
	}
