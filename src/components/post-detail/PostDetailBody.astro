</style>

<script>
	import { actions } from 'astro:actions';

	/**
	 * 删除按钮交互逻辑
	 *
	 * 点击删除按钮后弹出确认对话框，
	 * 确认后发送 DELETE 请求，成功后跳转到用户主页。
	 */
	const deleteBtn = document.getElementById('delete-btn');
	if (deleteBtn) {
		deleteBtn.addEventListener('click', async () => {
			const postId = (deleteBtn as HTMLElement).dataset.postId;
			const username = (deleteBtn as HTMLElement).dataset.username;

			// 确认删除
			if (
				!(await MutanDialog.confirm('确定要删除这条帖子吗？删除后不可恢复。', {
					title: '删除帖子',
					danger: true
				}))
			) {
				return;
			}

			try {
				if (!postId) return;
				const result = await actions.deletePost({ postId });
				if (result.error) {
					const errMsg = result.error.message || '删除失败';
					await MutanDialog.alert(errMsg);
					return;
				}
				// 删除成功，跳转到用户主页
				window.location.href = `/${username}`;
			} catch (e) {
				await MutanDialog.alert(e instanceof Error ? e.message : '删除失败');
			}
		});
	}

	/**
	 * 密码保护帖子验证逻辑
	 *
	 * 检查 sessionStorage 中是否有有效的密码验证记录，
	 * 如果有则直接显示帖子内容。
	 * 点击验证按钮后，发送密码验证请求，
	 * 成功后将验证记录存入 sessionStorage 并显示帖子内容。
	 */
	const passwordGate = document.getElementById('password-gate');
	const postContent = document.getElementById('post-content');
	const verifyBtn = document.getElementById('verify-password-btn');
	const passwordInput = document.getElementById('post-password-input') as HTMLInputElement | null;
	const passwordError = document.getElementById('password-error');

	if (passwordGate && postContent) {
		// 从路径中提取帖子 ID
		const pathParts = window.location.pathname.split('/');
		const postId = pathParts[pathParts.length - 1];

		// 检查 sessionStorage 中是否有有效的密码验证记录
		const storageKey = `post_pwd_${postId}`;
		const storedExpiry = sessionStorage.getItem(storageKey);
		if (storedExpiry) {
			const expiryTime = parseInt(storedExpiry, 10);
			if (Date.now() < expiryTime) {
				// 密码验证未过期，直接显示帖子内容
				passwordGate.style.display = 'none';
				postContent.style.display = '';
			} else {
				// 已过期，清除记录
				sessionStorage.removeItem(storageKey);
			}
		}

		// 验证按钮点击事件
		if (verifyBtn && passwordInput && passwordError) {
			verifyBtn.addEventListener('click', async () => {
				const password = passwordInput.value.trim();
				if (!password) {
					passwordError.textContent = '请输入密码';
					passwordError.style.display = '';
					return;
				}

				try {
					const result = await actions.verifyPostPassword({ postId, password });

					if (result.error) {
						passwordError.textContent = result.error.message || '验证失败';
						passwordError.style.display = '';
						return;
					}

					if (result.data.valid) {
						// 密码正确，记录过期时间到 sessionStorage
						// 过期时间 = 当前时间 + PASSWORD_PROTECT_EXPIRE_MINUTES 分钟
						const expireMinutes = 10; // 默认 10 分钟
						const expiryTime = Date.now() + expireMinutes * 60 * 1000;
						sessionStorage.setItem(storageKey, expiryTime.toString());

						// 隐藏密码输入区域，显示帖子内容
						passwordGate.style.display = 'none';
						postContent.style.display = '';
					} else {
						passwordError.textContent = '密码错误，请重试';
						passwordError.style.display = '';
					}
				} catch {
					passwordError.textContent = '网络错误，请稍后重试';
					passwordError.style.display = '';
				}
			});

			// 回车键触发验证
			passwordInput.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					verifyBtn.click();
				}
			});
		}
	}

	/**
	 * 监听点赞状态变更，刷新点赞用户列表
	 *
	 * 用 createElement 逐个构建 DOM 节点替代 innerHTML 重建，
	 * 避免闪动和样式丢失。
	 */
	window.addEventListener('post-like-changed', async (e) => {
		const { postId } = (e as CustomEvent).detail;
		if (!postId) return;

		try {
			const result = await actions.getPostLikers({ postId });
			if (result.error) return;
			const users = result.data.users as Array<{
				username: string;
				displayName: string;
				avatarUrl: string;
			}>;

			const list = document.getElementById('like-users-list');
			const section = document.getElementById('post-like-section');

			if (users.length === 0) {
				if (list) list.remove();
				return;
			}

			// 用 createElement 构建新节点，避免 innerHTML 解析闪动
			const maxShow = 10;
			const shown = users.slice(0, maxShow);
			const fragment = document.createDocumentFragment();

			for (const u of shown) {
				const a = document.createElement('a');
				a.href = `/${u.username}`;
				a.className = 'like-user-avatar';
				a.title = u.displayName;

				if (u.avatarUrl) {
					const img = document.createElement('img');
					img.src = u.avatarUrl;
					img.alt = u.displayName;
					a.appendChild(img);
				} else {
					const span = document.createElement('span');
					span.className = 'like-avatar-placeholder';
					span.textContent = u.displayName.charAt(0).toUpperCase();
					a.appendChild(span);
				}

				fragment.appendChild(a);
			}

			if (users.length > maxShow) {
				const more = document.createElement('span');
				more.className = 'like-users-more';
				more.title = `还有 ${users.length - maxShow} 人点赞`;
				more.textContent = `+${users.length - maxShow}`;
				fragment.appendChild(more);
			}

			if (list) {
				list.replaceChildren(fragment);
			} else if (section) {
				const div = document.createElement('div');
				div.className = 'like-users';
				div.id = 'like-users-list';
				div.appendChild(fragment);
				section.appendChild(div);
			}
		} catch {
			// 静默失败，不影响点赞按钮本身
		}
	});

	/**
	 * 置顶按钮交互逻辑
	 *
	 * 点击置顶/取消置顶按钮后，发送 PUT 请求切换状态，
	 * 成功后更新按钮文字和 data-pinned 属性。
	 */
	const pinBtn = document.getElementById('pin-btn');
	if (pinBtn) {
		pinBtn.addEventListener('click', async () => {
			const postId = (pinBtn as HTMLElement).dataset.postId;

			try {
				if (!postId) return;
				const result = await actions.togglePin({ postId });
				if (result.error) {
					await MutanDialog.alert(result.error.message || '操作失败');
					return;
				}
				// 更新按钮文字和状态
				const isNowPinned = result.data.pinned;
				(pinBtn as HTMLElement).dataset.pinned = isNowPinned ? 'true' : 'false';
				pinBtn.textContent = isNowPinned ? '取消置顶' : '置顶';
			} catch (e) {
				const status =
					typeof e === 'object' && e !== null && 'status' in e ? e.status : undefined;
				if (status === 401) {
					await MutanDialog.alert('请先登录', { title: '提示' });
				} else {
					await MutanDialog.alert(e instanceof Error ? e.message : '操作失败');
				}
			}
		});
	}

	/**
	 * 浏览行为追踪（本地阅读历史）
	 *
	 * 用户查看帖子详情页时，异步记录阅读历史，供推荐排除已读内容。
	 * 仅登录用户触发，失败静默不影响页面。
	 */
	(async () => {
		// 从路径中提取帖子 ID
		const pathParts = window.location.pathname.split('/');
		const postId = pathParts[pathParts.length - 1];
		if (!postId) return;

		try {
			await actions.recordRead({ postId });
		} catch {
			// 静默失败
		}
	})();

	/**
	 * 相关推荐加载逻辑
	 *
	 * 页面加载后通过 Astro Actions 获取与当前帖子相似的其他帖子，
	 * 渲染为简洁的卡片列表。失败时静默隐藏推荐区域。
	 * 仅在相关推荐区域存在时执行（登录用户且帖子可见）。
	 */
	(async () => {
		const section = document.getElementById('similar-section');
		const list = document.getElementById('similar-list');
		if (!section || !list) return;

		// 从路径中提取帖子 ID
		const pathParts = window.location.pathname.split('/');
		const postId = pathParts[pathParts.length - 1];
		if (!postId) return;

		const result = await actions.getSimilarPosts({ postId, n: 5 });
		if (result.error || !result.data?.items?.length) {
			// 无推荐结果或出错，不显示区域
			return;
		}

		const items = result.data.items;
		const fragment = document.createDocumentFragment();

		for (const item of items) {
			const a = document.createElement('a');
			a.href = `/${item.user.username}/${item.id}`;
			a.className = 'post-detail-similar-item';

			// 头像
			if (item.user.avatarUrl) {
				const img = document.createElement('img');
				img.src = item.user.avatarUrl;
				img.alt = item.user.displayName;
				img.className = 'post-detail-similar-item-avatar';
				img.loading = 'lazy';
				a.appendChild(img);
			} else {
				const span = document.createElement('span');
				span.className = 'post-detail-similar-item-avatar-placeholder';
				span.textContent = item.user.displayName.charAt(0).toUpperCase();
				a.appendChild(span);
			}

			// 内容区
			const contentDiv = document.createElement('div');
			contentDiv.className = 'post-detail-similar-item-content';

			const titleDiv = document.createElement('div');
			titleDiv.className = 'post-detail-similar-item-title';
			// 有标题用标题，否则用内容前 60 字符
			titleDiv.textContent =
				item.title || item.content.replace(/[#*`>\-[\]()!]/g, '').slice(0, 60);

			const metaDiv = document.createElement('div');
			metaDiv.className = 'post-detail-similar-item-meta';
			const likeText = item.likeCount > 0 ? ` · ${item.likeCount} 赞` : '';
			const commentText = item.commentCount > 0 ? ` · ${item.commentCount} 评论` : '';
			metaDiv.textContent = `@${item.user.username}${likeText}${commentText}`;

			contentDiv.appendChild(titleDiv);
			contentDiv.appendChild(metaDiv);
			a.appendChild(contentDiv);
			fragment.appendChild(a);
		}

		list.appendChild(fragment);
		section.style.display = '';
	})();
</script>
