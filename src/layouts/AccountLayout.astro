---
/**
 * 账户相关页面的统一壳。
 * 设置、收藏、关注、粉丝始终共享同一套资料摘要、个人入口和设置入口。
 */
import UserLayout from './UserLayout.astro';
import { prisma } from '@/lib/db';

interface Props {
	title: string;
	user: {
		username: string;
		displayName?: string;
		avatarUrl?: string | null;
	};
	activePersonal?: 'profile' | 'bookmarks' | 'following' | 'followers';
	activeSettings?: string;
}

const { title, user, activePersonal, activeSettings } = Astro.props;
const accountUser = await prisma.user.findUnique({
	where: { username: user.username },
	select: { displayName: true, avatarUrl: true }
});
const displayName = accountUser?.displayName || user.displayName || user.username;
const avatarUrl = accountUser?.avatarUrl || user.avatarUrl;
const initial = displayName.charAt(0).toUpperCase();
const settingItems = [
	{ id: 'profile', label: '个人资料', icon: '✎' },
	{ id: 'security', label: '账号安全', icon: '🔒' },
	{ id: 'appearance', label: '外观', icon: '◐' },
	{ id: 'notification', label: '通知', icon: '🔔' },
	{ id: 'tokens', label: 'API Token', icon: '⌘' },
	{ id: 'note', label: '用户记录', icon: '▣' }
];
const settingHref = (id: string) => (id === 'profile' ? '/settings' : `/settings?tab=${id}`);
---

<UserLayout title={title} wide>
	<div class="account-layout">
		<aside class="account-sidebar" aria-label="账户导航">
			<a href={`/${user.username}`} class="account-user-summary">
				{
					avatarUrl ? (
						<img src={avatarUrl} alt="" class="account-user-avatar" />
					) : (
						<span
							class="account-user-avatar account-user-avatar-placeholder"
							aria-hidden="true"
						>
							{initial}
						</span>
					)
				}
				<span><strong>{displayName}</strong><small>@{user.username}</small></span>
			</a>

			<nav class="account-nav" aria-label="个人页面">
				<h2>个人</h2>
				<a
					href={`/${user.username}`}
					aria-current={activePersonal === 'profile' ? 'page' : undefined}
				>
					<span class="account-nav-icon" aria-hidden="true">👤</span>
					<span>我的主页</span>
				</a>
				<a
					href="/bookmarks"
					aria-current={activePersonal === 'bookmarks' ? 'page' : undefined}
				>
					<span class="account-nav-icon" aria-hidden="true">🔖</span>
					<span>收藏</span>
				</a>
				<a
					href="/following"
					aria-current={activePersonal === 'following' ? 'page' : undefined}
				>
					<span class="account-nav-icon" aria-hidden="true">👀</span>
					<span>关注</span>
				</a>
				<a
					href="/followers"
					aria-current={activePersonal === 'followers' ? 'page' : undefined}
				>
					<span class="account-nav-icon" aria-hidden="true">👥</span>
					<span>粉丝</span>
				</a>
			</nav>

			<nav class="account-nav" aria-label="设置菜单">
				<h2>设置</h2>
				{
					settingItems.map((item) => (
						<a
							href={settingHref(item.id)}
							aria-current={activeSettings === item.id ? 'page' : undefined}
						>
							<span class="account-nav-icon" aria-hidden="true">
								{item.icon}
							</span>
							<span>{item.label}</span>
						</a>
					))
				}
			</nav>
		</aside>
		<section class="account-content">
			<slot />
		</section>
	</div>
</UserLayout>

<style>
	.account-layout {
		display: grid;
		grid-template-columns: minmax(210px, 232px) minmax(0, 1fr);
		gap: clamp(36px, 5vw, 72px);
		width: auto;
		max-width: var(--layout-wide);
		margin: 0 calc(-1 * var(--spacing-4));
		padding: 32px 24px 80px;
	}

	.account-sidebar {
		min-width: 0;
		padding-right: var(--spacing-5);
		border-right: 1px solid var(--color-border);
	}

	.account-user-summary {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		margin: 0 0 var(--spacing-5);
		padding: var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-card-bg);
		color: var(--color-text);
		text-decoration: none;
	}

	.account-user-summary > span:last-child {
		display: grid;
		min-width: 0;
		gap: 0.125rem;
	}

	.account-user-summary strong,
	.account-user-summary small {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.account-user-summary strong {
		font-size: 0.875rem;
	}

	.account-user-summary small {
		color: var(--color-muted);
		font-size: 0.75rem;
	}

	.account-user-avatar {
		width: 36px;
		height: 36px;
		flex: 0 0 36px;
		border-radius: 50%;
		object-fit: cover;
	}

	.account-user-avatar-placeholder {
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--color-primary) 14%, var(--color-card-bg));
		color: var(--color-primary);
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.account-nav + .account-nav {
		margin-top: var(--spacing-5);
		padding-top: var(--spacing-5);
		border-top: 1px solid var(--color-border);
	}

	.account-nav h2 {
		margin: 0 0 var(--spacing-2);
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.account-nav a {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		min-height: 40px;
		padding: 9px 10px;
		border-left: 2px solid transparent;
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-size: 0.875rem;
		text-decoration: none;
	}

	.account-nav a:hover {
		background: color-mix(in srgb, var(--color-text) 5%, transparent);
		color: var(--color-text);
	}

	.account-nav a[aria-current='page'] {
		border-left-color: var(--color-primary);
		background: color-mix(in srgb, var(--color-primary) 10%, transparent);
		color: var(--color-primary);
		font-weight: 700;
	}

	.account-nav-icon {
		display: inline-grid;
		width: 1.25rem;
		place-items: center;
		font-size: 0.875rem;
		line-height: 1;
		filter: saturate(0.72);
	}

	.account-content {
		min-width: 0;
	}

	@media (max-width: 767px) {
		.account-layout {
			display: block;
			margin: 0 calc(-1 * var(--spacing-3));
			padding: 20px 14px calc(80px + env(safe-area-inset-bottom, 0));
		}

		.account-sidebar {
			display: flex;
			align-items: flex-end;
			gap: var(--spacing-3);
			overflow-x: auto;
			padding-bottom: 2px;
			padding-right: 0;
			border-right: 0;
			margin-bottom: var(--spacing-5);
		}

		.account-user-summary {
			flex: 0 0 auto;
			margin: 0;
			padding: 0;
			border: 0;
			background: transparent;
		}

		.account-user-summary > span:last-child {
			display: none;
		}

		.account-nav {
			display: flex;
			gap: 2px;
			flex: 0 0 auto;
		}

		.account-nav + .account-nav {
			margin-top: 0;
			padding-top: 0;
			border-top: 0;
		}

		.account-nav h2 {
			display: none;
		}

		.account-nav a {
			min-height: 38px;
			padding: 8px;
			border-left: 0;
			border-bottom: 2px solid transparent;
			border-radius: 0;
			background: transparent;
			white-space: nowrap;
		}

		.account-nav a[aria-current='page'] {
			border-bottom-color: var(--color-primary);
			background: transparent;
		}
	}
</style>
