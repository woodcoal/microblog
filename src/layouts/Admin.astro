---
/**
 * 管理后台布局组件
 *
 * 提供管理后台的公共 HTML 骨架，包括：
 * - 侧边栏导航（仪表盘、用户管理、帖子管理、评论管理、标签管理）
 * - 当前页面高亮
 * - 顶部管理员信息
 * - 访问控制：未登录重定向 /login，非 admin 返回 403
 * - 响应式设计：桌面端侧边栏固定，移动端可折叠
 */
import { getUserFromRequest } from '@/lib/auth';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_FAVICON_URL } from '@/lib/config';
import { getOrCreateCsrfToken } from '@/lib/csrf';

// 导入样式依赖（主题变量 + 全局样式 + 管理后台样式）
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/components.css';
import '@/styles/admin.css';
import '@/styles/ux-pages.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

// 从 cookie 获取当前登录用户（SSR）
const currentUser = await getUserFromRequest(Astro);

// 访问控制：未登录重定向到登录页
const isLoggedIn = !!currentUser;
const isAdmin = currentUser?.role === 'admin';

if (!isLoggedIn) {
	return Astro.redirect('/login');
}

// 非 admin 角色返回 403
if (!isAdmin) {
	return new Response('Forbidden: 无权访问管理后台', { status: 403 });
}

// 页面标题
const siteTitle = SITE_TITLE;
const siteDesc = description || SITE_DESCRIPTION;
const pageTitle = title ? `${title} - 管理后台 - ${siteTitle}` : `管理后台 - ${siteTitle}`;

// 当前路径，用于侧边栏高亮
const currentPath = Astro.url.pathname;
const csrfToken = Astro.locals.csrfToken ?? getOrCreateCsrfToken(Astro);

// 侧边栏导航项
const navItems = [
	{ name: '仪表盘', path: '/admin', icon: '📊' },
	{ name: '用户管理', path: '/admin/users', icon: '👥' },
	{ name: '帖子管理', path: '/admin/posts', icon: '📝' },
	{ name: '评论管理', path: '/admin/comments', icon: '💬' },
	{ name: '标签管理', path: '/admin/tags', icon: '🏷️' },
	{ name: '分类管理', path: '/admin/categories', icon: '📂' },
	{ name: '站点文案', path: '/admin/site-copy', icon: '✍️' }
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="csrf-token" content={csrfToken} />
		<!-- 为同源 Action/fetch 自动加入 CSRF header，并为原生表单补充隐藏字段。 -->
		<script is:inline>
			(function () {
				const tokenMeta = document.querySelector('meta[name="csrf-token"]');
				const token = tokenMeta && tokenMeta.getAttribute('content');
				if (!token) return;

				const unsafeMethods = { POST: true, PUT: true, PATCH: true, DELETE: true };
				const originalFetch = window.fetch.bind(window);
				window.fetch = function (input, init) {
					const request = input instanceof Request ? input : null;
					const targetUrl = new URL(
						request ? request.url : String(input),
						window.location.href
					);
					const method = String(
						(init && init.method) || (request && request.method) || 'GET'
					).toUpperCase();
					if (targetUrl.origin !== window.location.origin || !unsafeMethods[method]) {
						return originalFetch(input, init);
					}

					const headers = new Headers(request ? request.headers : undefined);
					if (init && init.headers) {
						new Headers(init.headers).forEach(function (value, key) {
							headers.set(key, value);
						});
					}
					if (!headers.has('X-CSRF-Token')) headers.set('X-CSRF-Token', token);
					return originalFetch(
						input,
						Object.assign({}, init || {}, { headers: headers })
					);
				};

				document.addEventListener('submit', function (event) {
					const form = event.target;
					if (!(form instanceof HTMLFormElement)) return;
					const method = (form.method || 'GET').toUpperCase();
					if (!unsafeMethods[method]) return;
					const action = new URL(
						form.getAttribute('action') || window.location.href,
						window.location.href
					);
					if (action.origin !== window.location.origin) return;
					if (!form.querySelector('input[name="csrf_token"]')) {
						const input = document.createElement('input');
						input.type = 'hidden';
						input.name = 'csrf_token';
						input.value = token;
						form.appendChild(input);
					}
				});
			})();
		</script>
		<meta name="description" content={siteDesc} />
		<title>{pageTitle}</title>
		<link rel="icon" type="image/svg+xml" href={SITE_FAVICON_URL} />
	</head>
	<body class="admin-body" data-ux-shell="admin" data-ux-template="admin-b">
		<a class="skip-link" href="#main-content">跳到主要内容</a>
		<!-- 移动端顶部栏 -->
		<header class="admin-mobile-header">
			<button
				class="admin-sidebar-toggle"
				id="sidebar-toggle"
				aria-label="切换侧边栏"
				aria-controls="admin-sidebar"
				aria-expanded="false"
			>
				☰
			</button>
			<span class="admin-mobile-title">管理后台</span>
			<span class="admin-mobile-user">{currentUser.username}</span>
		</header>

		<!-- 侧边栏遮罩（移动端） -->
		<div class="admin-sidebar-overlay" id="sidebar-overlay"></div>

		<!-- 侧边栏 -->
		<aside class="admin-sidebar" id="admin-sidebar">
			<div class="admin-sidebar-header">
				<a href="/admin" class="admin-sidebar-brand">🛡️ 管理后台</a>
			</div>
			<nav class="admin-sidebar-nav" aria-label="管理后台导航">
				{
					navItems.map((item) => {
						// 判断当前导航项是否激活
						const isActive =
							item.path === '/admin'
								? currentPath === '/admin' || currentPath === '/admin/'
								: currentPath.startsWith(item.path);
						return (
							<a
								href={item.path}
								class:list={[
									'admin-sidebar-link',
									{ 'admin-sidebar-link-active': isActive }
								]}
							>
								<span class="admin-sidebar-icon">{item.icon}</span>
								<span>{item.name}</span>
							</a>
						);
					})
				}
			</nav>
			<div class="admin-sidebar-footer">
				<div class="admin-sidebar-user">
					<span class="admin-sidebar-username">👤 {currentUser.username}</span>
				</div>
				<a href="/" class="admin-sidebar-back">← 返回前台</a>
			</div>
		</aside>

		<!-- 主内容区 -->
		<main id="main-content" class="admin-main" tabindex="-1">
			<slot />
		</main>

		<!-- 管理后台 Actions 使用的统一提示对话框 -->
		<script is:inline>
			function getDialogMessage(message, fallback) {
				if (typeof message !== 'string' || !message.trim()) return fallback;

				try {
					const objectStart = message.indexOf('{');
					const arrayStart = message.indexOf('[');
					const jsonStart =
						objectStart === -1
							? arrayStart
							: arrayStart === -1
								? objectStart
								: Math.min(objectStart, arrayStart);
					const parsed = JSON.parse(
						jsonStart === -1 ? message : message.slice(jsonStart)
					);
					const findMessage = function (value) {
						if (typeof value === 'string' && value.trim()) return value;
						if (Array.isArray(value)) {
							for (const item of value) {
								const found = findMessage(item);
								if (found) return found;
							}
							return '';
						}
						if (value && typeof value === 'object') {
							for (const key of ['message', 'error', 'issues', 'errors', 'detail']) {
								if (key in value) {
									const found = findMessage(value[key]);
									if (found) return found;
								}
							}
						}
						return '';
					};
					return findMessage(parsed) || fallback;
				} catch {
					return message;
				}
			}

			function createDialog(options) {
				const dialog = document.createElement('dialog');
				dialog.className = 'dialog-overlay';
				const box = document.createElement('div');
				box.className = 'dialog-box';
				if (options.title) {
					const title = document.createElement('div');
					title.className = 'dialog-title';
					title.textContent = options.title;
					box.appendChild(title);
				}
				const content = document.createElement('div');
				content.className = 'dialog-message';
				content.textContent = getDialogMessage(options.message, options.fallback);
				box.appendChild(content);
				dialog.appendChild(box);
				document.body.appendChild(dialog);
				return { dialog: dialog, box: box };
			}

			window.MutanDialog = {
				alert: function (message, options) {
					options = options || {};
					return new Promise(function (resolve) {
						const { dialog, box } = createDialog({
							title: options.title,
							message: message,
							fallback: '操作失败，请稍后重试'
						});
						const actions = document.createElement('div');
						actions.className = 'dialog-actions';
						const okButton = document.createElement('button');
						okButton.className = 'dialog-btn dialog-btn-primary';
						okButton.type = 'button';
						okButton.textContent = '确定';
						actions.appendChild(okButton);
						box.appendChild(actions);

						function close() {
							dialog.close();
							dialog.remove();
							resolve();
						}

						okButton.addEventListener('click', close);
						dialog.addEventListener('click', function (event) {
							if (event.target === dialog) close();
						});
						dialog.addEventListener('cancel', function (event) {
							event.preventDefault();
							close();
						});
						dialog.showModal();
						okButton.focus();
					});
				},
				confirm: function (message, options) {
					options = options || {};
					return new Promise(function (resolve) {
						const { dialog, box } = createDialog({
							title: options.title,
							message: message,
							fallback: '请确认操作'
						});
						const actions = document.createElement('div');
						actions.className = 'dialog-actions';
						const cancelButton = document.createElement('button');
						cancelButton.className = 'dialog-btn';
						cancelButton.type = 'button';
						cancelButton.textContent = '取消';
						const confirmButton = document.createElement('button');
						confirmButton.className = options.danger
							? 'dialog-btn dialog-btn-danger'
							: 'dialog-btn dialog-btn-primary';
						confirmButton.type = 'button';
						confirmButton.textContent = '确定';
						actions.append(cancelButton, confirmButton);
						box.appendChild(actions);

						function close(result) {
							dialog.close();
							dialog.remove();
							resolve(result);
						}

						confirmButton.addEventListener('click', function () {
							close(true);
						});
						cancelButton.addEventListener('click', function () {
							close(false);
						});
						dialog.addEventListener('click', function (event) {
							if (event.target === dialog) close(false);
						});
						dialog.addEventListener('cancel', function (event) {
							event.preventDefault();
							close(false);
						});
						dialog.showModal();
						cancelButton.focus();
					});
				}
			};
		</script>

		<script>
			/**
			 * 侧边栏折叠/展开交互
			 *
			 * 移动端点击汉堡按钮切换侧边栏显示，
			 * 点击遮罩层关闭侧边栏。
			 */
			const toggle = document.getElementById('sidebar-toggle');
			const sidebar = document.getElementById('admin-sidebar');
			const overlay = document.getElementById('sidebar-overlay');

			toggle?.addEventListener('click', () => {
				const isOpen = sidebar?.classList.toggle('admin-sidebar-open') ?? false;
				overlay?.classList.toggle('admin-sidebar-overlay-visible');
				toggle?.setAttribute('aria-expanded', String(isOpen));
			});

			overlay?.addEventListener('click', () => {
				sidebar?.classList.remove('admin-sidebar-open');
				overlay?.classList.remove('admin-sidebar-overlay-visible');
				toggle?.setAttribute('aria-expanded', 'false');
			});
		</script>
	</body>
</html>
