---
/**
 * 博客频道布局
 *
 * 基于 BaseLayout，全宽单列布局，无侧边栏。
 * 用于博客频道页、博客文章详情页、写文章页。
 */
import BaseLayout from './Base.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd
} = Astro.props;
const hasDiscoveryAside = Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<div class:list={['layout-full', { 'layout-content-with-aside': hasDiscoveryAside }]}>
		<div class="layout-content-main">
			<slot />
		</div>
		{
			hasDiscoveryAside && (
				<div class="layout-discovery-sidebar">
					<slot name="aside" />
				</div>
			)
		}
	</div>
</BaseLayout>
