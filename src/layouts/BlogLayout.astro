---
/**
 * 博客频道布局
 *
 * 基于 BaseLayout，全宽单列布局，无侧边栏。
 * 用于博客频道页、博客文章详情页、写文章页。
 */
import BaseLayout from './Base.astro';
import ChannelShell from '@/components/ChannelShell.astro';
import BlogNavigation from '@/components/BlogNavigation.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
	hasAside?: boolean;
	/** 写作等任务页保留全宽工作区，浏览页默认注入共享导航。 */
	showNavigation?: boolean;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd,
	hasAside,
	showNavigation = true
} = Astro.props;
const hasDiscoveryAside = hasAside ?? Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	{
		showNavigation ? (
			<ChannelShell
				navLabel="博客导航"
				hasAside={hasDiscoveryAside}
				variant={hasDiscoveryAside ? 'three-column' : 'nav-main'}
			>
				<Fragment slot="nav">
					<BlogNavigation />
				</Fragment>
				<slot />
				{hasDiscoveryAside && (
					<Fragment slot="aside">
						<slot name="aside" />
					</Fragment>
				)}
			</ChannelShell>
		) : (
			<div class="layout-full">
				<slot />
			</div>
		)
	}
</BaseLayout>
