---
/**
 * 论坛频道布局
 *
 * 基于 BaseLayout 的论坛频道壳。
 * 左侧导航由本布局统一提供，用于论坛首页与版块详情页，避免各页面重复维护。
 */
import BaseLayout from './Base.astro';
import ChannelShell from '@/components/ChannelShell.astro';
import ForumNavigation from '@/components/ForumNavigation.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
	hasAside?: boolean;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd,
	hasAside
} = Astro.props;
const hasDiscoveryAside = hasAside ?? Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<ChannelShell
		navLabel="论坛导航"
		hasAside={hasDiscoveryAside}
		variant={hasDiscoveryAside ? 'three-column' : 'nav-main'}
		channel="forum"
	>
		<Fragment slot="nav">
			<ForumNavigation />
		</Fragment>
		<slot />
		<Fragment slot="aside">
			<slot name="aside" />
		</Fragment>
	</ChannelShell>
</BaseLayout>
