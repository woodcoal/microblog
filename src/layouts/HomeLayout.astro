---
/**
 * 首页布局
 *
 * 基于 BaseLayout，全宽个性化推荐布局，无侧边栏。
 * 首页作为全站数据聚合入口，以推荐/发现为核心，
 * 展示热门内容、个性化推荐、各频道精选等。
 */
import BaseLayout from './Base.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<div class="layout-home">
		<slot />
	</div>
</BaseLayout>

<style>
	/* C 型发现首页：引导区与跨频道内容使用更宽的页面壳。 */
	.layout-home {
		max-width: var(--layout-home);
		margin: 0 auto;
		padding: 0 var(--spacing-6) var(--spacing-12);
		flex: 1;
		width: 100%;
	}

	@media (max-width: 767px) {
		.layout-home {
			padding: 0 var(--spacing-4)
				calc(56px + var(--spacing-6) + env(safe-area-inset-bottom, 0));
		}
	}
</style>
