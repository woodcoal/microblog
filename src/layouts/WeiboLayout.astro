---
/**
 * 微博频道布局
 *
 * 基于 BaseLayout，提供两栏布局（左侧导航菜单 + 右侧内容）。
 * 用于首页、微博频道、用户主页等需要侧边栏的页面。
 */
import BaseLayout from './Base.astro';
import ContentListShell from '@/components/ContentListShell.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
	hasAside?: boolean;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd,
	hasAside
} = Astro.props;

const currentPath = Astro.url.pathname;
const hasDiscoveryAside = hasAside ?? Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<ContentListShell navLabel="内容导航" hasAside={hasDiscoveryAside}>
		<Fragment slot="nav">
			<section class="weibo-sidebar-group" aria-label="微博导航">
				<a
					href="/weibo"
					class="sidebar-link"
					aria-current={currentPath === '/weibo' &&
					Astro.url.searchParams.get('sort') !== 'popular'
						? 'page'
						: undefined}
				>
					<span class="sidebar-link-icon">✨</span>
					<span>推荐</span>
				</a>
				<a
					href="/weibo?sort=popular"
					class="sidebar-link"
					aria-current={currentPath === '/weibo' &&
					Astro.url.searchParams.get('sort') === 'popular'
						? 'page'
						: undefined}
				>
					<span class="sidebar-link-icon">🔥</span>
					<span>热门</span>
				</a>
				<a
					href="/latest"
					class="sidebar-link"
					aria-current={currentPath.startsWith('/latest') ? 'page' : undefined}
				>
					<span class="sidebar-link-icon">⏰</span>
					<span>最新</span>
				</a>
			</section>
		</Fragment>
		<slot />
		{
			hasDiscoveryAside && (
				<Fragment slot="aside">
					<slot name="aside" />
				</Fragment>
			)
		}
	</ContentListShell>
</BaseLayout>
