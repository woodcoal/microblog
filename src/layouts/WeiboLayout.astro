---
/**
 * 微博频道布局
 *
 * 基于 BaseLayout，提供两栏布局（左侧导航菜单 + 右侧内容）。
 * 用于首页、微博频道、用户主页等需要侧边栏的页面。
 */
import BaseLayout from './Base.astro';
import { getUserFromRequest } from '@/lib/auth';
import ContentListShell from '@/components/ContentListShell.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
	hasAside?: boolean;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd,
	hasAside
} = Astro.props;

const currentUser = await getUserFromRequest(Astro);
const currentPath = Astro.url.pathname;
const hasDiscoveryAside = hasAside ?? Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<ContentListShell navLabel="内容导航" hasAside={hasDiscoveryAside}>
		<Fragment slot="nav">
			<section class="weibo-sidebar-group" aria-labelledby="weibo-sidebar-feed-title">
				<h2 id="weibo-sidebar-feed-title" class="sidebar-section-label">动态</h2>
				<a
					href="/weibo"
					class="sidebar-link"
					aria-current={currentPath === '/weibo' ? 'page' : undefined}
				>
					<span class="sidebar-link-icon">🏠</span>
					<span>首页</span>
				</a>
				<a
					href="/latest"
					class="sidebar-link"
					aria-current={currentPath.startsWith('/latest') ? 'page' : undefined}
				>
					<span class="sidebar-link-icon">⏰</span>
					<span>最新</span>
				</a>
			</section>
			{
				currentUser ? (
					<section
						class="weibo-sidebar-group"
						aria-labelledby="weibo-sidebar-personal-title"
					>
						<h2 id="weibo-sidebar-personal-title" class="sidebar-section-label">
							个人
						</h2>
						<a
							href="/bookmarks"
							class="sidebar-link"
							aria-current={currentPath.startsWith('/bookmarks') ? 'page' : undefined}
						>
							<span class="sidebar-link-icon">🔖</span>
							<span>收藏</span>
						</a>
						<a
							href="/following"
							class="sidebar-link"
							aria-current={currentPath.startsWith('/following') ? 'page' : undefined}
						>
							<span class="sidebar-link-icon">👀</span>
							<span>关注</span>
						</a>
						<a
							href="/followers"
							class="sidebar-link"
							aria-current={currentPath.startsWith('/followers') ? 'page' : undefined}
						>
							<span class="sidebar-link-icon">👥</span>
							<span>粉丝</span>
						</a>
						<a
							href={`/${currentUser.username}`}
							class="sidebar-link"
							aria-current={
								currentPath === `/${currentUser.username}` ? 'page' : undefined
							}
						>
							<span class="sidebar-link-icon">👤</span>
							<span>我的主页</span>
						</a>
					</section>
				) : (
					<section
						class="weibo-sidebar-group"
						aria-labelledby="weibo-sidebar-account-title"
					>
						<h2 id="weibo-sidebar-account-title" class="sidebar-section-label">
							账户
						</h2>
						<a
							href="/login"
							class="sidebar-link"
							aria-current={currentPath === '/login' ? 'page' : undefined}
						>
							<span class="sidebar-link-icon">🔑</span>
							<span>登录</span>
						</a>
						<a
							href="/register"
							class="sidebar-link"
							aria-current={currentPath === '/register' ? 'page' : undefined}
						>
							<span class="sidebar-link-icon">📝</span>
							<span>注册</span>
						</a>
					</section>
				)
			}
		</Fragment>
		<slot />
		{
			hasDiscoveryAside && (
				<Fragment slot="aside">
					<slot name="aside" />
				</Fragment>
			)
		}
	</ContentListShell>
</BaseLayout>
