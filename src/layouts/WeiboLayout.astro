---
/**
 * 微博频道布局
 *
 * 基于 BaseLayout，提供两栏布局（左侧导航菜单 + 右侧内容）。
 * 用于首页、微博频道、用户主页等需要侧边栏的页面。
 */
import BaseLayout from './Base.astro';
import ChannelShell from '@/components/ChannelShell.astro';
import WeiboNavigation from '@/components/WeiboNavigation.astro';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
	hasAside?: boolean;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	canonicalUrl,
	noindex,
	jsonLd,
	hasAside
} = Astro.props;

const hasDiscoveryAside = hasAside ?? Astro.slots.has('aside');
---

<BaseLayout
	title={title}
	description={description}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	ogType={ogType}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	jsonLd={jsonLd}
>
	<ChannelShell
		navLabel="内容导航"
		hasAside={hasDiscoveryAside}
		variant={hasDiscoveryAside ? 'three-column' : 'nav-main'}
	>
		<Fragment slot="nav">
			<WeiboNavigation />
		</Fragment>
		<slot />
		{
			hasDiscoveryAside && (
				<Fragment slot="aside">
					<slot name="aside" />
				</Fragment>
			)
		}
	</ChannelShell>
</BaseLayout>
