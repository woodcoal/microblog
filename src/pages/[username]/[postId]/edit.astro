---
/**
 * 帖子编辑页面
 *
 * 需要认证，仅作者可访问。
 * 根据 post.mode 使用不同的编辑器：
 * - weibo：PostEditor.astro（与创建场景复用）
 * - forum：ForumEditor.astro（Markdown 工具栏 + 预览）
 * - blog：BlogEditor.tsx（Tiptap 所见即所得编辑器）
 */
import UserLayout from '@/layouts/UserLayout.astro';
import PostEditor from '@/components/PostEditor.astro';
import ForumEditor from '@/components/ForumEditor.astro';
import BlogEditor from '@/components/BlogEditor';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { POST_CONTENT_MAX_LENGTH } from '@/lib/config';

// 路由参数
const { username, postId } = Astro.params;

// 查询帖子
const post = await prisma.post.findUnique({
	where: { id: postId },
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		},
		media: {
			orderBy: { sortOrder: 'asc' },
			include: {
				fileStorage: {
					select: {
						id: true,
						filePath: true,
						fileSize: true,
						mimeType: true,
						fileType: true
					}
				}
			}
		}
	}
});

// 帖子不存在或用户名不匹配则 404
if (!post || post.user.username !== username) {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 未登录或非作者，跳转到帖子详情页
if (!currentUser || currentUser.userId !== post.userId) {
	return Astro.redirect(`/${username}/${postId}`);
}

// 已删除或已锁定的帖子不可编辑
if (post.isDeleted) {
	return Astro.redirect(`/${username}/${postId}`);
}

if (post.isLocked) {
	return Astro.redirect(`/${username}/${postId}`);
}

// 构建媒体数据传给编辑表单
const initialMedia = post.media.map((m) => ({
	id: m.id,
	fileStorageId: m.fileStorageId,
	fileType: m.fileType,
	originalName: m.originalName,
	url: `/uploads/${m.fileStorage.filePath}`
}));

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const isWeibo = post.mode === 'weibo';
const isForum = post.mode === 'forum';
const isBlog = post.mode === 'blog';
const blogCategories = isBlog
	? await prisma.category.findMany({
			where: { mode: 'blog' },
			orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }]
		})
	: [];
const hasBlogCategories = blogCategories.length > 0;
---

<UserLayout title="编辑帖子">
	<div class="edit-page">
		{!isBlog && <h1 class="edit-page-title">编辑帖子</h1>}

		{/* weibo 模式：与创建场景复用 PostEditor */}
		{
			isWeibo && (
				<PostEditor
					postId={post.id}
					initialContent={post.content}
					username={post.user.username}
					initialMedia={initialMedia}
					initialVisibility={post.visibility}
				/>
			)
		}

		{/* forum 模式：使用 ForumEditor */}
		{
			isForum && (
				<div
					class="forum-edit-container"
					id="forum-edit-container"
					data-post-id={post.id}
					data-username={post.user.username}
					data-visibility={post.visibility}
				>
					<div class="form-group">
						<label class="form-label" for="forum-edit-title">
							标题
						</label>
						<input
							type="text"
							class="form-input"
							id="forum-edit-title"
							value={post.title || ''}
							maxlength="200"
						/>
					</div>
					<ForumEditor
						formId="forum-edit-editor"
						initialContent={post.content}
						maxLength={POST_CONTENT_MAX_LENGTH}
						submitLabel="保存修改"
					/>
					<div class="form-group">
						<label class="form-label" for="forum-edit-visibility">
							可见度
						</label>
						<select class="form-input" id="forum-edit-visibility">
							<option value="public" selected={post.visibility === 'public'}>
								🌐 公开
							</option>
							<option value="logged_in" selected={post.visibility === 'logged_in'}>
								🔐 登录用户可见
							</option>
							<option value="followers" selected={post.visibility === 'followers'}>
								👥 粉丝可见
							</option>
							<option value="following" selected={post.visibility === 'following'}>
								🤝 我关注的人可见
							</option>
							<option value="private" selected={post.visibility === 'private'}>
								🔒 仅自己可见
							</option>
						</select>
					</div>
					<p class="form-error" id="forum-edit-error" style="display:none" />
				</div>
			)
		}

		{/* blog 模式：与新建页使用相同的文档工作区 */}
		{
			isBlog && (
				<div
					class="blog-write-page blog-edit-page"
					id="blog-edit-container"
					data-post-id={post.id}
					data-username={post.user.username}
					data-visibility={post.visibility}
				>
					<div class="blog-write-toolbar">
						<div class="blog-write-toolbar-left">
							{hasBlogCategories && (
								<select
									class="form-input blog-write-select"
									id="blog-edit-category"
								>
									<option value="">选择分类（可选）</option>
									{blogCategories.map((category) => (
										<option
											value={category.id}
											selected={post.categoryId === category.id}
										>
											{category.icon && `${category.icon} `}
											{category.name}
										</option>
									))}
								</select>
							)}
							<select class="form-input blog-write-select" id="blog-edit-visibility">
								<option value="public" selected={post.visibility === 'public'}>
									🌐 公开
								</option>
								<option
									value="logged_in"
									selected={post.visibility === 'logged_in'}
								>
									🔐 登录用户可见
								</option>
								<option
									value="followers"
									selected={post.visibility === 'followers'}
								>
									👥 粉丝可见
								</option>
								<option
									value="following"
									selected={post.visibility === 'following'}
								>
									🤝 我关注的人可见
								</option>
								<option value="private" selected={post.visibility === 'private'}>
									🔒 仅自己可见
								</option>
							</select>
						</div>
						<div class="blog-write-toolbar-right">
							<a
								href={`/${post.user.username}/${post.id}`}
								class="btn blog-write-cancel-btn"
							>
								取消
							</a>
							<button
								class="btn btn-primary blog-write-publish-btn"
								id="blog-edit-save"
							>
								保存修改
							</button>
						</div>
					</div>
					<div class="blog-write-doc" data-max-length={POST_CONTENT_MAX_LENGTH}>
						<input
							type="text"
							class="blog-write-title"
							id="blog-edit-title"
							value={post.title || ''}
							placeholder="文章标题"
							maxlength="200"
						/>
						<BlogEditor
							client:load
							initialContent={post.content}
							containerId="blog-edit-container"
							draftKey={`blog-draft-${post.id}`}
							titleInputId="blog-edit-title"
							categorySelectId="blog-edit-category"
							visibilitySelectId="blog-edit-visibility"
						/>
					</div>
					<p class="form-error" id="blog-edit-error" style="display:none" />
				</div>
			)
		}
	</div>
</UserLayout>

<style>
	.edit-page {
		padding: 1rem 0;
	}
	.edit-page-title {
		font-size: 1.25rem;
		font-weight: 600;
		margin-bottom: 1rem;
	}
</style>

<script>
	/**
	 * 论坛模式编辑页客户端脚本
	 *
	 * 从 ForumEditor 获取内容，调用 actions.updatePost 保存修改。
	 */
	import { actions } from 'astro:actions';

	const forumContainer = document.getElementById('forum-edit-container');
	if (forumContainer) {
		const postId = forumContainer.dataset.postId || '';
		const username = forumContainer.dataset.username || '';
		const editorEl = document.getElementById('forum-edit-editor');
		const titleInput = document.getElementById('forum-edit-title') as HTMLInputElement;
		const visibilitySelect = document.getElementById(
			'forum-edit-visibility'
		) as HTMLSelectElement;
		const formError = document.getElementById('forum-edit-error') as HTMLParagraphElement;
		let loading = false;

		/**
		 * 显示错误信息
		 *
		 * @param msg - 错误消息
		 */
		function showError(msg: string): void {
			formError.textContent = msg;
			formError.style.display = '';
		}

		// 监听 ForumEditor 的提交按钮
		const submitBtn = editorEl?.querySelector('.btn-primary') as HTMLButtonElement | null;
		if (submitBtn) {
			submitBtn.addEventListener('click', async (e: Event) => {
				e.preventDefault();
				if (loading) return;

				const title = titleInput.value.trim();
				const content =
					(
						editorEl as (HTMLElement & { getContent?: () => string }) | null
					)?.getContent?.() || '';

				if (!content) {
					showError('请输入帖子内容');
					return;
				}

				loading = true;
				formError.style.display = 'none';

				const result = await actions.updatePost({
					postId,
					content,
					visibility: visibilitySelect.value,
					title: title || undefined
				});

				if (result.error) {
					showError(result.error.message || '保存失败');
				} else {
					window.location.href = `/${username}/${postId}`;
				}

				loading = false;
			});
		}
	}
</script>

<script>
	/**
	 * 博客模式编辑页客户端脚本
	 *
	 * 监听 BlogEditor 的自定义事件，调用 actions.updatePost 保存修改。
	 */
	import { actions } from 'astro:actions';

	const blogContainer = document.getElementById('blog-edit-container');
	if (blogContainer) {
		const postId = blogContainer.dataset.postId || '';
		const username = blogContainer.dataset.username || '';
		const titleInput = document.getElementById('blog-edit-title') as HTMLInputElement;
		const visibilitySelect = document.getElementById(
			'blog-edit-visibility'
		) as HTMLSelectElement;
		const categorySelect = document.getElementById(
			'blog-edit-category'
		) as HTMLSelectElement | null;
		const formError = document.getElementById('blog-edit-error') as HTMLParagraphElement;
		const saveBtn = document.getElementById('blog-edit-save') as HTMLButtonElement;
		let loading = false;

		/**
		 * 显示错误信息
		 *
		 * @param msg - 错误消息
		 */
		function showError(msg: string): void {
			formError.textContent = msg;
			formError.style.display = '';
		}

		// 监听 BlogEditor 的提交事件
		blogContainer.addEventListener('blog-editor-submit', async (e: Event) => {
			if (loading) return;

			const customEvent = e as CustomEvent;
			const content = customEvent.detail as string;
			const title = titleInput.value.trim();

			if (!content) {
				showError('请输入文章内容');
				blogContainer.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				return;
			}
			if (!title) {
				showError('请输入文章标题');
				titleInput.focus();
				blogContainer.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				return;
			}

			loading = true;
			formError.style.display = 'none';
			saveBtn.disabled = true;
			saveBtn.textContent = '保存中...';

			const result = await actions.updatePost({
				postId,
				content,
				visibility: visibilitySelect.value,
				title,
				categoryId: categorySelect?.value || ''
			});

			if (result.error) {
				showError(result.error.message || '保存失败');
				blogContainer.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				saveBtn.disabled = false;
				saveBtn.textContent = '保存修改';
			} else {
				blogContainer.dispatchEvent(new CustomEvent('blog-editor-clear-draft'));
				window.location.href = `/${username}/${postId}`;
			}

			loading = false;
		});

		saveBtn.addEventListener('click', () => {
			blogContainer.dispatchEvent(new CustomEvent('blog-editor-do-submit'));
		});
	}
</script>
