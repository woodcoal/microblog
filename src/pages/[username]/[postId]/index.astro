				)
			}
			{
				!isDeleted && !needPassword && !isLocked && (
					<section class="post-detail-comments" id="post-comments">
						<CommentList
							postId={post.id}
							currentUser={currentUserForComponent}
							initialComments={serializedComments}
							initialSort={commentSortOrder}
							commentCount={commentCount}
							presentation={isForum ? 'forum' : isBlog ? 'blog' : 'weibo'}
						/>
					</section>
				)
			}
		</div>
		<aside class="post-detail-aside" aria-label="文章辅助信息">
			{
				isForum ? (
					<>
						<section class="post-detail-aside-section">
							<h2>相关版块</h2>
							{relatedForums.length ? (
								<nav class="post-detail-aside-list" aria-label="相关版块列表">
									{relatedForums.map((category) => (
										<a href={`/forum/${category.slug}`}>
											<span>
												{category.icon || '◌'} {category.name}
											</span>
											{category.description && (
												<small>{category.description}</small>
