---
/**
 * 帖子详情页
 *
 * 完整展示帖子内容（Markdown 渲染）、作者信息。
 * 已删除帖子显示"该内容已删除"。
 * 作者可见编辑/删除按钮和版本历史链接。
 * 已编辑帖子显示"已编辑"标记和编辑时间。
 * 包含点赞按钮和评论区域。
 * 支持可见度控制：不可见帖子返回 404，密码保护帖子显示密码输入框。
 */
import UserLayout from '@/layouts/UserLayout.astro';
import LikeButton from '@/components/LikeButton.astro';
import BookmarkButton from '@/components/BookmarkButton.astro';
import CommentList from '@/components/CommentList.astro';
import ImageLightbox from '@/components/ImageLightbox.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown, renderFullMarkdown } from '@/lib/markdown';
import { formatRelativeTime } from '@/lib/utils';
import { checkPostVisibility } from '@/lib/visibility';
import { SITE_URL, SITE_TITLE, MAX_USER_PINNED_POSTS, getModeLabel } from '@/lib/config';

// 路由参数
const { username, postId } = Astro.params;

// 查询帖子
const post = await prisma.post.findUnique({
	where: { id: postId },
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		},
		media: {
			orderBy: { sortOrder: 'asc' },
			include: {
				fileStorage: {
					select: {
						id: true,
						filePath: true,
						fileSize: true,
						mimeType: true,
						fileType: true
					}
				}
			}
		},
		tags: {
			include: {
				tag: {
					select: {
						id: true,
						name: true
					}
				}
			}
		},
		mentions: {
			include: {
				user: {
					select: {
						id: true,
						username: true,
						displayName: true
					}
				}
			}
		},
		category: {
			select: {
				id: true,
				name: true,
				slug: true,
				mode: true
			}
		}
	}
});

// 帖子不存在或用户名不匹配则 404
if (!post || post.user.username !== username) {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 判断是否是帖子作者
const isAuthor = currentUser?.userId === post.userId;

// 可见度检查
// 查询当前用户是否是帖子作者的粉丝
let isFollower = false;
if (currentUser && !isAuthor) {
	const followRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: currentUser.userId,
				followingId: post.userId
			}
		}
	});
	isFollower = !!followRecord;
}

// 查询帖子作者是否关注了当前用户
let isFollowing = false;
if (currentUser && !isAuthor) {
	const followRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: post.userId,
				followingId: currentUser.userId
			}
		}
	});
	isFollowing = !!followRecord;
}

// 检查帖子可见度（密码保护帖子在服务端不做密码验证，由前端处理）
const isVisible = await checkPostVisibility(
	{
		visibility: post.visibility,
		userId: post.userId,
		passwordHash: post.passwordHash,
		allowedUserIds: post.allowedUserIds
	},
	currentUser ? { userId: currentUser.userId } : null,
	{ isFollower, isFollowing }
);

// 不可见且非密码保护帖子，返回 404
// 密码保护帖子需要前端交互，不在此处拦截
const isPasswordProtected = post.visibility === 'password';
if (!isVisible && !isPasswordProtected) {
	return Astro.redirect('/404');
}

// 密码保护帖子且非作者，标记为需要密码验证
const needPassword = isPasswordProtected && !isAuthor;

// 已删除帖子的处理
const isDeleted = post.isDeleted;
const isLocked = post.isLocked;

// 是否可以置顶（作者且置顶功能开启）
const canPin = isAuthor && MAX_USER_PINNED_POSTS > 0;

// 分离图片和附件
const images = post.media.filter((m) => m.fileType === 'image');
const attachments = post.media.filter((m) => m.fileType === 'attachment');
const hasImages = images.length > 0;
const hasAttachments = attachments.length > 0;

// 提取标签列表
const postTags = post.tags.map((pt) => pt.tag);
const hasTags = postTags.length > 0;

// 提取提及用户列表
const mentionedUsers = post.mentions.map((m) => m.user);
const hasMentions = mentionedUsers.length > 0;

// 查询点赞数和点赞用户列表（朋友圈风格展示）
const likeRecords = await prisma.like.findMany({
	where: { postId: post.id },
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		}
	},
	orderBy: { createdAt: 'desc' }
});
const likeCount = likeRecords.length;
// 点赞用户列表（用于朋友圈风格展示）
const likeUsers = likeRecords.map((r) => r.user);

// 查询当前用户是否已点赞
let liked = false;
if (currentUser) {
	liked = likeRecords.some((r) => r.userId === currentUser.userId);
}

// 查询收藏数和当前用户是否已收藏
const bookmarkCount = await prisma.bookmark.count({
	where: { postId: post.id }
});
let bookmarked = false;
if (currentUser) {
	const bookmarkRecord = await prisma.bookmark.findUnique({
		where: {
			userId_postId: {
				userId: currentUser.userId,
				postId: post.id
			}
		}
	});
	bookmarked = !!bookmarkRecord;
}

// 获取评论排序偏好
let commentSortOrder: 'asc' | 'desc' = 'asc';
if (currentUser) {
	const settings = await prisma.userSettings.findUnique({
		where: { userId: currentUser.userId }
	});
	if (settings?.commentSortOrder === 'desc') {
		commentSortOrder = 'desc';
	}
}

// 查询评论列表（一级评论 + 嵌套二级评论）
const comments = await prisma.comment.findMany({
	where: {
		postId: post.id,
		parentId: null
	},
	orderBy: { createdAt: commentSortOrder },
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		},
		replies: {
			orderBy: { createdAt: 'asc' },
			include: {
				user: {
					select: {
						id: true,
						username: true,
						displayName: true,
						avatarUrl: true
					}
				},
				likes: true
			}
		},
		likes: true
	}
});

// 当前用户 ID，用于判断点赞状态
const currentUserId = currentUser?.userId;

// 序列化评论数据，附加点赞信息
const serializedComments = comments.map((comment) => {
	const likeCount = comment.likes.length;
	const commentLiked = currentUserId
		? comment.likes.some((l) => l.userId === currentUserId)
		: false;

	const replies = comment.replies.map((reply) => ({
		id: reply.id,
		postId: reply.postId,
		userId: reply.userId,
		parentId: reply.parentId,
		content: reply.isDeleted ? '该内容已删除' : reply.content,
		isDeleted: reply.isDeleted,
		createdAt: reply.createdAt.toISOString(),
		updatedAt: reply.updatedAt.toISOString(),
		user: reply.user,
		likeCount: reply.likes.length,
		liked: currentUserId ? reply.likes.some((l) => l.userId === currentUserId) : false
	}));

	return {
		id: comment.id,
		postId: comment.postId,
		userId: comment.userId,
		parentId: comment.parentId,
		content: comment.isDeleted ? '该内容已删除' : comment.content,
		isDeleted: comment.isDeleted,
		createdAt: comment.createdAt.toISOString(),
		updatedAt: comment.updatedAt.toISOString(),
		user: comment.user,
		likeCount,
		liked: commentLiked,
		replies
	};
});

// 评论总数（一级 + 二级）
const commentCount = comments.reduce((sum, c) => sum + 1 + c.replies.length, 0);

// 当前用户信息（传给 React 组件）
const currentUserForComponent = currentUser
	? { userId: currentUser.userId, username: currentUser.username }
	: null;

// ===== SEO 元数据 =====
// 帖子模式相关变量
const postMode = post.mode || 'weibo';
const isWeibo = postMode === 'weibo';
const isForum = postMode === 'forum';
const isBlog = postMode === 'blog';

// 渲染内容：forum/blog 模式使用 renderFullMarkdown（支持图片），weibo 使用受限版
const htmlContent = isDeleted
	? '<p>该内容已删除</p>'
	: isForum || isBlog
		? renderFullMarkdown(post.content)
		: renderMarkdown(post.content);
const hasTitle = !!post.title;
const hasCategory = !!post.category;

// 页面标题：根据模式不同显示不同格式
const seoTitle = isDeleted
	? '该内容已删除'
	: isForum || isBlog
		? post.title || `${post.user.displayName}的帖子`
		: `${post.user.displayName}的${getModeLabel('weibo')}`;

// 页面描述：帖子内容前 100 字符，去除 Markdown 标记
const seoDescription = isDeleted
	? '该内容已删除'
	: post.content.replace(/[#*`>\-\[\]()!]/g, '').slice(0, 100);

// 规范链接
const canonicalUrl = `${SITE_URL}/${post.user.username}/${post.id}`;

// 是否为非公开帖子（需要 noindex）
const isNotPublic = post.visibility !== 'public';

// OG 图片：取帖子第一张图片，无图片时不设置
const ogImageUrl = hasImages ? `${SITE_URL}/uploads/${images[0].fileStorage.filePath}` : undefined;
---

<UserLayout
	title={seoTitle}
	description={seoDescription}
	ogTitle={`${seoTitle} - ${SITE_TITLE}`}
	ogDescription={seoDescription}
	ogType="article"
	ogImage={ogImageUrl}
	canonicalUrl={canonicalUrl}
	noindex={isNotPublic}
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: seoTitle,
		description: seoDescription,
		url: canonicalUrl,
		image: ogImageUrl,
		author: {
			'@type': 'Person',
			name: post.user.displayName,
			url: `${SITE_URL}/${post.user.username}`
		},
		datePublished: post.createdAt.toISOString(),
		dateModified: post.updatedAt.toISOString(),
		publisher: {
			'@type': 'Organization',
			name: SITE_TITLE,
			url: SITE_URL
		}
	}}
>
	<article class="post-detail">
		{
			isForum && !isDeleted ? (
				/* 论坛模式：标题大字 + 版块面包屑 */
				<div class="post-detail-forum-header">
					{hasCategory && (
						<div class="post-detail-breadcrumb">
							<a href="/" class="post-detail-breadcrumb-link">
								首页
							</a>
							<span class="post-detail-breadcrumb-sep">/</span>
							<span class="post-detail-breadcrumb-current">{post.category.name}</span>
						</div>
					)}
					{hasTitle && <h1 class="post-detail-forum-title">{post.title}</h1>}
					<div class="post-detail-header">
						<a href={`/${post.user.username}`} class="post-detail-author">
							{post.user.avatarUrl ? (
								<img
									src={post.user.avatarUrl}
									alt={post.user.displayName}
									class="post-detail-avatar"
									loading="lazy"
								/>
							) : (
								<div class="post-detail-avatar post-detail-avatar-placeholder">
									{post.user.displayName.charAt(0).toUpperCase()}
								</div>
							)}
							<div class="post-detail-author-info">
								<span class="post-detail-name">{post.user.displayName}</span>
								<span class="post-detail-username">@{post.user.username}</span>
							</div>
						</a>
						<div class="post-detail-time-group">
							<time class="post-detail-time" datetime={post.createdAt.toISOString()}>
								{formatRelativeTime(post.createdAt)}
							</time>
							{post.isEdited && (
								<span class="post-detail-edited">
									已编辑 ·{' '}
									<time datetime={post.updatedAt.toISOString()}>
										{formatRelativeTime(post.updatedAt)}
									</time>
								</span>
							)}
						</div>
					</div>
				</div>
			) : isBlog && !isDeleted ? (
				/* 博客模式：文章标题 + 分类 + 发布日期 */
				<div class="post-detail-blog-header">
					{hasCategory && (
						<div class="post-detail-blog-category">
							<span class="post-detail-blog-category-name">{post.category.name}</span>
						</div>
					)}
					{hasTitle && <h1 class="post-detail-blog-title">{post.title}</h1>}
					<div class="post-detail-blog-meta">
						<a href={`/${post.user.username}`} class="post-detail-author">
							{post.user.avatarUrl ? (
								<img
									src={post.user.avatarUrl}
									alt={post.user.displayName}
									class="post-detail-avatar"
									loading="lazy"
								/>
							) : (
								<div class="post-detail-avatar post-detail-avatar-placeholder">
									{post.user.displayName.charAt(0).toUpperCase()}
								</div>
							)}
							<div class="post-detail-author-info">
								<span class="post-detail-name">{post.user.displayName}</span>
								<span class="post-detail-username">
									@{post.user.username} ·{' '}
									{post.createdAt.toLocaleDateString('zh-CN', {
										year: 'numeric',
										month: 'long',
										day: 'numeric'
									})}
								</span>
							</div>
						</a>
						{post.isEdited && (
							<span class="post-detail-edited">
								已编辑 ·{' '}
								<time datetime={post.updatedAt.toISOString()}>
									{formatRelativeTime(post.updatedAt)}
								</time>
							</span>
						)}
					</div>
				</div>
			) : (
				/* 微博模式：现有样式，title 显示在内容上方 */
				<div class="post-detail-header">
					<a href={`/${post.user.username}`} class="post-detail-author">
						{post.user.avatarUrl ? (
							<img
								src={post.user.avatarUrl}
								alt={post.user.displayName}
								class="post-detail-avatar"
								loading="lazy"
							/>
						) : (
							<div class="post-detail-avatar post-detail-avatar-placeholder">
								{post.user.displayName.charAt(0).toUpperCase()}
							</div>
						)}
						<div class="post-detail-author-info">
							<span class="post-detail-name">{post.user.displayName}</span>
							<span class="post-detail-username">@{post.user.username}</span>
						</div>
					</a>
					<div class="post-detail-time-group">
						<time class="post-detail-time" datetime={post.createdAt.toISOString()}>
							{formatRelativeTime(post.createdAt)}
						</time>
						{post.isEdited && !isDeleted && (
							<span class="post-detail-edited">
								已编辑 ·{' '}
								<time datetime={post.updatedAt.toISOString()}>
									{formatRelativeTime(post.updatedAt)}
								</time>
							</span>
						)}
					</div>
				</div>
			)
		}

		{
			needPassword && (
				<div class="post-detail-password-gate" id="password-gate">
					<p class="post-detail-password-hint">🔑 这条帖子需要密码才能查看</p>
					<div class="post-detail-password-form">
						<input
							type="password"
							id="post-password-input"
							class="form-input"
							placeholder="请输入访问密码"
						/>
						<button type="button" id="verify-password-btn" class="btn btn-primary">
							验证
						</button>
					</div>
					<p
						class="post-detail-password-error"
						id="password-error"
						style="display:none;color:var(--color-danger);font-size:0.8125rem;margin-top:0.5rem;"
					/>
				</div>
			)
		}

		<!-- 微博模式标题 -->
		{
			isWeibo && hasTitle && !isDeleted && !needPassword && (
				<h2 class="post-detail-subtitle">{post.title}</h2>
			)
		}

		<!-- 帖子内容（密码保护时默认隐藏，验证后显示） -->
		<div
			class="post-detail-content"
			set:html={htmlContent}
			id="post-content"
			style={needPassword ? 'display:none' : undefined}
		/>

		<!-- 标签列表 -->
		{
			hasTags && !isDeleted && !needPassword && (
				<div class="post-detail-tags">
					{postTags.map((tag) => (
						<a href={`/tags/${tag.name}`} class="post-detail-tag">
							{tag.name}
						</a>
					))}
				</div>
			)
		}

		<!-- 提及用户列表 -->
		{
			hasMentions && !isDeleted && !needPassword && (
				<div class="post-detail-mentions">
					<span class="post-detail-mentions-label">提及：</span>
					{mentionedUsers.map((user) => (
						<a href={`/${user.username}`} class="post-detail-mention">
							@{user.username}
						</a>
					))}
				</div>
			)
		}

		{
			hasImages && !isDeleted && !needPassword && (
				<div
					class={`post-detail-images post-detail-images-${images.length >= 5 ? 'grid' : images.length}`}
				>
					{images.map((media) => (
						<div class="post-detail-image-item">
							<img
								src={`/uploads/${media.fileStorage.filePath}`}
								alt=""
								loading="lazy"
								data-lightbox="true"
							/>
						</div>
					))}
				</div>
			)
		}

		{
			hasAttachments && !isDeleted && !needPassword && (
				<div class="post-detail-attachments">
					{attachments.map((media) => (
						<a
							href={`/uploads/${media.fileStorage.filePath}`}
							class="post-detail-attachment"
							download
						>
							📎 {media.originalName || media.fileStorage.filePath.split('/').pop()}
							<span class="post-detail-attachment-size">
								({(media.fileStorage.fileSize / 1024).toFixed(1)} KB)
							</span>
						</a>
					))}
				</div>
			)
		}

		<!-- 点赞区域：单行布局，头像 + 数量 + 用户头像列表 -->
		{
			!isDeleted && !needPassword && (
				<div class="post-detail-like" id="post-like-section">
					<LikeButton
						postId={post.id}
						initialLiked={liked}
						initialLikeCount={likeCount}
					/>
					<BookmarkButton
						postId={post.id}
						initialBookmarked={bookmarked}
						initialBookmarkCount={bookmarkCount}
					/>
					{likeUsers.length > 0 && (
						<div class="like-users" id="like-users-list">
							{likeUsers.slice(0, 10).map((u) => (
								<a
									href={`/${u.username}`}
									class="like-user-avatar"
									title={u.displayName}
								>
									{u.avatarUrl ? (
										<img src={u.avatarUrl} alt={u.displayName} loading="lazy" />
									) : (
										<span class="like-avatar-placeholder">
											{u.displayName.charAt(0).toUpperCase()}
										</span>
									)}
								</a>
							))}
							{likeUsers.length > 10 && (
								<span
									class="like-users-more"
									title={`还有 ${likeUsers.length - 10} 人点赞`}
								>
									+{likeUsers.length - 10}
								</span>
							)}
						</div>
					)}
				</div>
			)
		}

		{
			isAuthor && !isDeleted && (
				<div class="post-detail-actions">
					{!isLocked && (
						<a href={`/${post.user.username}/${post.id}/edit`} class="btn btn-outline">
							编辑
						</a>
					)}
					<button
						class="btn btn-danger"
						id="delete-btn"
						data-post-id={post.id}
						data-username={post.user.username}
						type="button"
					>
						删除
					</button>
					{post.isEdited && (
						<a
							href={`/${post.user.username}/${post.id}/revisions`}
							class="btn btn-outline"
						>
							版本历史
						</a>
					)}
					{canPin && (
						<button
							class="btn btn-outline"
							id="pin-btn"
							data-post-id={post.id}
							data-pinned={post.isPinned ? 'true' : 'false'}
							type="button"
						>
							{post.isPinned ? '取消置顶' : '置顶'}
						</button>
					)}
				</div>
			)
		}
	</article>

	<!-- 评论区域 -->
	{
		isLocked && !isDeleted && !needPassword && (
			<section class="post-detail-comments">
				<p class="post-detail-locked-hint">🔒 帖子已锁定，评论不可见</p>
			</section>
		)
	}
	{
		!isDeleted && !needPassword && !isLocked && (
			<section class="post-detail-comments">
				<CommentList
					postId={post.id}
					currentUser={currentUserForComponent}
					initialComments={serializedComments}
					initialSort={commentSortOrder}
					commentCount={commentCount}
				/>
			</section>
		)
	}
	<ImageLightbox />
</UserLayout>

<style>
	.post-detail {
		padding: 1rem 0;
	}
	.post-detail-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}
	.post-detail-author {
		display: flex;
		align-items: center;
