				}

				<!-- 帖子内容（密码保护时默认隐藏，验证后显示） -->
				<div
					class="post-detail-content"
					set:html={detailHtmlContent}
					id="post-content"
					style={needPassword ? 'display:none' : undefined}
				/>
				{
					!isDeleted && !needPassword && (
						<p class="post-detail-visibility">{visibilityLabel}</p>
					)
				}

				<!-- 标签列表 -->
				{
					hasTags && !isDeleted && !needPassword && (
						<div class="post-detail-tags">
							{postTags.map((tag) => (
								<a href={`/tags/${tag.name}`} class="post-detail-tag">
									{tag.name}
								</a>
							))}
						</div>
					)
				}

				<!-- 提及用户列表 -->
				{
					hasMentions && !isDeleted && !needPassword && (
						<div class="post-detail-mentions">
							<span class="post-detail-mentions-label">提及：</span>
