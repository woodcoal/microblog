							</small>
						</section>
					</>
				) : isBlog ? (
					<>
						{hasBlogHeadings && !needPassword && (
							<nav class="post-detail-toc" aria-label="文章目录">
								<p class="post-detail-toc-title">目录</p>
								<ol>
									{blogHeadings.map((heading) => (
										<li
											class={
