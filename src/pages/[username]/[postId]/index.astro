											<small>
												{item.user.displayName} ·{' '}
												{item.createdAt.toLocaleDateString('zh-CN')}
											</small>
										</a>
									))}
								</nav>
							) : (
								<p class="post-detail-aside-empty">暂时没有相关博客。</p>
							)}
						</section>
					</>
				) : (
					<>
						<section class="post-detail-aside-section post-detail-author-card">
							<h2>关于作者</h2>
							<a href={`/${post.user.username}`} class="post-detail-aside-author">
								{post.user.avatarUrl ? (
									<img src={post.user.avatarUrl} alt="" />
								) : (
									<span>{post.user.displayName.charAt(0).toUpperCase()}</span>
								)}
								<strong>{post.user.displayName}</strong>
							</a>
							<p>{post.user.bio || '这个作者还没有填写个人简介。'}</p>
							<small>
								{post.user._count.followers} 位关注者 · 正在关注{' '}
								{post.user._count.following} 人
							</small>
						</section>
						<section class="post-detail-aside-section">
							<h2>该作者的其他微博</h2>
							{relatedPosts.length ? (
								<nav class="post-detail-aside-list" aria-label="作者的其他微博">
									{relatedPosts.map((item) => (
										<a href={`/${item.user.username}/${item.id}`}>
											<span>{getAsideExcerpt(item.content, 48)}</span>
											<small>{formatRelativeTime(item.createdAt)}</small>
										</a>
									))}
								</nav>
							) : (
								<p class="post-detail-aside-empty">暂时没有其他微博。</p>
							)}
						</section>
					</>
				)
			}
		</aside>
	</main>
	<ImageLightbox />
</UserLayout>

