								{images.map((media) => (
									<div class="post-detail-image-item">
										<img
											src={`/uploads/${media.fileStorage.filePath}`}
											alt=""
											loading="lazy"
											data-lightbox="true"
										/>
									</div>
								))}
							</div>
						))
				}

				{
					hasAttachments && !isDeleted && !needPassword && (
						<div class="post-detail-attachments">
