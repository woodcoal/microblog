---
/** Canonical public post URL: validates once, then dispatches to an internal mode view. */
import BlogDetailView from '@/views/post-detail/BlogDetailView.astro';
import ForumDetailView from '@/views/post-detail/ForumDetailView.astro';
import WeiboDetailView from '@/views/post-detail/WeiboDetailView.astro';
import {
	loadPostDetail,
	PostDetailGoneError,
	PostDetailNoindexNotFoundError,
	UnknownPostDetailModeError,
	type PostDetailModel
} from '@/lib/post-detail';

let model: PostDetailModel | null;
try {
	model = await loadPostDetail(Astro);
} catch (error) {
	if (error instanceof PostDetailGoneError) {
		return error.response;
	}
	if (error instanceof PostDetailNoindexNotFoundError) {
		return error.response;
	}
	if (error instanceof UnknownPostDetailModeError) {
		console.error(
			JSON.stringify({
				event: 'post_detail_controlled_error',
				postId: error.postId,
				mode: error.mode
			})
		);
		return new Response('内容暂时不可用', { status: 500, statusText: 'Unsupported post mode' });
	}
	throw error;
}

if (!model) return Astro.redirect('/404');
if (model.redirectUsername) {
	const target = new URL(`/${model.redirectUsername}/${Astro.params.postId}`, Astro.url);
	target.search = Astro.url.search;
	return new Response(null, { status: 308, headers: { Location: target.toString() } });
}

const DetailView =
	model.postMode === 'weibo'
		? WeiboDetailView
		: model.postMode === 'forum'
			? ForumDetailView
			: BlogDetailView;
---

<DetailView model={model} />
