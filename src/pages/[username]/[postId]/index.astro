								<a href={`/${user.username}`} class="post-detail-mention">
									@{user.username}
								</a>
							))}
						</div>
					)
				}

				{
					hasImages &&
						!isDeleted &&
						!needPassword &&
						(isWeiboPost ? (
							<WeiboMediaGallery images={images} lightbox />
