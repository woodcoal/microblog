---
/**
 * 用户主页
 *
 * 展示用户资料（头像、昵称、简介、发帖数、粉丝数、关注数）
 * 以及该用户的帖子列表（置顶帖优先，未删除）。
 * 包含 FollowButton 和帖子搜索框。
 */
import BaseLayout from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import FollowButton from '@/components/FollowButton.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { getLikedPostIds } from '@/lib/queries';
import { SITE_URL, SITE_TITLE } from '@/lib/config';

// 路由参数
const { username } = Astro.params;

// 查询用户信息
const user = await prisma.user.findUnique({
	where: { username },
	select: {
		id: true,
		username: true,
		displayName: true,
		avatarUrl: true,
		bio: true,
		createdAt: true
	}
});

// 用户不存在则 404
if (!user) {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 判断是否是自己
const isSelf = currentUser?.userId === user.id;

// 查询当前用户是否已关注该用户
let isFollowing = false;
if (currentUser && !isSelf) {
	const followRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: currentUser.userId,
				followingId: user.id
			}
		}
	});
	isFollowing = !!followRecord;
}

// 统计发帖数（未删除）
const postCount = await prisma.post.count({
	where: {
		userId: user.id,
		isDeleted: false
	}
});

// 统计粉丝数
const followerCount = await prisma.follow.count({
	where: { followingId: user.id }
});

// 统计关注数
const followingCount = await prisma.follow.count({
	where: { followerId: user.id }
});

// 解析搜索关键词参数
const searchQuery = Astro.url.searchParams.get('q')?.trim() || '';

// 解析排序参数：latest（最新，默认）、popular（热门）、oldest（最早）
const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const validSorts = ['latest', 'popular', 'oldest'];
const sort = validSorts.includes(sortParam) ? sortParam : 'latest';

// 解析 mode 过滤参数：all（全部，默认）、weibo、forum、blog
const modeParam = Astro.url.searchParams.get('mode') || 'all';
const validModes = ['all', 'weibo', 'forum', 'blog'];
const modeFilter = validModes.includes(modeParam) ? modeParam : 'all';

// 根据排序方式构建 orderBy 条件
// 置顶帖始终优先，然后按排序方式排列
const orderBy: Record<string, unknown>[] = [{ isPinned: 'desc' }];
if (sort === 'popular') {
	orderBy.push({ likes: { _count: 'desc' } });
} else if (sort === 'oldest') {
	orderBy.push({ createdAt: 'asc' });
} else {
	orderBy.push({ createdAt: 'desc' });
}

// 获取用户的帖子列表：置顶优先，然后按时间倒序
// 根据当前用户身份过滤可见度
const followingIds: string[] = [];
const followerIds: string[] = [];

// 如果不是自己，查询关注关系用于可见度过滤
let isFollowedByUser = false;
if (currentUser && !isSelf) {
	// 当前用户是否关注了该用户（当前用户是该用户的粉丝）
	if (isFollowing) {
		followerIds.push(user.id);
	}
	// 该用户是否关注了当前用户（当前用户在该用户的关注列表中）
	const followBackRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: user.id,
				followingId: currentUser.userId
			}
		}
	});
	isFollowedByUser = !!followBackRecord;
	if (isFollowedByUser) {
		followingIds.push(user.id);
	}
}

// 生成可见度过滤条件
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 构建帖子查询条件
const postWhere: Record<string, unknown> = {
	userId: user.id,
	isDeleted: false,
	...visibilityFilter
};

// 搜索条件：内容包含关键词
if (searchQuery) {
	postWhere.content = { contains: searchQuery };
}

// mode 过滤条件：按模式筛选帖子
if (modeFilter !== 'all') {
	postWhere.mode = modeFilter;
}

const posts = await prisma.post.findMany({
	where: postWhere,
	orderBy,
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		},
		tags: {
			include: {
				tag: {
					select: {
						id: true,
						name: true
					}
				}
			}
		},
		media: {
			include: {
				fileStorage: {
					select: {
						id: true,
						filePath: true,
						fileSize: true,
						mimeType: true,
						fileType: true
					}
				}
			}
		},
		category: {
			select: {
				id: true,
				name: true,
				slug: true,
				mode: true
			}
		},
		_count: {
			select: { likes: true, comments: true }
		}
	},
	take: 20
});

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);
---

<BaseLayout
	title={user.displayName}
	ogTitle={`${user.displayName} (@${user.username}) - ${SITE_TITLE}`}
	ogDescription={user.bio || `${user.displayName} 的微博主页`}
	ogImage={user.avatarUrl || undefined}
	canonicalUrl={`${SITE_URL}/${user.username}`}
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		name: user.displayName,
		alternateName: user.username,
		url: `${SITE_URL}/${user.username}`,
		image: user.avatarUrl,
		description: user.bio
	}}
>
	<div class="profile-banner">
		<div class="profile-header">
			{
				user.avatarUrl ? (
					<img
						src={user.avatarUrl}
						alt={`${user.displayName} 的头像`}
						class="profile-avatar-img"
						loading="lazy"
					/>
				) : (
					<div class="profile-avatar-placeholder" aria-hidden="true">
						{user.displayName.charAt(0).toUpperCase()}
					</div>
				)
			}
			<div class="profile-info">
				<div class="profile-top-row">
					<h1 class="profile-name">{user.displayName}</h1>
					<div class="profile-actions">
						<FollowButton
							username={user.username}
							initialFollowing={isFollowing}
							isSelf={isSelf}
						/>
					</div>
				</div>
				<p class="profile-username">@{user.username}</p>
				{user.bio && <p class="profile-bio">{user.bio}</p>}
				<div class="profile-stats">
					<span class="profile-stat">
						<span class="profile-stat-value">{postCount}</span>
						<span class="profile-stat-label">条动态</span>
					</span>
					<a href="/followers" class="profile-stat profile-stat-link">
						<span class="profile-stat-value">{followerCount}</span>
						<span class="profile-stat-label">粉丝</span>
					</a>
					<span class="profile-stat">
						<span class="profile-stat-value">{followingCount}</span>
						<span class="profile-stat-label">关注</span>
					</span>
				</div>
			</div>
		</div>
	</div>

	<!-- 搜索框 -->
	<form class="search-form" action={`/${user.username}`} method="get">
		<input
			type="text"
			name="q"
			class="form-input search-input"
			placeholder="搜索帖子..."
			value={Astro.url.searchParams.get('q') || ''}
		/>
		<input type="hidden" name="sort" value={sort} />
		<input type="hidden" name="mode" value={modeFilter} />
		<button type="submit" class="btn btn-primary search-btn">搜索</button>
	</form>

	<!-- 模式过滤 tab -->
	<div class="mode-tabs">
		<a
			href={`/${user.username}?mode=all&sort=${sort}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'all' }]}
		>
			全部
		</a>
		<a
			href={`/${user.username}?mode=weibo&sort=${sort}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'weibo' }]}
		>
			微博
		</a>
		<a
			href={`/${user.username}?mode=forum&sort=${sort}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'forum' }]}
		>
			论坛
		</a>
		<a
			href={`/${user.username}?mode=blog&sort=${sort}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'blog' }]}
		>
			博客
		</a>
	</div>

	<!-- 排序选项 -->
	<div class="sort-tabs">
		<a
			href={`/${user.username}?sort=latest&mode=${modeFilter}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['sort-tab', { 'sort-tab-active': sort === 'latest' }]}
		>
			最新
		</a>
		<a
			href={`/${user.username}?sort=popular&mode=${modeFilter}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['sort-tab', { 'sort-tab-active': sort === 'popular' }]}
		>
			热门
		</a>
		<a
			href={`/${user.username}?sort=oldest&mode=${modeFilter}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
			class:list={['sort-tab', { 'sort-tab-active': sort === 'oldest' }]}
		>
			最早
		</a>
	</div>

	{
		posts.length === 0 ? (
			<div class="empty-state">
				<p>{searchQuery ? '没有找到匹配的帖子' : '该用户还没有发布任何动态'}</p>
			</div>
		) : (
			<div class="post-list">
				{posts.map(async (post) => {
					// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
					const postLiked = likedPostIds.has(post.id);
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					// 提取标签列表
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{ isFollower: isFollowing, isFollowing: isFollowedByUser }
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}
</BaseLayout>

<style>
	.profile-banner {
		background: color-mix(in srgb, var(--color-primary) 8%, var(--color-bg));
		border-radius: var(--radius-lg);
		margin-bottom: var(--spacing-6);
		padding: var(--spacing-6);
		position: relative;
	}

	.profile-header {
		display: flex;
		gap: var(--spacing-5);
		align-items: flex-start;
	}

	.profile-avatar-img,
	.profile-avatar-placeholder {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.profile-avatar-img {
		border: 3px solid var(--color-card-bg);
	}

	.profile-avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		color: #fff;
		font-size: 2rem;
		font-weight: 600;
		border: 3px solid var(--color-card-bg);
	}

	.profile-info {
		min-width: 0;
		flex: 1;
		padding-bottom: var(--spacing-1);
	}

	.profile-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
	}

	.profile-name {
		font-size: 1.375rem;
		font-weight: 700;
		margin: 0;
	}

	.profile-username {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: var(--spacing-1) 0 var(--spacing-3);
	}

	.profile-bio {
		font-size: 0.9375rem;
		margin-bottom: var(--spacing-3);
		word-break: break-word;
		line-height: 1.6;
	}

	.profile-stats {
		display: flex;
		gap: var(--spacing-5);
	}

	.profile-stat {
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.profile-stat-value {
		font-weight: 700;
		font-size: 1.0625rem;
	}

	.profile-stat-label {
		color: var(--color-muted);
		font-size: 0.8125rem;
		margin-left: 0.25rem;
	}

	.profile-stat-link {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.profile-stat-link:hover {
		color: var(--color-primary);
	}

	.profile-actions {
		flex-shrink: 0;
	}

	/* 排序选项卡 */
	.sort-tabs {
		display: flex;
		gap: 0;
		margin-bottom: var(--spacing-4);
		border-bottom: 2px solid var(--color-border);
	}

	/* 模式过滤 tab */
	.mode-tabs {
		display: flex;
		gap: 0;
		margin-bottom: var(--spacing-3);
		border-bottom: 2px solid var(--color-border);
	}

	.mode-tab {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: 0.875rem;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -2px;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.mode-tab:hover {
		color: var(--color-text);
	}

	.mode-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
		font-weight: 600;
	}

	.sort-tab {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: 0.875rem;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -2px;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.sort-tab:hover {
		color: var(--color-text);
	}

	.sort-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
		font-weight: 600;
	}

	@media (max-width: 640px) {
		.profile-banner {
			padding: var(--spacing-4);
			margin-left: calc(-1 * var(--spacing-3));
			margin-right: calc(-1 * var(--spacing-3));
			border-radius: 0;
		}

		.profile-header {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.profile-avatar-img,
		.profile-avatar-placeholder {
			width: 72px;
			height: 72px;
		}

		.profile-top-row {
			flex-direction: column;
			align-items: center;
		}

		.profile-stats {
			justify-content: center;
		}
	}
</style>
