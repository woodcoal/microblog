---
/**
 * 用户主页
 *
 * 展示用户资料（头像、昵称、简介、发帖数、粉丝数、关注数）
 * 以及按内容模块切换的帖子列表（置顶帖优先，未删除）。
 * 包含 FollowButton。
 */
import UserLayout from '@/layouts/UserLayout.astro';
import PostCard from '@/components/PostCard.astro';
import FollowButton from '@/components/FollowButton.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { getPopularTagItems } from '@/lib/discovery';
import { SITE_URL, SITE_TITLE, getModeLabel } from '@/lib/config';

// 路由参数
const { username } = Astro.params;

// 查询用户信息
const user = await prisma.user.findUnique({
	where: { username },
	select: {
		id: true,
		username: true,
		displayName: true,
		avatarUrl: true,
		bio: true,
		createdAt: true
	}
});

// 用户不存在则 404
if (!user) {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 判断是否是自己
const isSelf = currentUser?.userId === user.id;

// 查询当前用户是否已关注该用户
let isFollowing = false;
if (currentUser && !isSelf) {
	const followRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: currentUser.userId,
				followingId: user.id
			}
		}
	});
	isFollowing = !!followRecord;
}

// 统计发帖数（未删除）
const postCount = await prisma.post.count({
	where: {
		userId: user.id,
		isDeleted: false
	}
});

// 统计粉丝数
const followerCount = await prisma.follow.count({
	where: { followingId: user.id }
});

// 统计关注数
const followingCount = await prisma.follow.count({
	where: { followerId: user.id }
});

// 个人主页只展示一个内容模块，避免将微博、讨论与文章混为综合流。
const modeParam = Astro.url.searchParams.get('mode') || 'weibo';
const validModes = ['weibo', 'forum', 'blog'];
const modeFilter = validModes.includes(modeParam) ? modeParam : 'weibo';
const orderBy: Record<string, unknown>[] = [{ isPinned: 'desc' }, { createdAt: 'desc' }];

// 获取用户的帖子列表：置顶优先，然后按时间倒序
// 根据当前用户身份过滤可见度
const followingIds: string[] = [];
const followerIds: string[] = [];

// 如果不是自己，查询关注关系用于可见度过滤
let isFollowedByUser = false;
if (currentUser && !isSelf) {
	// 当前用户是否关注了该用户（当前用户是该用户的粉丝）
	if (isFollowing) {
		followerIds.push(user.id);
	}
	// 该用户是否关注了当前用户（当前用户在该用户的关注列表中）
	const followBackRecord = await prisma.follow.findUnique({
		where: {
			followerId_followingId: {
				followerId: user.id,
				followingId: currentUser.userId
			}
		}
	});
	isFollowedByUser = !!followBackRecord;
	if (isFollowedByUser) {
		followingIds.push(user.id);
	}
}

// 生成可见度过滤条件
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 构建帖子查询条件
const postWhere: Record<string, unknown> = {
	userId: user.id,
	isDeleted: false,
	...visibilityFilter
};

// 每次只读取当前内容模块，个人主页不提供综合结果。
postWhere.mode = modeFilter;

const posts = await prisma.post.findMany({
	where: postWhere,
	orderBy,
	include: {
		user: {
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true
			}
		},
		tags: {
			include: {
				tag: {
					select: {
						id: true,
						name: true
					}
				}
			}
		},
		media: {
			include: {
				fileStorage: {
					select: {
						id: true,
						filePath: true,
						fileSize: true,
						mimeType: true,
						fileType: true
					}
				}
			}
		},
		category: {
			select: {
				id: true,
				name: true,
				slug: true,
				mode: true
			}
		},
		_count: {
			select: { likes: true, comments: true, bookmarks: true }
		}
	},
	take: 20
});

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);

const [recentFollows, recommendedTags] = await Promise.all([
	prisma.follow.findMany({
		where: { followerId: user.id },
		orderBy: { createdAt: 'desc' },
		take: 3,
		include: {
			following: { select: { username: true, displayName: true } }
		}
	}),
	getPopularTagItems({ limit: 3 })
]);
---

<UserLayout
	wide
	title={user.displayName}
	ogTitle={`${user.displayName} (@${user.username}) - ${SITE_TITLE}`}
	ogDescription={user.bio || `${user.displayName} 的${getModeLabel('weibo')}主页`}
	ogImage={user.avatarUrl || undefined}
	canonicalUrl={`${SITE_URL}/${user.username}`}
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		name: user.displayName,
		alternateName: user.username,
		url: `${SITE_URL}/${user.username}`,
		image: user.avatarUrl,
		description: user.bio
	}}
>
	<div class="profile-page-layout">
		<main class="profile-main">
			<div class="profile-banner">
				<div class="profile-cover" aria-hidden="true"></div>
				<div class="profile-header">
					{
						user.avatarUrl ? (
							<img
								src={user.avatarUrl}
								alt={`${user.displayName} 的头像`}
								class="profile-avatar-img"
								loading="lazy"
							/>
						) : (
							<div class="profile-avatar-placeholder" aria-hidden="true">
								{user.displayName.charAt(0).toUpperCase()}
							</div>
						)
					}
					<div class="profile-info">
						<div class="profile-top-row">
							<div>
								<h1 class="profile-name">{user.displayName}</h1>
								<p class="profile-username">@{user.username}</p>
							</div>
							<div class="profile-actions">
								{
									isSelf ? (
										<a href="/settings" class="btn btn-outline">
											编辑资料
										</a>
									) : (
										<FollowButton
											username={user.username}
											initialFollowing={isFollowing}
											isSelf={isSelf}
										/>
									)
								}
							</div>
						</div>
						{user.bio && <p class="profile-bio">{user.bio}</p>}
						<div class="profile-stats" aria-label="资料统计">
							{
								isSelf ? (
									<a href="/following" class="profile-stat profile-stat-link">
										<span class="profile-stat-value">{followingCount}</span>
										<span class="profile-stat-label">关注</span>
									</a>
								) : (
									<span class="profile-stat">
										<span class="profile-stat-value">{followingCount}</span>
										<span class="profile-stat-label">关注</span>
									</span>
								)
							}
							{
								isSelf ? (
									<a href="/followers" class="profile-stat profile-stat-link">
										<span class="profile-stat-value">{followerCount}</span>
										<span class="profile-stat-label">粉丝</span>
									</a>
								) : (
									<span class="profile-stat">
										<span class="profile-stat-value">{followerCount}</span>
										<span class="profile-stat-label">粉丝</span>
									</span>
								)
							}
							<span class="profile-stat">
								<span class="profile-stat-value">{postCount}</span>
								<span class="profile-stat-label">内容</span>
							</span>
						</div>
					</div>
				</div>
			</div>

			<nav class="mode-tabs" aria-label="内容模块">
				<a
					href={`/${user.username}?mode=weibo`}
					class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'weibo' }]}
				>
					动态
				</a>
				<a
					href={`/${user.username}?mode=blog`}
					class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'blog' }]}
				>
					文章
				</a>
				<a
					href={`/${user.username}?mode=forum`}
					class:list={['mode-tab', { 'mode-tab-active': modeFilter === 'forum' }]}
				>
					讨论
				</a>
				{
					isSelf && (
						<a href="/bookmarks" class="mode-tab">
							收藏
						</a>
					)
				}
			</nav>

			{
				posts.length === 0 ? (
					<div class="empty-state">
						<p>该用户还没有发布{getModeLabel(modeFilter)}内容</p>
					</div>
				) : (
					<div class="post-list">
						{posts.map(async (post) => {
							// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
							const postLiked = likedPostIds.has(post.id);
							const postBookmarked = bookmarkedPostIds.has(post.id);
							const postLikeCount = post._count.likes;
							const postCommentCount = post._count.comments;
							// 提取标签列表
							const postTags = post.tags.map((pt) => ({
								id: pt.tag.id,
								name: pt.tag.name
							}));
							// 检查当前用户是否有权查看帖子内容
							const isPostRestricted = !(await checkPostVisibility(
								{
									visibility: post.visibility,
									userId: post.userId,
									passwordHash: post.passwordHash,
									allowedUserIds: post.allowedUserIds
								},
								currentUser ? { userId: currentUser.userId } : null,
								{ isFollower: isFollowing, isFollowing: isFollowedByUser }
							));

							return (
								<PostCard
									post={{
										id: post.id,
										content: post.content,
										createdAt: post.createdAt.toISOString(),
										isPinned: post.isPinned,
										isGlobalPinned: post.isGlobalPinned,
										user: {
											id: post.user.id,
											username: post.user.username,
											displayName: post.user.displayName,
											avatarUrl: post.user.avatarUrl
										},
										media: post.media,
										visibility: post.visibility,
										mode: post.mode,
										title: post.title,
										categoryId: post.categoryId,
										category: post.category
									}}
									htmlContent={renderMarkdown(post.content)}
									likeCount={postLikeCount}
									liked={postLiked}
									commentCount={postCommentCount}
									bookmarkCount={post._count.bookmarks}
									bookmarked={postBookmarked}
									showFollow={!!currentUser}
									following={followingIds.includes(post.user.id)}
									isSelf={currentUser?.userId === post.user.id}
									tags={postTags}
									isRestricted={isPostRestricted}
								/>
							);
						})}
					</div>
				)
			}
		</main>

		<aside class="profile-rail" aria-label="个人主页辅助信息">
			<section class="profile-rail-card">
				<h2>个人菜单</h2>
				<a href={`/${user.username}`} aria-current="page">我的主页</a>
				{currentUser && <a href="/bookmarks">收藏内容</a>}
				{currentUser && <a href="/following">关注与粉丝</a>}
				{isSelf && <a href="/settings">账户设置</a>}
			</section>

			<section class="profile-rail-card">
				<h2>最近关注</h2>
				{
					recentFollows.length > 0 ? (
						recentFollows.map((follow) => (
							<a href={`/${follow.following.username}`}>
								{follow.following.displayName}
							</a>
						))
					) : (
						<p class="profile-rail-empty">暂未关注其他用户</p>
					)
				}
			</section>

			<section class="profile-rail-card">
				<h2>推荐话题</h2>
				{
					recommendedTags.length > 0 ? (
						recommendedTags.map((tag) => (
							<a href={tag.href}>
								<span>{tag.title}</span>
								{tag.meta && <small>{tag.meta}</small>}
							</a>
						))
					) : (
						<p class="profile-rail-empty">暂无推荐话题</p>
					)
				}
			</section>
		</aside>
	</div>
</UserLayout>

<style>
	.profile-page-layout {
		display: grid;
		grid-template-columns: minmax(0, 720px) 260px;
		gap: 32px;
		max-width: 1120px;
		margin: 0 auto;
		justify-content: center;
	}

	.profile-main {
		min-width: 0;
	}

	.profile-banner {
		background: var(--color-card-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		margin-bottom: var(--spacing-6);
		overflow: hidden;
		padding: 0 var(--spacing-6) var(--spacing-6);
		position: relative;
	}

	.profile-cover {
		height: 156px;
		margin: 0 calc(-1 * var(--spacing-6));
		background:
			linear-gradient(
				120deg,
				color-mix(in srgb, var(--color-primary) 22%, transparent),
				transparent 58%
			),
			var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.profile-header {
		margin-top: -44px;
	}

	.profile-avatar-img,
	.profile-avatar-placeholder {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.profile-avatar-img {
		display: block;
		border: 4px solid var(--color-card-bg);
	}

	.profile-avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-size: 2rem;
		font-weight: 600;
		border: 4px solid var(--color-card-bg);
	}

	.profile-info {
		min-width: 0;
		padding-top: 32px;
	}

	.profile-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
	}

	.profile-name {
		font-size: 1.375rem;
		font-weight: 700;
		margin: 0;
	}

	.profile-username {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: var(--spacing-1) 0 0;
	}

	.profile-bio {
		font-size: 0.9375rem;
		margin-bottom: var(--spacing-3);
		word-break: break-word;
		line-height: 1.6;
	}

	.profile-stats {
		display: flex;
		gap: var(--spacing-5);
	}

	.profile-stat {
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.profile-stat-value {
		font-weight: 700;
		font-size: 1.0625rem;
	}

	.profile-stat-label {
		color: var(--color-muted);
		font-size: 0.8125rem;
		margin-left: 0.25rem;
	}

	.profile-stat-link {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.profile-stat-link:hover {
		color: var(--color-primary);
	}

	.profile-actions {
		flex-shrink: 0;
	}

	.profile-rail-card {
		padding: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: var(--color-card-bg);
	}

	.profile-rail-card + .profile-rail-card {
		margin-top: var(--spacing-3);
	}

	.profile-rail-card h2 {
		margin: 0 0 var(--spacing-2);
		font-size: 0.875rem;
		font-weight: 700;
	}

	.profile-rail-card a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-2);
		padding: 10px 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text);
		font-size: 0.875rem;
		text-decoration: none;
	}

	.profile-rail-card a:hover,
	.profile-rail-card a[aria-current='page'] {
		color: var(--color-primary);
	}

	.profile-rail-card small,
	.profile-rail-empty {
		color: var(--color-muted);
		font-size: 0.75rem;
	}

	.profile-rail-empty {
		margin: 0;
		padding: 10px 0 0;
		border-top: 1px solid var(--color-border);
	}

	/* 内容模块导航 */
	.mode-tabs {
		display: flex;
		gap: var(--spacing-1);
		margin-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border);
	}

	.mode-tab {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: 0.875rem;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.mode-tab:hover {
		color: var(--color-text);
	}

	.mode-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
		font-weight: 600;
	}

	@media (max-width: 767px) {
		.profile-page-layout {
			display: block;
		}

		.profile-rail {
			display: none;
		}

		.profile-banner {
			padding: 0 var(--spacing-4) var(--spacing-4);
			margin-left: calc(-1 * var(--spacing-3));
			margin-right: calc(-1 * var(--spacing-3));
			border-radius: 0;
		}

		.profile-cover {
			height: 7.5rem;
			margin: 0 calc(-1 * var(--spacing-4));
		}

		.profile-header {
			text-align: center;
		}

		.profile-avatar-img,
		.profile-avatar-placeholder {
			width: 72px;
			height: 72px;
		}

		.profile-top-row {
			align-items: flex-start;
		}

		.profile-stats {
			justify-content: center;
		}
	}
</style>
