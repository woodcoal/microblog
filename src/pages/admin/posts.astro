---
/**
 * 管理后台 - 帖子管理页面
 *
 * 功能：
 * - 帖子列表（表格形式，含已删除帖子）
 * - 搜索框：按内容搜索
 * - 操作按钮：删除、恢复、全局置顶/取消、锁定/解锁
 * - 管理员操作弹窗：删除/恢复/锁定需填写理由
 * - 分页
 */
import AdminLayout from '@/layouts/Admin.astro';
import { prisma } from '@/lib/db';
import AdminPostList from '@/components/admin/AdminPostList.astro';
import type { Prisma } from '../../../generated/prisma/client';

// 分页参数
const page = Math.max(Number(Astro.url.searchParams.get('page')) || 1, 1);
const limit = 20;
const search = Astro.url.searchParams.get('search') || '';
const mode = Astro.url.searchParams.get('mode') || '';
const username = Astro.url.searchParams.get('username') || '';
const startDate = Astro.url.searchParams.get('startDate') || '';
const endDate = Astro.url.searchParams.get('endDate') || '';
const status = Astro.url.searchParams.get('status') || '';
const skip = (page - 1) * limit;

// 构建查询条件（管理后台包含已删除帖子）
const where: Prisma.PostWhereInput = {};
if (search) where.content = { contains: search };
if (['weibo', 'forum', 'blog'].includes(mode)) where.mode = mode;
if (username) where.user = { username: { contains: username } };
if (startDate || endDate) {
	const createdAt: Prisma.DateTimeFilter = {};
	if (startDate) {
		const start = new Date(`${startDate}T00:00:00`);
		if (!Number.isNaN(start.getTime())) createdAt.gte = start;
	}
	if (endDate) {
		const end = new Date(`${endDate}T23:59:59.999`);
		if (!Number.isNaN(end.getTime())) createdAt.lte = end;
	}
	if (Object.keys(createdAt).length > 0) where.createdAt = createdAt;
}
if (status === 'active') {
	where.isDeleted = false;
	where.isLocked = false;
	where.isGlobalPinned = false;
} else if (status === 'deleted') {
	where.isDeleted = true;
} else if (status === 'locked') {
	where.isLocked = true;
} else if (status === 'pinned') {
	where.isGlobalPinned = true;
}

// 并行查询
const [posts, total] = await Promise.all([
	prisma.post.findMany({
		where,
		select: {
			id: true,
			content: true,
			visibility: true,
			isPinned: true,
			isGlobalPinned: true,
			isLocked: true,
			lockReason: true,
			isDeleted: true,
			deleteReason: true,
			isEdited: true,
			mode: true,
			title: true,
			createdAt: true,
			user: {
				select: {
					id: true,
					username: true,
					displayName: true
				}
			}
		},
		orderBy: { createdAt: 'desc' },
		skip,
		take: limit
	}),
	prisma.post.count({ where })
]);

// 计算分页信息
const totalPages = Math.ceil(total / limit);
const hasPrev = page > 1;
const hasNext = page < totalPages;

// 序列化日期
const serializedPosts = posts.map((p) => ({
	...p,
	createdAt: p.createdAt.toISOString()
}));
---

<AdminLayout title="帖子管理">
	<section class="admin-page-workspace" aria-labelledby="admin-posts-title">
		<header class="admin-page-heading">
			<p class="admin-page-eyebrow">内容工作区</p>
			<h1 class="admin-page-title" id="admin-posts-title">帖子管理</h1>
			<p>检索、筛选并维护社区内的全部内容。</p>
		</header>

		<AdminPostList
			posts={serializedPosts}
			total={total}
			page={page}
			totalPages={totalPages}
			hasPrev={hasPrev}
			hasNext={hasNext}
			search={search}
			mode={mode}
			username={username}
			startDate={startDate}
			endDate={endDate}
			status={status}
		/>
	</section>
</AdminLayout>
