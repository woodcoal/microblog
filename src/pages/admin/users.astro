---
/**
 * 管理后台 - 用户管理页面
 *
 * 功能：
 * - 用户列表（表格形式）
 * - 搜索框：按用户名/邮箱搜索
 * - 禁用/启用按钮
 * - 分页
 */
import AdminLayout from '@/layouts/Admin.astro';
import { getUserFromRequest } from '@/lib/auth';
import { prisma } from '@/lib/db';
import AdminUserList from '@/components/admin/AdminUserList.astro';
import { readSystemConfiguration } from '@/services/system-config.service';

// 分页参数
const page = Math.max(Number(Astro.url.searchParams.get('page')) || 1, 1);
const limit = 20;
const search = Astro.url.searchParams.get('search') || '';
const skip = (page - 1) * limit;

// 构建查询条件
const where = search
	? {
			OR: [{ username: { contains: search } }, { email: { contains: search } }]
		}
	: {};

// 并行查询
const currentUser = await getUserFromRequest(Astro);
if (!currentUser) return Astro.redirect('/login');
if (currentUser.role !== 'admin')
	return new Response('Forbidden: 无权访问管理后台', { status: 403 });

const [users, total, systemConfiguration] = await Promise.all([
	prisma.user.findMany({
		where,
		select: {
			id: true,
			username: true,
			displayName: true,
			email: true,
			role: true,
			isDisabled: true,
			createdAt: true,
			emailVerifiedAt: true,
			lastLoginAt: true,
			lastActiveAt: true,
			loginCount: true
		},
		orderBy: { createdAt: 'desc' },
		skip,
		take: limit
	}),
	prisma.user.count({ where }),
	readSystemConfiguration(currentUser.userId)
]);

// 计算总页数
const totalPages = Math.ceil(total / limit);
const hasPrev = page > 1;
const hasNext = page < totalPages;

// 序列化日期为字符串
const serializedUsers = users.map((u) => ({
	...u,
	createdAt: u.createdAt.toISOString(),
	emailVerifiedAt: u.emailVerifiedAt?.toISOString() ?? null,
	lastLoginAt: u.lastLoginAt?.toISOString() ?? null,
	lastActiveAt: u.lastActiveAt?.toISOString() ?? null
}));
---

<AdminLayout title="用户管理">
	<section class="admin-page-workspace" aria-labelledby="admin-users-title">
		<header class="admin-page-heading">
			<p class="admin-page-eyebrow">成员工作区</p>
			<h1 class="admin-page-title" id="admin-users-title">用户管理</h1>
			<p>查看社区成员状态，并在需要时执行管理操作。</p>
		</header>

		<AdminUserList
			users={serializedUsers}
			total={total}
			page={page}
			totalPages={totalPages}
			hasPrev={hasPrev}
			hasNext={hasNext}
			search={search}
			emailOwnershipEnabled={systemConfiguration.emailOwnershipEnabled}
		/>
	</section>
</AdminLayout>
