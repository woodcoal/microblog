---
/**
 * 博客分类详情页
 *
 * 根据 slug 显示该分类下的文章列表。
 * 支持分页浏览，保留分类筛选上下文。
 */
import BlogLayout from '@/layouts/BlogLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown, renderFullMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled } from '@/lib/config';

// 模式未启用时返回 404
if (!isModeEnabled('blog')) {
	return Astro.redirect('/404');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 从 URL 获取分类 slug
const { slug } = Astro.params;

// 查询当前分类
const category = await prisma.category.findUnique({
	where: { slug },
	include: {
		parent: {
			select: { id: true, name: true, slug: true }
		}
	}
});

// 分类不存在或不是 blog 模式时返回 404
if (!category || category.mode !== 'blog') {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 从 URL 查询参数获取当前页码
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询该分类下的文章总数
const totalPosts = await prisma.post.count({
	where: {
		isDeleted: false,
		mode: 'blog',
		categoryId: category.id,
		...visibilityFilter
	}
});

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const skip = (safePage - 1) * PAGE_SIZE;

// 查询当前页的文章
const posts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		mode: 'blog',
		categoryId: category.id,
		...visibilityFilter
	},
	orderBy: [{ createdAt: 'desc' }],
	include: {
		...POST_CARD_INCLUDE
	},
	skip,
	take: PAGE_SIZE
});

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const hasIcon = !!category.icon;
---

<BlogLayout title={`${category.name} - 博客`}>
	<div class="page-header">
		<nav class="breadcrumb" aria-label="面包屑导航">
			<a href="/blog" class="breadcrumb-link">博客</a>
			<span class="breadcrumb-sep">/</span>
			<span class="breadcrumb-current">{category.name}</span>
		</nav>
		<h1 class="page-title">
			{hasIcon && <span class="page-title-icon">{category.icon}</span>}
			{category.name}
		</h1>
		{category.description && <p class="page-desc">{category.description}</p>}
	</div>

	{
		!hasPosts ? (
			<div class="empty-state">
				<p>该分类暂无文章</p>
			</div>
		) : (
			<div class="post-list">
				{posts.map(async (post) => {
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postLiked = likedPostIds.has(post.id);

					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderFullMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a
							href={`/blog/${slug}?page=${safePage - 1}`}
							class="pagination-btn pagination-prev"
						>
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a
							href={`/blog/${slug}?page=${safePage + 1}`}
							class="pagination-btn pagination-next"
						>
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</BlogLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	.page-title-icon {
		font-size: 1.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 面包屑导航 */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--spacing-1);
		font-size: 0.8125rem;
		margin-bottom: var(--spacing-2);
		color: var(--color-muted);
	}

	.breadcrumb-link {
		color: var(--color-primary);
		text-decoration: none;
	}

	.breadcrumb-link:hover {
		text-decoration: underline;
	}

	.breadcrumb-sep {
		color: var(--color-muted);
	}

	.breadcrumb-current {
		color: var(--color-text);
		font-weight: 500;
	}
</style>
