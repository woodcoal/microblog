---
/**
 * 博客写文章页面（Word 文档风格）
 *
 * 整个页面模拟 Word/Google Docs 的文档编辑体验：
 * - 白色文档页居中，有轻微阴影
 * - 第一行是标题输入区（大号字体，融入文档页）
 * - 下方是 Tiptap 富文本编辑器
 * - 分类和可见度选择放在顶部轻量工具栏
 * - BlogEditor 通过自定义事件 blog-editor-submit 传出 markdown 内容
 *
 * 需要登录认证，未登录重定向到登录页。
 */
import BlogLayout from '@/layouts/BlogLayout.astro';
import BlogEditor from '@/components/BlogEditor';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { isModeEnabled, POST_CONTENT_MAX_LENGTH, getModeLabel } from '@/lib/config';

// 模式未启用时返回 404
if (!isModeEnabled('blog')) {
	return Astro.redirect('/404');
}

// 需要认证，未登录重定向
const currentUser = await getUserFromRequest(Astro);
if (!currentUser) {
	const loginUrl = new URL('/login', Astro.url);
	loginUrl.searchParams.set('redirect', Astro.url.pathname);
	return Astro.redirect(loginUrl.toString());
}

// 查询博客分类列表
const categories = await prisma.category.findMany({
	where: { mode: 'blog' },
	orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }]
});

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasCategories = categories.length > 0;
---

<BlogLayout title={`写文章 - ${getModeLabel('blog')}`}>
	<section
		class="blog-write-page ux-editor-page"
		id="blog-compose-container"
		aria-labelledby="blog-write-title"
	>
		<header class="ux-page-heading">
			<p class="ux-eyebrow">写作工作区</p>
			<h1 id="blog-write-title">写一篇文章</h1>
			<p>先整理观点，再以适合阅读的节奏发布。</p>
		</header>
		{/* 顶部轻量工具栏：分类 + 可见度 + 操作按钮 */}
		<div class="blog-write-toolbar">
			<div class="blog-write-toolbar-left">
				{
					hasCategories && (
						<select
							class="form-input blog-write-select"
							id="blog-compose-category"
							aria-label="文章分类"
						>
							<option value="">选择分类（可选）</option>
							{categories.map((cat) => (
								<option value={cat.id}>
									{cat.icon && `${cat.icon} `}
									{cat.name}
								</option>
							))}
						</select>
					)
				}
				<input
					type="text"
					class="form-input blog-write-select"
					id="blog-compose-custom-category"
					placeholder="自定义分类（可选）"
					maxlength="50"
					aria-label="自定义分类"
				/>
				<select
					class="form-input blog-write-select"
					id="blog-compose-visibility"
					aria-label="文章可见度"
				>
					<option value="public">🌐 公开</option>
					<option value="logged_in">🔐 登录用户可见</option>
					<option value="followers">👥 粉丝可见</option>
					<option value="following">🤝 我关注的人可见</option>
					<option value="private">🔒 仅自己可见</option>
				</select>
			</div>
			<div class="blog-write-toolbar-right">
				<a href="/blog" class="btn blog-write-cancel-btn">取消</a>
				<button class="btn btn-primary blog-write-publish-btn" id="blog-compose-publish">
					发布文章
				</button>
			</div>
		</div>

		{/* 文档页：白色背景，居中，有阴影 */}
		<div class="blog-write-doc" data-max-length={POST_CONTENT_MAX_LENGTH}>
			{/* 标题输入区：大号字体，融入文档页 */}
			<input
				type="text"
				class="blog-write-title"
				id="blog-compose-title"
				placeholder="文章标题"
				maxlength="200"
				aria-label="文章标题"
				aria-describedby="blog-form-error"
			/>
			{/* 内容编辑区 */}
			<BlogEditor client:load />
		</div>

		<p
			class="form-error"
			id="blog-form-error"
			role="alert"
			aria-live="assertive"
			style="display:none"
		>
		</p>
	</section>
</BlogLayout>

<!-- blog-editor-a 的布局由 src/styles/ux-pages.css 统一提供；编辑页复用同一组类名。 -->

<script>
	/**
	 * 博客写文章页面客户端脚本
	 *
	 * 处理博客文章的发布功能：
	 * - 标题从独立 input 获取
	 * - 内容从 BlogEditor 的 blog-editor-submit 事件获取
	 * - 表单提交调用 actions.createPost（mode=blog）
	 * - 发布成功后跳转到文章详情页
	 * - 草稿自动保存/恢复（localStorage，1 秒防抖）
	 */
	import { actions } from 'astro:actions';

	/** 草稿存储键 */
	const BLOG_DRAFT_KEY = 'blog-draft';

	const container = document.getElementById('blog-compose-container');
	if (container) {
		const titleInput = container.querySelector('#blog-compose-title') as HTMLInputElement;
		const categorySelect = container.querySelector(
			'#blog-compose-category'
		) as HTMLSelectElement | null;
		const customCategoryInput = container.querySelector(
			'#blog-compose-custom-category'
		) as HTMLInputElement | null;
		const visibilitySelect = container.querySelector(
			'#blog-compose-visibility'
		) as HTMLSelectElement;
		const formError = container.querySelector('#blog-form-error') as HTMLParagraphElement;
		const publishBtn = container.querySelector('#blog-compose-publish') as HTMLButtonElement;
		const CONTENT_MAX_LENGTH = parseInt(
			document.querySelector('.blog-write-doc')?.getAttribute('data-max-length') || '50000',
			10
		);

		/** 草稿自动保存定时器 */
		let draftTimer: ReturnType<typeof setTimeout> | null = null;

		/**
		 * 显示错误信息
		 *
		 * @param msg - 错误消息
		 */
		function showError(msg: string): void {
			formError.textContent = msg;
			formError.style.display = '';
		}

		// ===== 草稿功能 =====

		/**
		 * 保存草稿到 localStorage
		 *
		 * 保存标题、分类、可见度等信息
		 * （内容由 BlogEditor 管理，不在草稿中保存）
		 */
		function saveBlogDraft(): void {
			const data = {
				title: titleInput?.value || '',
				categoryId: categorySelect?.value || '',
				customCategory: customCategoryInput?.value || '',
				visibility: visibilitySelect?.value || 'public',
				savedAt: new Date().toISOString()
			};
			// 有标题时保存，否则清除
			if (data.title.trim()) {
				localStorage.setItem(BLOG_DRAFT_KEY, JSON.stringify(data));
			} else {
				localStorage.removeItem(BLOG_DRAFT_KEY);
			}
		}

		/**
		 * 防抖保存草稿
		 *
		 * 1 秒后执行保存，期间有新输入则重置计时器
		 */
		function saveBlogDraftDebounced(): void {
			if (draftTimer) clearTimeout(draftTimer);
			draftTimer = setTimeout(saveBlogDraft, 1000);
		}

		/**
		 * 恢复草稿内容
		 *
		 * 从 localStorage 读取草稿并填充到表单中
		 */
		function restoreBlogDraft(): void {
			try {
				const saved = localStorage.getItem(BLOG_DRAFT_KEY);
				if (!saved) return;
				const data = JSON.parse(saved);
				if (data.title && titleInput) titleInput.value = data.title;
				if (data.categoryId && categorySelect) categorySelect.value = data.categoryId;
				if (data.customCategory && customCategoryInput) {
					customCategoryInput.value = data.customCategory;
					if (categorySelect) categorySelect.value = '';
				}
				if (data.visibility && visibilitySelect) visibilitySelect.value = data.visibility;
			} catch {
				// 草稿解析失败，静默处理
			}
		}

		/**
		 * 清除博客草稿
		 */
		function clearBlogDraft(): void {
			if (draftTimer) {
				clearTimeout(draftTimer);
				draftTimer = null;
			}
			localStorage.removeItem(BLOG_DRAFT_KEY);
		}

		// 标题输入时保存草稿
		if (titleInput) {
			titleInput.addEventListener('input', saveBlogDraftDebounced);
		}
		// 分类选择时保存草稿
		if (categorySelect) {
			categorySelect.addEventListener('change', () => {
				if (categorySelect.value && customCategoryInput) customCategoryInput.value = '';
				saveBlogDraftDebounced();
			});
		}
		if (customCategoryInput) {
			customCategoryInput.addEventListener('input', () => {
				if (customCategoryInput.value.trim() && categorySelect) categorySelect.value = '';
				saveBlogDraftDebounced();
			});
		}
		// 可见度选择时保存草稿
		if (visibilitySelect) {
			visibilitySelect.addEventListener('change', saveBlogDraftDebounced);
		}

		// 挂载时恢复草稿
		restoreBlogDraft();

		/**
		 * 监听 BlogEditor 的提交事件
		 *
		 * BlogEditor 通过自定义事件 blog-editor-submit 传出 markdown 字符串。
		 * 标题从独立 input 获取。
		 */
		container.addEventListener('blog-editor-submit', async (e: Event) => {
			const customEvent = e as CustomEvent;
			const content = customEvent.detail as string;
			const title = titleInput.value.trim();
			const categoryId = categorySelect?.value || '';
			const customCategory = customCategoryInput?.value.trim() || '';

			if (!title) {
				showError('请输入文章标题');
				titleInput.focus();
				container.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				return;
			}
			if (!content || !content.trim()) {
				showError('请输入文章内容');
				container.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				return;
			}
			if (content.length > CONTENT_MAX_LENGTH) {
				showError(`内容不能超过 ${CONTENT_MAX_LENGTH} 个字符`);
				container.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				return;
			}

			formError.style.display = 'none';

			// 禁用发布按钮防止重复提交
			if (publishBtn) {
				publishBtn.disabled = true;
				publishBtn.textContent = '发布中...';
			}

			const actionInput: Parameters<typeof actions.createPost>[0] = {
				content,
				visibility: visibilitySelect.value,
				mode: 'blog',
				title
			};

			// 有分类时传入 categoryId
			if (categoryId) {
				actionInput.categoryId = categoryId;
			}
			if (customCategory) {
				actionInput.customCategory = customCategory;
			}

			const result = await actions.createPost(actionInput);

			if (result.error) {
				showError(result.error.message || '发布失败');
				container.dispatchEvent(new CustomEvent('blog-editor-submit-done'));
				if (publishBtn) {
					publishBtn.disabled = false;
					publishBtn.textContent = '发布文章';
				}
				return;
			}

			// 发布成功，清除草稿
			clearBlogDraft();
			container.dispatchEvent(new CustomEvent('blog-editor-clear-draft'));

			// 跳转到文章详情页
			const post = result.data;
			window.location.href = `/${post.user.username}/${post.id}`;
		});

		/**
		 * 点击顶部发布按钮时，通知编辑器触发提交
		 */
		if (publishBtn) {
			publishBtn.addEventListener('click', () => {
				// 通知 BlogEditor 触发提交
				container.dispatchEvent(new CustomEvent('blog-editor-do-submit'));
			});
		}
	}
</script>
