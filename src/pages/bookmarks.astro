---
/**
 * 收藏列表页
 *
 * 展示当前用户收藏的所有帖子列表，按收藏时间倒序排列。
 * 每个帖子卡片显示取消收藏按钮。
 * 需要认证，未登录重定向到登录页。
 */
import WeiboLayout from '@/layouts/WeiboLayout.astro';
import PostCard from '@/components/PostCard.astro';
import BookmarkButton from '@/components/BookmarkButton.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getLikedPostIds } from '@/lib/queries';
import { checkPostVisibility } from '@/lib/visibility';

// 需要认证，未登录重定向
const currentUser = await getUserFromRequest(Astro);
if (!currentUser) {
	return Astro.redirect('/login');
}

// 每页显示数量
const PAGE_SIZE = 20;

// 从 URL 参数获取分页游标（收藏记录的 createdAt）
const cursor = Astro.url.searchParams.get('cursor');

// 查询当前用户关注的人和粉丝，用于可见度过滤
const followingRecords = await prisma.follow.findMany({
	where: { followerId: currentUser.userId },
	select: { followingId: true }
});
const followingIds = followingRecords.map((f) => f.followingId);

const followerRecords = await prisma.follow.findMany({
	where: { followingId: currentUser.userId },
	select: { followerId: true }
});
const followerIds = followerRecords.map((f) => f.followerId);

// 查询当前用户收藏的帖子（通过 Bookmark 关联）
const bookmarks = await prisma.bookmark.findMany({
	where: { userId: currentUser.userId },
	orderBy: { createdAt: 'desc' },
	take: PAGE_SIZE + 1,
	...(cursor ? { cursor: { id: cursor }, skip: 1 } : {}),
	include: {
		post: {
			include: POST_CARD_INCLUDE
		}
	}
});

// 判断是否有下一页
const hasMore = bookmarks.length > PAGE_SIZE;
const items = hasMore ? bookmarks.slice(0, PAGE_SIZE) : bookmarks;

// 下一页游标
const nextCursor = hasMore ? items[items.length - 1].id : null;

// 过滤掉已删除的帖子
const validItems = items.filter((b) => !b.post.isDeleted);

// 提取帖子 ID 列表，用于批量查询点赞状态
const postIds = validItems.map((b) => b.post.id);

// 查询当前用户对这些帖子的点赞状态
const likedPostIds = await getLikedPostIds(currentUser.userId, postIds);

// 查询每个帖子的收藏数
const bookmarkCounts = await prisma.bookmark.groupBy({
	by: ['postId'],
	where: { postId: { in: postIds } },
	_count: { _all: true }
});
const bookmarkCountMap = new Map(bookmarkCounts.map((b) => [b.postId, b._count._all]));

// 是否有收藏
const hasBookmarks = validItems.length > 0;
---

<WeiboLayout title="我的收藏">
	<h1 class="page-title">我的收藏</h1>

	{
		!hasBookmarks ? (
			<div class="empty-state">
				<p>还没有收藏任何帖子</p>
			</div>
		) : (
			<div class="post-list">
				{validItems.map(async (bookmark) => {
					const post = bookmark.post;
					const postLiked = likedPostIds.has(post.id);
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postBookmarkCount = bookmarkCountMap.get(post.id) || 0;
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						{ userId: currentUser.userId },
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<div class="bookmark-post-item">
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: {
										id: post.user.id,
										username: post.user.username,
										displayName: post.user.displayName,
										avatarUrl: post.user.avatarUrl
									},
									media: post.media,
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={renderMarkdown(post.content)}
								likeCount={postLikeCount}
								liked={postLiked}
								commentCount={postCommentCount}
								tags={postTags}
								isRestricted={isPostRestricted}
							/>
							<div class="bookmark-post-actions">
								<BookmarkButton
									postId={post.id}
									initialBookmarked={true}
									initialBookmarkCount={postBookmarkCount}
								/>
							</div>
						</div>
					);
				})}
			</div>
		)
	}

	<!-- 分页 -->
	{
		hasMore && nextCursor && (
			<div class="pagination">
				<a href={`/bookmarks?cursor=${nextCursor}`} class="btn btn-outline">
					加载更多
				</a>
			</div>
		)
	}
</WeiboLayout>

<style>
	.page-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.bookmark-post-item {
		position: relative;
	}

	.bookmark-post-actions {
		display: flex;
		justify-content: flex-end;
		padding: 0 1rem 0.5rem;
		margin-top: -0.5rem;
	}

	.pagination {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}
</style>
