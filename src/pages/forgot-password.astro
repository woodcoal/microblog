---
/** 忘记密码页面。账户和限频判断仅由服务端 Action 处理。 */
import BaseLayout from '@/layouts/Base.astro';
import '@/styles/pages/forgot-password.css';
---

<BaseLayout title="找回密码" narrow noindex>
	<section class="auth-page password-reset-page" aria-labelledby="forgot-password-title">
		<h1 id="forgot-password-title" class="auth-title">找回密码</h1>
		<p class="auth-panel-lead">输入注册邮箱，我们会在可处理时发送重置链接。</p>

		<form id="forgot-password-form" class="auth-form" aria-describedby="forgot-password-status">
			<div class="form-group">
				<label for="email" class="form-label">邮箱</label>
				<input
					type="email"
					id="email"
					name="email"
					class="form-input"
					placeholder="your@email.com"
					required
					autocomplete="email"
				/>
			</div>
			<button type="submit" id="forgot-password-submit" class="btn btn-primary auth-submit">
				发送重置链接
			</button>
		</form>

		<section
			id="forgot-password-accepted"
			class="password-reset-state"
			role="status"
			hidden
			tabindex="-1"
		>
			<h2>请查看邮箱</h2>
			<p>若该邮箱可用，重置邮件已发送。请打开邮件中的链接设置新密码。</p>
			<p class="form-hint">未收到邮件时，请检查垃圾邮件箱，或稍后再次请求。</p>
		</section>
		<p id="forgot-password-status" class="form-error" role="alert" aria-live="assertive"></p>
		<p class="auth-footer"><a href="/login">返回登录</a> · <a href="/register">创建账号</a></p>
	</section>
</BaseLayout>

<script src="../scripts/pages/forgot-password.ts"></script>
