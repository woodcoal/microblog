---
/**
 * 论坛版块详情页
 *
 * 根据 slug 显示该版块下的帖子列表（forum 模式卡片）。
 * 顶部内嵌 ForumEditor 编辑器（Markdown 工具栏 + 实时预览）。
 * 发布时 mode 自动设为 'forum'，categoryId 自动设为当前版块。
 * 支持分页浏览。
 */
import BaseLayout from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import ForumEditor from '@/components/ForumEditor.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, POST_CONTENT_MAX_LENGTH } from '@/lib/config';

// 模式未启用时返回 404
if (!isModeEnabled('forum')) {
	return Astro.redirect('/404');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 从 URL 获取版块 slug
const { slug } = Astro.params;

// 查询当前版块
const category = await prisma.category.findUnique({
	where: { slug },
	include: {
		parent: {
			select: { id: true, name: true, slug: true }
		}
	}
});

// 版块不存在或不是 forum 模式时返回 404
if (!category || category.mode !== 'forum') {
	return Astro.redirect('/404');
}

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 从 URL 查询参数获取当前页码
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询该版块下的帖子总数
const totalPosts = await prisma.post.count({
	where: {
		isDeleted: false,
		mode: 'forum',
		categoryId: category.id,
		...visibilityFilter
	}
});

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const skip = (safePage - 1) * PAGE_SIZE;

// 查询当前页的帖子
const posts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		mode: 'forum',
		categoryId: category.id,
		...visibilityFilter
	},
	orderBy: [{ createdAt: 'desc' }],
	include: {
		...POST_CARD_INCLUDE
	},
	skip,
	take: PAGE_SIZE
});

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const hasParent = !!category.parent;
const hasIcon = !!category.icon;
---

<BaseLayout title={`${category.name} - 论坛`}>
	<div class="page-header">
		<nav class="breadcrumb" aria-label="面包屑导航">
			<a href="/forum" class="breadcrumb-link">论坛</a>
			{
				hasParent && (
					<>
						<span class="breadcrumb-sep">/</span>
						<span class="breadcrumb-text">{category.parent.name}</span>
					</>
				)
			}
			<span class="breadcrumb-sep">/</span>
			<span class="breadcrumb-current">{category.name}</span>
		</nav>
		<h1 class="page-title">
			{hasIcon && <span class="page-title-icon">{category.icon}</span>}
			{category.name}
		</h1>
		{category.description && <p class="page-desc">{category.description}</p>}
	</div>

	{/* 内嵌发布框（仅已登录用户显示） */}
	{
		currentUser && (
			<div class="channel-compose">
				<input
					type="text"
					class="form-input channel-compose-title"
					id="forum-compose-title"
					placeholder="帖子标题（必填）"
					maxlength="200"
				/>
				<ForumEditor
					formId="forum-compose-editor"
					maxLength={POST_CONTENT_MAX_LENGTH}
					categoryId={category.id}
					submitLabel="发布"
				/>
				<div class="channel-compose-footer">
					<div class="channel-compose-options">
						<select
							class="form-input channel-compose-visibility"
							id="forum-compose-visibility"
						>
							<option value="public">🌐 公开</option>
							<option value="logged_in">🔐 登录用户可见</option>
							<option value="followers">👥 粉丝可见</option>
							<option value="following">🤝 我关注的人可见</option>
							<option value="private">🔒 仅自己可见</option>
						</select>
					</div>
				</div>
				<p class="form-error" id="forum-form-error" style="display:none" />
			</div>
		)
	}

	{
		!hasPosts ? (
			<div class="empty-state">
				<p>该版块暂无帖子，来发第一条吧！</p>
			</div>
		) : (
			<div class="post-list">
				{posts.map(async (post) => {
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postLiked = likedPostIds.has(post.id);

					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a
							href={`/forum/${slug}?page=${safePage - 1}`}
							class="pagination-btn pagination-prev"
						>
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a
							href={`/forum/${slug}?page=${safePage + 1}`}
							class="pagination-btn pagination-next"
						>
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</BaseLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	.page-title-icon {
		font-size: 1.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 面包屑导航 */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--spacing-1);
		font-size: 0.8125rem;
		margin-bottom: var(--spacing-2);
		color: var(--color-muted);
	}

	.breadcrumb-link {
		color: var(--color-primary);
		text-decoration: none;
	}

	.breadcrumb-link:hover {
		text-decoration: underline;
	}

	.breadcrumb-sep {
		color: var(--color-muted);
	}

	.breadcrumb-text {
		color: var(--color-muted);
	}

	.breadcrumb-current {
		color: var(--color-text);
		font-weight: 500;
	}

	/* 频道内嵌发布框 */
	.channel-compose {
		margin-bottom: var(--spacing-6);
		padding: var(--spacing-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.channel-compose-title {
		margin-bottom: var(--spacing-3);
		font-weight: 500;
	}

	.channel-compose-textarea {
		min-height: 100px;
		resize: vertical;
	}

	.channel-compose-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: var(--spacing-3);
		gap: var(--spacing-3);
	}

	.channel-compose-options {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.channel-compose-visibility {
		width: auto;
		font-size: 0.8125rem;
		padding: 0.375rem 0.75rem;
	}

	.channel-compose-count {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
</style>

<script>
	/**
	 * 论坛版块内嵌发布框客户端脚本
	 *
	 * 处理论坛版块的快速发布功能：
	 * - 标题必填校验
	 * - 从 ForumEditor 获取内容
	 * - 表单提交调用 actions.createPost（mode=forum, categoryId=当前版块）
	 * - 发布成功后刷新页面
	 */
	import { actions } from 'astro:actions';

	// 获取 ForumEditor 实例和标题输入
	const editorEl = document.getElementById('forum-compose-editor');
	const titleInput = document.getElementById('forum-compose-title') as HTMLInputElement | null;
	const visibilitySelect = document.getElementById(
		'forum-compose-visibility'
	) as HTMLSelectElement | null;
	const formError = document.getElementById('forum-form-error') as HTMLParagraphElement | null;

	if (editorEl && titleInput && visibilitySelect && formError) {
		const categoryId = editorEl.dataset.categoryId || '';
		const CONTENT_MAX_LENGTH = parseInt(editorEl.dataset.maxLength || '1000', 10);
		let loading = false;

		/**
		 * 显示错误信息
		 *
		 * @param msg - 错误消息
		 */
		function showError(msg: string): void {
			formError!.textContent = msg;
			formError!.style.display = '';
		}

		/**
		 * 从 ForumEditor 获取内容并提交
		 */
		async function handleSubmit(): Promise<void> {
			if (loading) return;

			const title = titleInput!.value.trim();
			// 通过 ForumEditor 暴露的 getContent 方法获取内容
			const content = (editorEl as any).getContent?.() || '';

			if (!title) {
				showError('请输入帖子标题');
				return;
			}
			if (!content) {
				showError('请输入帖子内容');
				return;
			}
			if (content.length > CONTENT_MAX_LENGTH) {
				showError(`内容不能超过 ${CONTENT_MAX_LENGTH} 个字符`);
				return;
			}

			loading = true;
			formError!.style.display = 'none';

			try {
				const result = await actions.createPost({
					content,
					visibility: visibilitySelect!.value,
					mode: 'forum',
					title,
					categoryId
				});

				if (result.error) {
					showError(result.error.message || '发布失败');
					return;
				}

				// 发布成功，刷新页面
				window.location.reload();
			} catch {
				showError('网络错误，请稍后重试');
			} finally {
				loading = false;
			}
		}

		// 监听 ForumEditor 的提交按钮点击
		const submitBtn = editorEl.querySelector('.btn-primary') as HTMLButtonElement | null;
		if (submitBtn) {
			submitBtn.addEventListener('click', (e: Event) => {
				e.preventDefault();
				handleSubmit();
			});
		}
	}
</script>
