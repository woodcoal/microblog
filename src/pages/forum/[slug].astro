---
/**
 * 论坛版块详情页
 *
 * 根据 slug 显示该版块下的帖子列表（forum 模式卡片）。
 * 顶部"发帖"按钮打开论坛编辑器弹窗（预设当前版块分类）。
 * 发布时 mode 自动设为 'forum'，categoryId 自动设为当前版块。
 * 支持分页浏览。
 */
import ForumLayout from '@/layouts/ForumLayout.astro';
import PostCard from '@/components/PostCard.astro';
import ChannelAside from '@/components/ChannelAside.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderFullMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, getModeLabel } from '@/lib/config';
import type { Prisma } from '../../../generated/prisma/client';

// 模式未启用时返回 404
if (!isModeEnabled('forum')) {
	return Astro.redirect('/404');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 从 URL 获取版块 slug
const { slug } = Astro.params;

// 查询当前版块
const category = await prisma.category.findUnique({
	where: { slug },
	include: {
		parent: {
			select: { id: true, name: true, slug: true }
		}
	}
});

// 版块不存在或不是 forum 模式时返回 404
if (!category || category.mode !== 'forum') {
	return Astro.redirect('/404');
}

// 版块详情保持与论坛首页一致的左侧导航；当前版块在菜单中有明确当前态。
const groups = await prisma.category.findMany({
	where: { mode: 'forum', parentId: null },
	orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
	include: {
		children: {
			orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
			include: { _count: { select: { posts: true } } }
		}
	}
});

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const forumSort = ['latest', 'featured', 'hot'].includes(sortParam) ? sortParam : 'latest';
const forumPostOrder: Prisma.PostOrderByWithRelationInput[] =
	forumSort === 'hot'
		? [{ likes: { _count: 'desc' } }, { comments: { _count: 'desc' } }, { createdAt: 'desc' }]
		: forumSort === 'featured'
			? [{ isPinned: 'desc' }, { comments: { _count: 'desc' } }, { createdAt: 'desc' }]
			: [{ createdAt: 'desc' }];

// 从 URL 查询参数获取当前页码
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询该版块下的帖子总数
const totalPosts = await prisma.post.count({
	where: {
		isDeleted: false,
		mode: 'forum',
		categoryId: category.id,
		...visibilityFilter
	}
});

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const skip = (safePage - 1) * PAGE_SIZE;

// 查询当前页的帖子
const posts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		mode: 'forum',
		categoryId: category.id,
		...visibilityFilter
	},
	orderBy: forumPostOrder,
	include: {
		...POST_CARD_INCLUDE
	},
	skip,
	take: PAGE_SIZE
});

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const hasIcon = !!category.icon;
const recommendationItems = posts.slice(0, 5).map((post) => ({
	title: post.title || post.content.slice(0, 30) || '未命名讨论',
	href: `/${post.user.username}/${post.id}`,
	meta: `${post._count.comments} 条回复`
}));
---

<ForumLayout title={`${category.name} - ${getModeLabel('forum')}`}>
	<nav slot="nav" class="forum-category-sidebar" aria-label="论坛版块">
		<p class="sidebar-section-label">浏览论坛</p>
		<a href="/forum" class="sidebar-link"><span class="sidebar-link-icon">🏠</span><span>首页</span></a>
		<p class="sidebar-section-label">论坛版块</p>
		{groups.map((group) => (
			<section class="forum-sidebar-group" aria-labelledby={`forum-group-${group.id}`}>
				<h2 id={`forum-group-${group.id}`}>{group.icon && `${group.icon} `}{group.name}</h2>
				{group.children.map((item) => (
					<a href={`/forum/${item.slug}`} class="sidebar-link" aria-current={item.id === category.id ? 'page' : undefined}>
						<span>{item.icon && `${item.icon} `}{item.name}</span><small>{item._count.posts}</small>
					</a>
				))}
			</section>
		))}
	</nav>
	<section class="ux-channel-page ux-forum-page" aria-labelledby="forum-page-title">
	<div class="page-header">
		<nav class="breadcrumb" aria-label="面包屑导航">
			<a href="/forum" class="breadcrumb-link">{getModeLabel('forum')}</a>
			{
				category.parent && (
					<>
						<span class="breadcrumb-sep">/</span>
						<span class="breadcrumb-text">{category.parent.name}</span>
					</>
				)
			}
			<span class="breadcrumb-sep">/</span>
			<span class="breadcrumb-current">{category.name}</span>
		</nav>
		<p class="ux-eyebrow">论坛版块</p>
		<h1 class="page-title" id="forum-page-title">
			{hasIcon && <span class="page-title-icon">{category.icon}</span>}
			{category.name}
		</h1>
		{category.description && <p class="page-desc">{category.description}</p>}
	</div>

	{/* 发帖按钮（仅已登录用户显示） */}
	{
		currentUser && (
			<div style="margin-bottom: var(--spacing-6)">
				<button type="button" class="btn btn-primary" data-forum-post-btn={category.id}>
					✏️ 发帖
				</button>
			</div>
		)
	}

	<nav class="forum-sort-tabs" aria-label="帖子排序">
		<a href={`/forum/${slug}?sort=latest`} aria-current={forumSort === 'latest' ? 'page' : undefined}>最新</a>
		<a href={`/forum/${slug}?sort=hot`} aria-current={forumSort === 'hot' ? 'page' : undefined}>热门</a>
		<a href={`/forum/${slug}?sort=featured`} aria-current={forumSort === 'featured' ? 'page' : undefined}>精华</a>
	</nav>

	{
		!hasPosts ? (
			<div class="empty-state">
				<p>该版块暂无帖子，来发第一条吧！</p>
			</div>
		) : (
			<div class="post-list">
				{posts.map(async (post) => {
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postLiked = likedPostIds.has(post.id);
					const postBookmarked = bookmarkedPostIds.has(post.id);

					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderFullMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							bookmarkCount={post._count.bookmarks}
							bookmarked={postBookmarked}
							showFollow={!!currentUser}
							following={followingIds.includes(post.user.id)}
							isSelf={currentUser?.userId === post.user.id}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a
							href={`/forum/${slug}?sort=${forumSort}&page=${safePage - 1}`}
							class="pagination-btn pagination-prev"
						>
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a
							href={`/forum/${slug}?sort=${forumSort}&page=${safePage + 1}`}
							class="pagination-btn pagination-next"
						>
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
	</section>
	<ChannelAside
		slot="aside"
		title="推荐讨论"
		description="从正在参与的话题中继续阅读。"
		items={recommendationItems}
	/>
</ForumLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	.page-title-icon {
		font-size: 1.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 面包屑导航 */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--spacing-1);
		font-size: 0.8125rem;
		margin-bottom: var(--spacing-2);
		color: var(--color-muted);
	}

	.breadcrumb-link {
		color: var(--color-primary);
		text-decoration: none;
	}

	.breadcrumb-link:hover {
		text-decoration: underline;
	}

	.breadcrumb-sep {
		color: var(--color-muted);
	}

	.breadcrumb-text {
		color: var(--color-muted);
	}

	.breadcrumb-current {
		color: var(--color-text);
		font-weight: 500;
	}
</style>

<script>
	/**
	 * 论坛版块详情页客户端脚本
	 *
	 * 处理发帖按钮点击：打开论坛编辑器弹窗并预设当前版块分类。
	 */
	// 发帖按钮：打开论坛弹窗并预设分类
	document.querySelectorAll('[data-forum-post-btn]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const categoryId = (btn as HTMLElement).dataset.forumPostBtn || '';
			// 派发打开论坛弹窗事件，携带预设分类 ID
			document.dispatchEvent(
				new CustomEvent('open-forum-compose-modal', {
					detail: { categoryId }
				})
			);
		});
	});
</script>
