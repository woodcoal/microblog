---
/**
 * 论坛频道首页
 *
 * 仅在 SITE_MODES 包含 forum 时可访问，否则返回 404。
 * 展示版块列表（一级分组 + 二级分类），每个分类显示：
 * 名称、描述、图标、帖子数。点击分类进入版块详情页。
 * 已登录用户可在页面标题区域点击"发帖"按钮。
 */
import ForumLayout from '@/layouts/ForumLayout.astro';
import ChannelAside from '@/components/ChannelAside.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderFullMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, getModeLabel } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';
import type { Prisma } from '../../../generated/prisma/client';

// 模式未启用时返回 404
if (!isModeEnabled('forum')) {
	return Astro.redirect('/404');
}

// 获取当前登录用户（用于判断是否显示发帖按钮）
const currentUser = await getUserFromRequest(Astro);

const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const [follows, followers] = await Promise.all([
		prisma.follow.findMany({
			where: { followerId: currentUser.userId },
			select: { followingId: true }
		}),
		prisma.follow.findMany({
			where: { followingId: currentUser.userId },
			select: { followerId: true }
		})
	]);
	followingIds.push(...follows.map((follow) => follow.followingId));
	followerIds.push(...followers.map((follow) => follow.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 查询论坛模式的一级分组（parentId 为 null）
const groups = await prisma.category.findMany({
	where: {
		mode: 'forum',
		parentId: null
	},
	orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
	include: {
		children: {
			orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
			include: {
				_count: {
					select: { posts: true }
				}
			}
		},
		_count: {
			select: { posts: true }
		}
	}
});

const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const forumSort = ['latest', 'recommended', 'hot'].includes(sortParam) ? sortParam : 'latest';
const forumPostOrder: Prisma.PostOrderByWithRelationInput[] =
	forumSort === 'hot'
		? [{ likes: { _count: 'desc' } }, { comments: { _count: 'desc' } }, { createdAt: 'desc' }]
		: forumSort === 'recommended'
			? [{ isPinned: 'desc' }, { comments: { _count: 'desc' } }, { createdAt: 'desc' }]
			: [{ createdAt: 'desc' }];
const posts = await prisma.post.findMany({
	where: { isDeleted: false, mode: 'forum', ...visibilityFilter },
	orderBy: forumPostOrder,
	take: 20,
	include: POST_CARD_INCLUDE
});
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasGroups = groups.length > 0;
const hasPosts = posts.length > 0;
const recommendationItems = posts.slice(0, 5).map((post) => ({
	title: post.title || post.content.slice(0, 30) || '未命名讨论',
	href: `/${post.user.username}/${post.id}`,
	meta: `${post._count.comments} 条回复`
}));
const heroCopy = await getPublicSiteCopy('channel.forum.hero');
---

<ForumLayout title={getModeLabel('forum')}>
	<nav slot="nav" class="forum-category-sidebar" aria-label="论坛版块">
		<p class="sidebar-section-label">论坛版块</p>
		{
			hasGroups ? (
				groups.map((group) => (
					<section
						class="forum-sidebar-group"
						aria-labelledby={`forum-group-${group.id}`}
					>
						<h2 id={`forum-group-${group.id}`}>
							{group.icon && `${group.icon} `}
							{group.name}
						</h2>
						{group.children.map((category) => (
							<a href={`/forum/${category.slug}`} class="sidebar-link">
								<span>
									{category.icon && `${category.icon} `}
									{category.name}
								</span>
								<small>{category._count.posts}</small>
							</a>
						))}
					</section>
				))
			) : (
				<p class="forum-sidebar-empty">暂无版块</p>
			)
		}
	</nav>
	<section class="ux-channel-page ux-forum-page" aria-labelledby="forum-page-title">
		<div class="page-header">
			<div class="page-header-row">
				<div
					id="forum-page-title"
					class="site-copy-content site-copy-content-channel"
					set:html={heroCopy.html}
				/>
				{
					currentUser && (
						<button
							type="button"
							class="btn btn-primary"
							onclick="document.dispatchEvent(new CustomEvent('open-forum-compose-modal'))"
						>
							✏️ 发帖
						</button>
					)
				}
			</div>
		</div>

		<nav class="forum-sort-tabs" aria-label="帖子排序">
			<a href="/forum?sort=latest" aria-current={forumSort === 'latest' ? 'page' : undefined}
				>最新</a
			>
			<a
				href="/forum?sort=recommended"
				aria-current={forumSort === 'recommended' ? 'page' : undefined}>推荐</a
			>
			<a href="/forum?sort=hot" aria-current={forumSort === 'hot' ? 'page' : undefined}
				>热门</a
			>
		</nav>
		{
			!hasPosts ? (
				<div class="empty-state">
					<p>暂无帖子，来发第一条吧！</p>
				</div>
			) : (
				<div class="post-list">
					{posts.map(async (post) => {
						const isPostRestricted = !(await checkPostVisibility(
							{
								visibility: post.visibility,
								userId: post.userId,
								passwordHash: post.passwordHash,
								allowedUserIds: post.allowedUserIds
							},
							currentUser ? { userId: currentUser.userId } : null,
							{
								isFollower: followingIds.includes(post.userId),
								isFollowing: followerIds.includes(post.userId)
							}
						));
						return (
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: post.user,
									media: post.media,
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={renderFullMarkdown(post.content)}
								likeCount={post._count.likes}
								liked={likedPostIds.has(post.id)}
								commentCount={post._count.comments}
								bookmarkCount={post._count.bookmarks}
								bookmarked={bookmarkedPostIds.has(post.id)}
								showFollow={!!currentUser}
								following={followingIds.includes(post.user.id)}
								isSelf={currentUser?.userId === post.user.id}
								tags={post.tags.map((postTag) => ({
									id: postTag.tag.id,
									name: postTag.tag.name
								}))}
								isRestricted={isPostRestricted}
							/>
						);
					})}
				</div>
			)
		}
	</section>
	<ChannelAside
		slot="aside"
		title="推荐讨论"
		description="从正在参与的话题中继续阅读。"
		items={recommendationItems}
	/>
</ForumLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-4);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 版块分组 */
	.forum-groups {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.forum-group {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.forum-group-header {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-4);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.forum-group-icon {
		font-size: 1.25rem;
	}

	.forum-group-name {
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
		flex: 1;
	}

	.forum-group-count {
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.forum-group-desc {
		font-size: 0.8125rem;
		color: var(--color-muted);
		margin: 0;
		padding: var(--spacing-2) var(--spacing-4);
	}

	/* 分类列表 */
	.forum-category-list {
		display: flex;
		flex-direction: column;
	}

	.forum-category-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--spacing-3) var(--spacing-4);
		text-decoration: none;
		color: var(--color-text);
		transition: background 0.15s;
		border-bottom: 1px solid var(--color-border);
	}

	.forum-category-item:last-child {
		border-bottom: none;
	}

	.forum-category-item:hover {
		background: var(--color-bg);
	}

	.forum-category-info {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		flex: 1;
		min-width: 0;
	}

	.forum-category-icon {
		font-size: 1.25rem;
		flex-shrink: 0;
	}

	.forum-category-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.forum-category-name {
		font-weight: 500;
		font-size: 0.9375rem;
	}

	.forum-category-desc {
		font-size: 0.75rem;
		color: var(--color-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.forum-category-count {
		font-size: 0.8125rem;
		color: var(--color-muted);
		flex-shrink: 0;
		margin-left: var(--spacing-3);
	}
</style>
