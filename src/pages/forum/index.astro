---
/**
 * 论坛频道首页
 *
 * 仅在 SITE_MODES 包含 forum 时可访问，否则返回 404。
 * 展示版块列表（一级分组 + 二级分类），每个分类显示：
 * 名称、描述、图标、帖子数。点击分类进入版块详情页。
 * 已登录用户可在页面标题区域点击"发帖"按钮。
 */
import ForumLayout from '@/layouts/ForumLayout.astro';
import ChannelAside from '@/components/ChannelAside.astro';
import ForumTopMenu from '@/components/ForumTopMenu.astro';
import ForumTopicList from '@/components/ForumTopicList.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { POST_CARD_INCLUDE } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, getModeLabel } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';
import { getPopularPostItems } from '@/lib/discovery';
import { getTrendingFeed } from '@/services/recommend.service';
import type { Prisma } from '../../../generated/prisma/client';

// 模式未启用时返回 404
if (!isModeEnabled('forum')) {
	return Astro.redirect('/404');
}

// 获取当前登录用户（用于判断是否显示发帖按钮）
const currentUser = await getUserFromRequest(Astro);

const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const [follows, followers] = await Promise.all([
		prisma.follow.findMany({
			where: { followerId: currentUser.userId },
			select: { followingId: true }
		}),
		prisma.follow.findMany({
			where: { followingId: currentUser.userId },
			select: { followerId: true }
		})
	]);
	followingIds.push(...follows.map((follow) => follow.followingId));
	followerIds.push(...followers.map((follow) => follow.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

const PAGE_SIZE = 20;
const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const forumSort = ['latest', 'featured', 'hot'].includes(sortParam) ? sortParam : 'latest';
// 主内容区的板块导览只属于论坛首页；热门、推荐只展示对应内容流。
const showCategoryOverview = forumSort === 'latest';
const groups = showCategoryOverview
	? await prisma.category.findMany({
			where: {
				mode: 'forum',
				parentId: null
			},
			orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
			include: {
				children: {
					orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
					include: {
						_count: {
							select: { posts: true }
						}
					}
				},
				_count: {
					select: { posts: true }
				}
			}
		})
	: [];
const forumPostOrder: Prisma.PostOrderByWithRelationInput[] =
	forumSort === 'featured'
		? [{ isPinned: 'desc' }, { comments: { _count: 'desc' } }, { createdAt: 'desc' }]
		: [{ createdAt: 'desc' }];
const forumPostWhere = {
	isDeleted: false,
	user: { deletedAt: null },
	mode: 'forum',
	...visibilityFilter
};
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const hotResult =
	forumSort === 'hot'
		? await getTrendingFeed({
				viewerId: currentUser?.userId,
				page: currentPage,
				pageSize: PAGE_SIZE,
				mode: 'forum'
			})
		: null;
const totalPosts = hotResult?.total ?? (await prisma.post.count({ where: forumPostWhere }));
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const posts =
	hotResult?.items ??
	(await prisma.post.findMany({
		where: forumPostWhere,
		orderBy: forumPostOrder,
		skip: (safePage - 1) * PAGE_SIZE,
		take: PAGE_SIZE,
		include: POST_CARD_INCLUDE
	}));
const restrictedPostIds = (
	await Promise.all(
		posts.map(async (post) => ({
			id: post.id,
			restricted: !(await checkPostVisibility(
				{
					visibility: post.visibility,
					userId: post.userId,
					passwordHash: post.passwordHash,
					allowedUserIds: post.allowedUserIds
				},
				currentUser ? { userId: currentUser.userId } : null,
				{
					isFollower: followingIds.includes(post.userId),
					isFollowing: followerIds.includes(post.userId)
				}
			))
		}))
	)
)
	.filter((post) => post.restricted)
	.map((post) => post.id);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasGroups = groups.length > 0;
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const recommendationItems = await getPopularPostItems({
	mode: 'forum',
	viewerId: currentUser?.userId,
	excludePostIds: posts.map((post) => post.id),
	responseLabel: '回复'
});
const discoverySections =
	recommendationItems.length > 0
		? [
				{
					title: '热门讨论',
					description: '继续阅读当前列表之外的活跃话题。',
					items: recommendationItems
				}
			]
		: [];
const heroCopy = await getPublicSiteCopy('channel.forum.hero');
---

<ForumLayout title={getModeLabel('forum')} hasAside={true}>
	<section class="ux-channel-page ux-forum-page" aria-labelledby="forum-page-title">
		<div class="page-header">
			<div class="page-header-row">
				<div
					id="forum-page-title"
					class="site-copy-content site-copy-content-channel"
					set:html={heroCopy.html}
				/>
				{
					currentUser && (
						<button
							type="button"
							class="btn btn-primary"
							onclick="document.dispatchEvent(new CustomEvent('open-forum-compose-modal'))"
						>
							✏️ 发帖
						</button>
					)
				}
			</div>
		</div>
		<ForumTopMenu />

		{
			showCategoryOverview && (
				<section
					class="forum-category-overview"
					aria-labelledby="forum-category-overview-title"
				>
					<div class="forum-category-overview-heading">
						<div>
							<h2 id="forum-category-overview-title">浏览板块</h2>
							<p>按主题选择板块，参与正在发生的讨论。</p>
						</div>
						{hasGroups && (
							<span class="forum-category-overview-count">
								{groups.length} 个分组
							</span>
						)}
					</div>
					{hasGroups ? (
						<div class="forum-groups">
							{groups.map((group) => (
								<section
									class="forum-group"
									aria-labelledby={`forum-overview-group-${group.id}`}
								>
									<div class="forum-group-header">
										{group.icon && (
											<span class="forum-group-icon" aria-hidden="true">
												{group.icon}
											</span>
										)}
										<div class="forum-group-copy">
											<h3
												class="forum-group-name"
												id={`forum-overview-group-${group.id}`}
											>
												{group.name}
											</h3>
											{group.description && <p>{group.description}</p>}
										</div>
										<span class="forum-group-count">
											{group.children.length} 个板块
										</span>
									</div>
									{group.children.length > 0 ? (
										<div class="forum-category-list">
											{group.children.map((category) => (
												<a
													href={`/forum/${category.slug}`}
													class="forum-category-item"
												>
													<span class="forum-category-info">
														{category.icon && (
															<span
																class="forum-category-icon"
																aria-hidden="true"
															>
																{category.icon}
															</span>
														)}
														<span class="forum-category-text">
															<span class="forum-category-name">
																{category.name}
															</span>
															<span class="forum-category-desc">
																{category.description ||
																	'暂未添加板块介绍'}
															</span>
														</span>
													</span>
													<span class="forum-category-count">
														{category._count.posts} 篇
													</span>
												</a>
											))}
										</div>
									) : (
										<p class="forum-group-empty">该分组暂未添加二级板块。</p>
									)}
								</section>
							))}
						</div>
					) : (
						<div class="empty-state">
							<p>暂无可浏览的{getModeLabel('forum')}板块。</p>
						</div>
					)}
				</section>
			)
		}

		<h2 class="forum-topic-section-title">全部讨论</h2>
		<nav class="forum-sort-tabs" aria-label="帖子排序">
			<a href="/forum?sort=latest" aria-current={forumSort === 'latest' ? 'page' : undefined}
				>最新</a
			>
			<a
				href="/forum?sort=featured"
				aria-current={forumSort === 'featured' ? 'page' : undefined}>推荐</a
			>
			<a href="/forum?sort=hot" aria-current={forumSort === 'hot' ? 'page' : undefined}
				>热门</a
			>
		</nav>
		{
			!hasPosts ? (
				<div class="empty-state">
					<p>暂无帖子，来发第一条吧！</p>
				</div>
			) : (
				<ForumTopicList posts={posts} restrictedPostIds={restrictedPostIds} />
			)
		}
		{
			hasPagination && (
				<nav class="pagination" aria-label={`${getModeLabel('forum')} 分页导航`}>
					<div class="pagination-inner">
						{hasPrevPage ? (
							<a
								href={`/forum?sort=${forumSort}&page=${safePage - 1}`}
								class="pagination-btn"
							>
								← 上一页
							</a>
						) : (
							<span class="pagination-btn pagination-disabled">← 上一页</span>
						)}
						<span class="pagination-info">
							第 {safePage} / {totalPages} 页
						</span>
						{hasNextPage ? (
							<a
								href={`/forum?sort=${forumSort}&page=${safePage + 1}`}
								class="pagination-btn"
							>
								下一页 →
							</a>
						) : (
							<span class="pagination-btn pagination-disabled">下一页 →</span>
						)}
					</div>
				</nav>
			)
		}
	</section>
	<ChannelAside slot="aside" sections={discoverySections} />
</ForumLayout>
