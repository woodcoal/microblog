---
/**
 * 首页（个性化推荐）
 *
 * 全站数据聚合入口，以推荐/发现为核心：
 * - 已登录用户：优先展示 Gorse 个性化推荐 + 关注动态
 * - 未登录用户：展示热门内容（按热门分数排序）
 * - 三种模式帖子混排，卡片按 mode 渲染
 * - 全局置顶帖始终排在最前面
 * - 支持页码分页（?page=N），每页20条
 */
import HomeLayout from '@/layouts/HomeLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { calculateTrendingScore } from '@/lib/trending';
import { POST_CARD_INCLUDE, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isSingleMode, singleMode } from '@/lib/config';
import { isGorseEnabled } from '@/lib/gorse';

// 单模式时直接重定向到该模式首页
if (isSingleMode && singleMode) {
	const redirectMap: Record<string, string> = {
		weibo: '/weibo',
		forum: '/forum',
		blog: '/blog'
	};
	return Astro.redirect(redirectMap[singleMode] || '/');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 从 URL 查询参数获取当前页码，默认第 1 页
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询全局置顶帖（始终在最前面，不受分页影响）
const pinnedPosts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		isGlobalPinned: true,
		...visibilityFilter
	},
	orderBy: [{ createdAt: 'desc' }],
	include: {
		...POST_CARD_INCLUDE,
		likes: { select: { id: true, userId: true } },
		comments: { select: { id: true } }
	}
});

// 查询非置顶公开帖子总数，用于计算总页数
const totalPosts = await prisma.post.count({
	where: {
		isDeleted: false,
		isGlobalPinned: false,
		...visibilityFilter
	}
});

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));

// 确保当前页不超过总页数
const safePage = Math.min(currentPage, totalPages);

// 查询所有非置顶公开帖子（需要全部加载以计算热门分数后排序）
const allNonPinnedPosts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		isGlobalPinned: false,
		...visibilityFilter
	},
	include: {
		...POST_CARD_INCLUDE,
		likes: { select: { id: true, userId: true } },
		comments: { select: { id: true } }
	}
});

// 为每个非置顶帖子计算热门分数，按分数倒序排列
const sortedNonPinnedPosts = allNonPinnedPosts
	.map((post) => ({
		post,
		score: calculateTrendingScore(post.likes.length, post.comments.length, post.createdAt)
	}))
	.sort((a, b) => b.score - a.score);

// 按页码截取当前页的非置顶帖子
const skip = (safePage - 1) * PAGE_SIZE;
const pagedNonPinnedPosts = sortedNonPinnedPosts.slice(skip, skip + PAGE_SIZE);

// 合并置顶帖和当前页非置顶帖（仅第一页显示置顶帖）
const posts =
	safePage === 1
		? [...pinnedPosts, ...pagedNonPinnedPosts.map((item) => item.post)]
		: pagedNonPinnedPosts.map((item) => item.post);

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const gorseEnabled = isGorseEnabled() && !!currentUser;
---

<HomeLayout title="首页">
	{/* 首页标题区 */}
	<div class="home-header">
		<h1 class="home-title">发现</h1>
		<p class="home-desc">
			{currentUser ? '为你精选的全站好内容' : '全站热门内容，登录后获取个性化推荐'}
		</p>
	</div>

	{
		!hasPosts ? (
			<div class="empty-state">
				<p>还没有任何动态，注册后发第一条吧！</p>
			</div>
		) : (
			<div class="post-list">
				{posts.map(async (post) => {
					// 提取标签列表
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					// 点赞数和评论数
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postLiked = likedPostIds.has(post.id);

					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}

	{/* 猜你喜欢 - Gorse 个性化推荐 */}
	{
		gorseEnabled && (
			<section class="recommend-section" id="recommend-section" style="display:none">
				<h2 class="recommend-title">猜你喜欢</h2>
				<div class="recommend-list" id="recommend-list" />
			</section>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a href={`/?page=${safePage - 1}`} class="pagination-btn pagination-prev">
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a href={`/?page=${safePage + 1}`} class="pagination-btn pagination-next">
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</HomeLayout>

<style>
	/* 首页标题区 */
	.home-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.home-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 var(--spacing-1);
	}

	.home-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 猜你喜欢 - 个性化推荐区域样式 */
	.recommend-section {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}
	.recommend-title {
		font-size: 1.125rem;
		font-weight: 600;
		margin-bottom: 1rem;
		color: var(--color-text);
	}
	.recommend-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.recommend-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		background: var(--color-surface);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--color-text);
		transition: background 0.2s;
	}
	.recommend-item:hover {
		background: color-mix(in srgb, var(--color-text) 6%, var(--color-surface));
	}
	.recommend-item-avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}
	.recommend-item-avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-primary);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		flex-shrink: 0;
	}
	.recommend-item-content {
		flex: 1;
		min-width: 0;
	}
	.recommend-item-title {
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.recommend-item-meta {
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-top: 0.125rem;
	}
</style>

<script>
	import { actions } from 'astro:actions';

	/**
	 * 个性化推荐加载逻辑
	 *
	 * 页面加载后通过 Astro Actions 获取推荐帖子，
	 * 渲染为简洁的卡片列表。失败时静默隐藏推荐区域。
	 * 仅在推荐区域存在时执行（Gorse 已启用且用户已登录）。
	 */
	(async () => {
		const section = document.getElementById('recommend-section');
		const list = document.getElementById('recommend-list');
		if (!section || !list) return;

		const result = await actions.getRecommend({ n: 5 });
		if (result.error || !result.data?.items?.length) {
			// 无推荐结果或出错，不显示区域
			return;
		}

		const items = result.data.items;
			const fragment = document.createDocumentFragment();

			for (const item of items) {
				const a = document.createElement('a');
				a.href = `/${item.user.username}/${item.id}`;
				a.className = 'recommend-item';

				// 头像
				if (item.user.avatarUrl) {
					const img = document.createElement('img');
					img.src = item.user.avatarUrl;
					img.alt = item.user.displayName;
					img.className = 'recommend-item-avatar';
					img.loading = 'lazy';
					a.appendChild(img);
				} else {
					const span = document.createElement('span');
					span.className = 'recommend-item-avatar-placeholder';
					span.textContent = item.user.displayName.charAt(0).toUpperCase();
					a.appendChild(span);
				}

				// 内容区
				const contentDiv = document.createElement('div');
				contentDiv.className = 'recommend-item-content';

				const titleDiv = document.createElement('div');
				titleDiv.className = 'recommend-item-title';
				// 有标题用标题，否则用内容前 80 字符
				titleDiv.textContent =
					item.title || item.content.replace(/[#*`>\-\[\]()!]/g, '').slice(0, 80);

				const metaDiv = document.createElement('div');
				metaDiv.className = 'recommend-item-meta';
				const likeText = item.likeCount > 0 ? ` · ${item.likeCount} 赞` : '';
				const commentText = item.commentCount > 0 ? ` · ${item.commentCount} 评论` : '';
				metaDiv.textContent = `@${item.user.username}${likeText}${commentText}`;

				contentDiv.appendChild(titleDiv);
				contentDiv.appendChild(metaDiv);
				a.appendChild(contentDiv);
				fragment.appendChild(a);
			}

			list.appendChild(fragment);
		section.style.display = '';
	})();
</script>
