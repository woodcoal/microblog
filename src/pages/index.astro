---
/**
 * 首页（个性化推荐）
 *
 * 全站数据聚合入口，以推荐/发现为核心：
 * - 已登录用户：展示本地热门推荐与关注动态
 * - 未登录用户：展示热门内容（按热门分数排序）
 * - 三种模式帖子混排，卡片按 mode 渲染
 * - 全局置顶帖始终排在最前面
 * - 支持页码分页（?page=N），每页20条
 */
import HomeLayout from '@/layouts/HomeLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { checkPostVisibility } from '@/lib/visibility';
import { isSingleMode, singleMode } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';
import { getTrendingFeed } from '@/services/recommend.service';

// 单模式时直接重定向到该模式首页
if (isSingleMode && singleMode) {
	const redirectMap: Record<string, string> = {
		weibo: '/weibo',
		forum: '/forum',
		blog: '/blog'
	};
	return Astro.redirect(redirectMap[singleMode] || '/');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
// 从 URL 查询参数获取当前页码，默认第 1 页
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询非置顶公开帖子总数，用于计算总页数
const unifiedTrending = await getTrendingFeed({
	viewerId: currentUser?.userId,
	page: currentPage,
	pageSize: PAGE_SIZE,
	includeGlobalPinned: true
});
const totalPosts = unifiedTrending.total;

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));

// 确保当前页不超过总页数
const safePage = Math.min(currentPage, totalPages);

const posts = unifiedTrending.items;

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const canShowRecommendations = !!currentUser;
const heroCopy = await getPublicSiteCopy('home.hero');
---

<HomeLayout title="首页">
	<section class="home-hero">
		<div class="home-hero-copy">
			<!-- html 仅来自服务端受限 Markdown 渲染器，浏览器不解析原始 Markdown。 -->
			<div class="site-copy-content site-copy-content-home" set:html={heroCopy.html} />
			<div class="home-hero-actions">
				{
					currentUser ? (
						<a class="btn btn-primary" href="#home-feed">
							浏览热门内容
						</a>
					) : (
						<a class="btn btn-primary" href="/register">
							加入睦谈
						</a>
					)
				}
				<a class="btn btn-outline" href="#home-channels">探索频道</a>
			</div>
		</div>
		<div class="home-preview" aria-label="睦谈内容类型">
			<div class="home-preview-chrome" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<div class="home-preview-item">
				<span class="home-preview-mark">微</span>
				<div><strong>记录此刻的想法</strong><small>短内容与即时互动</small></div>
			</div>
			<div class="home-preview-item">
				<span class="home-preview-mark">论</span>
				<div><strong>把问题聊透</strong><small>主题讨论与楼层回复</small></div>
			</div>
			<div class="home-preview-item">
				<span class="home-preview-mark">博</span>
				<div><strong>留下一篇长文</strong><small>可持续阅读与沉淀</small></div>
			</div>
		</div>
	</section>

	<section class="home-channels" id="home-channels" aria-labelledby="home-channels-title">
		<div class="home-section-heading">
			<div>
				<p class="home-eyebrow">三种表达方式</p><h2 id="home-channels-title">
					从你喜欢的方式开始
				</h2>
			</div>
			<a href="#home-feed">浏览全站动态 <span aria-hidden="true">→</span></a>
		</div>
		<div class="home-channel-grid">
			<a class="home-channel home-channel-featured" href="/weibo"
				><span>即时交流</span><h3>微博</h3><p>短小、及时，和朋友保持同频。</p></a
			>
			<a class="home-channel" href="/forum"
				><span>持续讨论</span><h3>论坛</h3><p>找到同好，把观点慢慢讲清楚。</p></a
			>
			<a class="home-channel" href="/blog"
				><span>深度沉淀</span><h3>博客</h3><p>阅读与写作，都有安静的空间。</p></a
			>
		</div>
	</section>

	<section class="home-feed" id="home-feed" aria-labelledby="home-feed-title">
		<div class="home-header">
			<h2 id="home-feed-title">正在被讨论</h2>
			<p>{currentUser ? '为你精选的全站好内容' : '全站热门内容，登录后获取个性化推荐'}</p>
		</div>

		{
			!hasPosts ? (
				<div class="empty-state">
					<p>还没有任何动态，注册后发第一条吧！</p>
				</div>
			) : (
				<div class="post-list">
					{posts.map(async (post) => {
						// 提取标签列表
						const postTags = post.tags.map((pt) => ({
							id: pt.tag.id,
							name: pt.tag.name
						}));
						// 点赞数和评论数
						const postLikeCount = post._count.likes;
						const postCommentCount = post._count.comments;
						const postLiked = likedPostIds.has(post.id);
						const postBookmarked = bookmarkedPostIds.has(post.id);

						// 检查当前用户是否有权查看帖子内容
						const isPostRestricted = !(await checkPostVisibility(
							{
								visibility: post.visibility,
								userId: post.userId,
								passwordHash: post.passwordHash,
								allowedUserIds: post.allowedUserIds
							},
							currentUser ? { userId: currentUser.userId } : null,
							{
								isFollower: followingIds.includes(post.userId),
								isFollowing: followerIds.includes(post.userId)
							}
						));

						return (
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: {
										id: post.user.id,
										username: post.user.username,
										displayName: post.user.displayName,
										avatarUrl: post.user.avatarUrl
									},
									media: post.media,
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={renderMarkdown(post.content)}
								likeCount={postLikeCount}
								liked={postLiked}
								commentCount={postCommentCount}
								bookmarkCount={post._count.bookmarks}
								bookmarked={postBookmarked}
								showFollow={!!currentUser}
								following={followingIds.includes(post.user.id)}
								isSelf={currentUser?.userId === post.user.id}
								tags={postTags}
								isRestricted={isPostRestricted}
							/>
						);
					})}
				</div>
			)
		}
	</section>

	{/* 为登录用户提供独立状态的帖子与用户推荐。 */}
	{
		canShowRecommendations && (
			<section class="recommend-section" aria-labelledby="recommend-title">
				<div class="recommend-section-header">
					<div>
						<p class="home-eyebrow">为你推荐</p>
						<h2 id="recommend-title">发现值得关注的内容与创作者</h2>
					</div>
				</div>
				<div class="recommend-grid">
					<section
						class="recommend-panel"
						id="recommend-posts-panel"
						aria-labelledby="recommend-posts-title"
					>
						<h3 id="recommend-posts-title">推荐帖子</h3>
						<div
							class="recommend-status"
							id="recommend-posts-status"
							role="status"
							aria-live="polite"
						>
							正在加载推荐帖子…
						</div>
						<div class="recommend-list" id="recommend-posts-list" />
					</section>
					<section
						class="recommend-panel"
						id="recommend-users-panel"
						aria-labelledby="recommend-users-title"
					>
						<h3 id="recommend-users-title">推荐用户</h3>
						<div
							class="recommend-status"
							id="recommend-users-status"
							role="status"
							aria-live="polite"
						>
							正在加载推荐用户…
						</div>
						<div class="recommend-user-list" id="recommend-users-list" />
					</section>
				</div>
			</section>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a href={`/?page=${safePage - 1}`} class="pagination-btn pagination-prev">
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a href={`/?page=${safePage + 1}`} class="pagination-btn pagination-next">
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</HomeLayout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
		padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
	}

	.home-eyebrow {
		margin: 0 0 var(--spacing-3);
		color: var(--color-primary);
		font-size: 0.8125rem;
		font-weight: 750;
		letter-spacing: 0.06em;
	}

	.home-title {
		max-width: 740px;
		font-size: clamp(2.625rem, 5.2vw, 4.75rem);
		font-weight: 800;
		letter-spacing: -0.075em;
		line-height: 1.04;
		text-wrap: balance;
	}

	.home-lede {
		max-width: 580px;
		margin: var(--spacing-5) 0 var(--spacing-6);
		color: var(--color-muted);
		font-size: 1.125rem;
		line-height: 1.7;
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.home-preview {
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-card-bg);
		box-shadow: var(--shadow-xl);
	}

	.home-preview-chrome {
		display: flex;
		gap: 6px;
		margin-bottom: var(--spacing-4);
	}
	.home-preview-chrome span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-border);
	}
	.home-preview-item {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr);
		gap: var(--spacing-3);
		padding: var(--spacing-4) 0;
		border-top: 1px solid var(--color-border);
	}
	.home-preview-item:first-of-type {
		border-top: 0;
	}
	.home-preview-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--color-primary) 10%, transparent);
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
	}
	.home-preview-item strong,
	.home-preview-item small {
		display: block;
	}
	.home-preview-item strong {
		font-size: 0.9375rem;
	}
	.home-preview-item small {
		margin-top: 2px;
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.home-channels {
		margin: 0 calc(50% - 50vw);
		padding: var(--spacing-10) max(var(--spacing-6), calc((100vw - var(--layout-home)) / 2));
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}
	.home-section-heading,
	.home-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: var(--spacing-4);
	}
	.home-section-heading {
		max-width: var(--layout-home);
		margin: 0 auto var(--spacing-5);
	}
	.home-section-heading h2,
	.home-header h2 {
		font-size: 1.5625rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	.home-section-heading a {
		font-size: 0.875rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.home-channel-grid {
		display: grid;
		grid-template-columns: 1.25fr 1fr 1fr;
		gap: var(--spacing-4);
		max-width: var(--layout-home);
		margin: 0 auto;
	}
	.home-channel {
		display: flex;
		min-height: 178px;
		flex-direction: column;
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-card-bg);
		color: var(--color-text);
	}
	.home-channel:hover {
		color: var(--color-text);
		border-color: var(--color-primary);
	}
	.home-channel > span {
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
	}
	.home-channel h3 {
		margin: auto 0 var(--spacing-1);
		font-size: 1.25rem;
		letter-spacing: -0.03em;
	}
	.home-channel p {
		color: var(--color-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.home-channel-featured {
		border-color: var(--color-primary);
		background: var(--color-primary);
		color: var(--color-primary-foreground);
	}
	.home-channel-featured > span,
	.home-channel-featured p {
		color: var(--color-primary-foreground);
	}

	.home-feed {
		max-width: 1000px;
		margin: 0 auto;
		padding: var(--spacing-10) 0 0;
	}
	/* 首页内容流标题 */
	.home-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border);
	}
	.home-header p {
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	/* 登录后的个性化推荐区域与首页内容轴对齐。 */
	.recommend-section {
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border);
	}
	.recommend-section-header {
		margin-bottom: var(--spacing-5);
	}
	.recommend-section-header h2 {
		font-size: 1.5625rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	.recommend-grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
		gap: var(--spacing-5);
		align-items: start;
	}
	.recommend-panel {
		min-width: 0;
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-card-bg);
	}
	.recommend-panel h3 {
		margin-bottom: var(--spacing-4);
		font-size: 1rem;
		font-weight: 800;
	}
	.recommend-status {
		color: var(--color-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.recommend-status:empty {
		display: none;
	}
	.recommend-retry {
		margin-top: var(--spacing-3);
	}
	.recommend-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.recommend-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		background: var(--color-surface);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--color-text);
		transition: background 0.2s;
	}
	.recommend-item:hover {
		background: color-mix(in srgb, var(--color-text) 6%, var(--color-surface));
	}
	.recommend-item-avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}
	.recommend-item-avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-size: 0.75rem;
		font-weight: 600;
		flex-shrink: 0;
	}
	.recommend-item-content {
		flex: 1;
		min-width: 0;
	}
	.recommend-item-title {
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.recommend-item-meta {
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-top: 0.125rem;
	}
	.recommend-user-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}
	.recommend-user-card {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) auto;
		gap: var(--spacing-3);
		align-items: start;
		padding-block: var(--spacing-3);
		border-top: 1px solid var(--color-border);
	}
	.recommend-user-card:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.recommend-user-avatar,
	.recommend-user-avatar-placeholder {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-size: 0.875rem;
		font-weight: 700;
		object-fit: cover;
	}
	.recommend-user-copy {
		min-width: 0;
	}
	.recommend-user-name {
		display: block;
		overflow: hidden;
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 750;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.recommend-user-handle,
	.recommend-user-bio,
	.recommend-user-social {
		margin: var(--spacing-1) 0 0;
		color: var(--color-muted);
		font-size: 0.75rem;
		line-height: 1.45;
	}
	.recommend-user-handle {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.recommend-user-bio {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.recommend-user-social {
		color: var(--color-primary);
		font-weight: 650;
	}
	.recommend-follow-button {
		align-self: center;
		min-height: 36px;
		padding-inline: var(--spacing-3);
		font-size: 0.8125rem;
	}

	@media (max-width: 1023px) {
		.recommend-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 767px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
			padding-block: var(--spacing-10);
		}
		.home-title {
			font-size: clamp(2.5rem, 13vw, 3.5rem);
		}
		.home-lede {
			font-size: 1rem;
		}
		.home-hero-actions {
			flex-direction: column;
			align-items: stretch;
		}
		.home-hero-actions .btn {
			width: 100%;
		}
		.home-channels {
			margin-inline: calc(50% - 50vw);
			padding: var(--spacing-8) var(--spacing-4);
		}
		.home-section-heading,
		.home-header {
			align-items: flex-start;
			flex-direction: column;
		}
		.home-channel-grid {
			grid-template-columns: 1fr;
		}
		.home-channel {
			min-height: 152px;
		}
		.home-feed {
			padding-top: var(--spacing-8);
		}
		.recommend-section {
			margin-top: var(--spacing-8);
			padding-top: var(--spacing-6);
		}
		.recommend-panel {
			padding: var(--spacing-4);
		}
	}
</style>

<script>
	import { actions } from 'astro:actions';
	import type { RecommendItem, RecommendUserItem } from '@/services/recommend.service';

	/** 仅在已登录用户的推荐区域存在时加载两个独立数据源。 */
	(async () => {
		const postsPanel = document.getElementById('recommend-posts-panel') as HTMLElement | null;
		const postsList = document.getElementById('recommend-posts-list') as HTMLElement | null;
		const postsStatus = document.getElementById('recommend-posts-status') as HTMLElement | null;
		const usersPanel = document.getElementById('recommend-users-panel') as HTMLElement | null;
		const usersList = document.getElementById('recommend-users-list') as HTMLElement | null;
		const usersStatus = document.getElementById('recommend-users-status') as HTMLElement | null;
		if (!postsPanel || !postsList || !postsStatus || !usersPanel || !usersList || !usersStatus)
			return;
		const postsPanelElement: HTMLElement = postsPanel;
		const postsListElement: HTMLElement = postsList;
		const postsStatusElement: HTMLElement = postsStatus;
		const usersPanelElement: HTMLElement = usersPanel;
		const usersListElement: HTMLElement = usersList;
		const usersStatusElement: HTMLElement = usersStatus;

		function setStatus(status: HTMLElement, message = '') {
			status.replaceChildren();
			if (message) status.append(document.createTextNode(message));
		}

		function showError(status: HTMLElement, message: string, retry: () => void) {
			setStatus(status, message);
			const retryButton = document.createElement('button');
			retryButton.type = 'button';
			retryButton.className = 'btn btn-outline recommend-retry';
			retryButton.textContent = '重试';
			retryButton.addEventListener('click', retry);
			status.appendChild(retryButton);
		}

		function renderPosts(items: RecommendItem[]) {
			const fragment = document.createDocumentFragment();
			for (const item of items) {
				const a = document.createElement('a');
				a.href = `/${item.user.username}/${item.id}`;
				a.className = 'recommend-item';

				// 头像
				if (item.user.avatarUrl) {
					const img = document.createElement('img');
					img.src = item.user.avatarUrl;
					img.alt = item.user.displayName;
					img.className = 'recommend-item-avatar';
					img.loading = 'lazy';
					a.appendChild(img);
				} else {
					const span = document.createElement('span');
					span.className = 'recommend-item-avatar-placeholder';
					span.textContent = item.user.displayName.charAt(0).toUpperCase();
					a.appendChild(span);
				}

				// 内容区
				const contentDiv = document.createElement('div');
				contentDiv.className = 'recommend-item-content';

				const titleDiv = document.createElement('div');
				titleDiv.className = 'recommend-item-title';
				// 有标题用标题，否则用内容前 80 字符
				titleDiv.textContent =
					item.title || item.content.replace(/[#*`>\-[\]()!]/g, '').slice(0, 80);

				const metaDiv = document.createElement('div');
				metaDiv.className = 'recommend-item-meta';
				const likeText = item.likeCount > 0 ? ` · ${item.likeCount} 赞` : '';
				const commentText = item.commentCount > 0 ? ` · ${item.commentCount} 评论` : '';
				metaDiv.textContent = `@${item.user.username}${likeText}${commentText}`;

				contentDiv.appendChild(titleDiv);
				contentDiv.appendChild(metaDiv);
				a.appendChild(contentDiv);
				fragment.appendChild(a);
			}
			postsListElement.replaceChildren(fragment);
		}

		function renderUsers(items: RecommendUserItem[]) {
			const fragment = document.createDocumentFragment();
			for (const item of items) {
				const card = document.createElement('article');
				card.className = 'recommend-user-card';

				const profileUrl = `/${item.username}`;
				if (item.avatarUrl) {
					const avatarLink = document.createElement('a');
					avatarLink.href = profileUrl;
					const avatar = document.createElement('img');
					avatar.src = item.avatarUrl;
					avatar.alt = `${item.displayName} 的头像`;
					avatar.className = 'recommend-user-avatar';
					avatar.loading = 'lazy';
					avatarLink.appendChild(avatar);
					card.appendChild(avatarLink);
				} else {
					const avatarLink = document.createElement('a');
					avatarLink.href = profileUrl;
					avatarLink.className = 'recommend-user-avatar-placeholder';
					avatarLink.setAttribute('aria-label', `查看 ${item.displayName} 的主页`);
					avatarLink.textContent = item.displayName.charAt(0).toUpperCase();
					card.appendChild(avatarLink);
				}

				const copy = document.createElement('div');
				copy.className = 'recommend-user-copy';
				const name = document.createElement('a');
				name.href = profileUrl;
				name.className = 'recommend-user-name';
				name.textContent = item.displayName;
				const handle = document.createElement('p');
				handle.className = 'recommend-user-handle';
				handle.textContent = `@${item.username}`;
				const bio = document.createElement('p');
				bio.className = 'recommend-user-bio';
				bio.textContent = item.bio || '来看看这位创作者的公开动态。';
				const social = document.createElement('p');
				social.className = 'recommend-user-social';
				social.textContent =
					item.mutualFollowCount > 0
						? `${item.mutualFollowCount} 位共同关注`
						: `${item.followerCount} 位关注者`;
				copy.append(name, handle, bio, social);

				const followButton = document.createElement('button');
				followButton.type = 'button';
				followButton.className = 'btn btn-primary recommend-follow-button';
				followButton.textContent = '关注';
				followButton.setAttribute('aria-label', `关注 ${item.displayName}`);
				followButton.addEventListener('click', async () => {
					followButton.disabled = true;
					try {
						const result = await actions.toggleFollow({ username: item.username });
						if (result.data?.following) {
							card.remove();
							if (!usersListElement.children.length) {
								setStatus(usersStatusElement, '暂时没有可推荐的用户');
							}
							return;
						}
					} catch {
						// 保留候选并恢复按钮，允许用户直接重试关注。
					} finally {
						if (card.isConnected) {
							followButton.disabled = false;
							followButton.textContent = '重试关注';
							followButton.setAttribute('aria-label', `重试关注 ${item.displayName}`);
						}
					}
				});
				card.append(copy, followButton);
				fragment.appendChild(card);
			}
			usersListElement.replaceChildren(fragment);
		}

		async function loadPosts() {
			postsPanelElement.setAttribute('aria-busy', 'true');
			postsListElement.replaceChildren();
			setStatus(postsStatusElement, '正在加载推荐帖子…');
			try {
				const result = await actions.getRecommend({ n: 5 });
				if (result.error) {
					showError(postsStatusElement, '推荐帖子加载失败，请稍后重试。', loadPosts);
					return;
				}
				const items = result.data?.items ?? [];
				if (!items.length) {
					setStatus(postsStatusElement, '暂无新的内容推荐');
					return;
				}
				renderPosts(items);
				setStatus(postsStatusElement);
			} catch {
				showError(postsStatusElement, '推荐帖子加载失败，请稍后重试。', loadPosts);
			} finally {
				postsPanelElement.removeAttribute('aria-busy');
			}
		}

		async function loadUsers() {
			usersPanelElement.setAttribute('aria-busy', 'true');
			usersListElement.replaceChildren();
			setStatus(usersStatusElement, '正在加载推荐用户…');
			try {
				const result = await actions.getRecommendUsers({ n: 5 });
				if (result.error) {
					showError(usersStatusElement, '推荐用户加载失败，请稍后重试。', loadUsers);
					return;
				}
				const items = result.data?.items ?? [];
				if (!items.length) {
					setStatus(usersStatusElement, '暂时没有可推荐的用户');
					return;
				}
				renderUsers(items);
				setStatus(usersStatusElement);
			} catch {
				showError(usersStatusElement, '推荐用户加载失败，请稍后重试。', loadUsers);
			} finally {
				usersPanelElement.removeAttribute('aria-busy');
			}
		}

		void loadPosts();
		void loadUsers();
	})();
</script>
