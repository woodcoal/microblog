---
/**
 * 首页（个性化推荐）
 *
 * 全站数据聚合入口，以推荐/发现为核心：
 * - 已登录用户：展示本地热门推荐与关注动态
 * - 未登录用户：展示热门内容（按热门分数排序）
 * - 三种模式帖子混排，卡片按 mode 渲染
 * - 全局置顶帖始终排在最前面
 * - 支持页码分页（?page=N），每页20条
 */
import HomeLayout from '@/layouts/HomeLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { checkPostVisibility } from '@/lib/visibility';
import { isSingleMode, singleMode } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';
import { getRecommendationProfile, getTrendingFeed } from '@/services/recommend.service';

// 单模式时直接重定向到该模式首页
if (isSingleMode && singleMode) {
	const redirectMap: Record<string, string> = {
		weibo: '/weibo',
		forum: '/forum',
		blog: '/blog'
	};
	return Astro.redirect(redirectMap[singleMode] || '/');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
// 从 URL 查询参数获取当前页码，默认第 1 页
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询非置顶公开帖子总数，用于计算总页数
const unifiedTrending = await getTrendingFeed({
	viewerId: currentUser?.userId,
	page: currentPage,
	pageSize: PAGE_SIZE,
	includeGlobalPinned: true
});
const totalPosts = unifiedTrending.total;

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));

// 确保当前页不超过总页数
const safePage = Math.min(currentPage, totalPages);

const posts = unifiedTrending.items;
const heroTrending = posts.slice(0, 3);
const modeLabels: Record<string, string> = { weibo: '微博', forum: '论坛', blog: '博客' };

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	posts.map((p) => p.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = posts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const canShowRecommendations = !!currentUser;
const heroCopy = await getPublicSiteCopy('home.hero');
let recommendationProfile: Awaited<ReturnType<typeof getRecommendationProfile>> | null = null;
let interestTags: Array<{ id: string; name: string }> = [];
let interestCategories: Array<{ id: string; name: string }> = [];
if (currentUser) {
	[recommendationProfile, interestTags, interestCategories] = await Promise.all([
		getRecommendationProfile(currentUser.userId),
		prisma.tag.findMany({
			where: { isHidden: false },
			orderBy: [{ posts: { _count: 'desc' } }, { name: 'asc' }],
			take: 8,
			select: { id: true, name: true }
		}),
		prisma.category.findMany({
			orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
			take: 6,
			select: { id: true, name: true }
		})
	]);
}
const shouldShowInterestOnboarding = recommendationProfile?.onboardingCompletedAt === null;
---

<HomeLayout title="首页">
	<section class="home-hero">
		<div class="home-hero-copy">
			<!-- html 仅来自服务端受限 Markdown 渲染器，浏览器不解析原始 Markdown。 -->
			<div class="site-copy-content site-copy-content-home" set:html={heroCopy.html} />
			<div class="home-hero-actions">
				{
					currentUser ? (
						<a class="btn btn-primary" href="#home-feed">
							浏览热门内容
						</a>
					) : (
						<a class="btn btn-primary" href="/register">
							加入睦谈
						</a>
					)
				}
				<a class="btn btn-outline" href="#home-channels">探索频道</a>
			</div>
		</div>
		<aside class="home-preview" aria-labelledby="hero-trending-title">
			<div class="home-preview-head">
				<h2 id="hero-trending-title">正在被讨论</h2>
				<span>全站热门</span>
			</div>
			{
				heroTrending.length > 0 ? (
					<div class="home-preview-grid">
						{heroTrending.map((post) => (
							<a class="home-preview-item" href={`/${post.user.username}/${post.id}`}>
								<span class="home-preview-mark" aria-hidden="true">
									{modeLabels[post.mode]!.slice(0, 1)}
								</span>
								<span class="home-preview-copy">
									<strong>{post.title || post.content.slice(0, 30)}</strong>
									<small>
										{modeLabels[post.mode]} ·{' '}
										{post._count.comments > 0
											? `${post._count.comments} 条讨论`
											: '近期更新'}
									</small>
								</span>
							</a>
						))}
					</div>
				) : (
					<p class="home-preview-empty">新的讨论正在出现。</p>
				)
			}
		</aside>
	</section>

	<section class="home-channels" id="home-channels" aria-labelledby="home-channels-title">
		<div class="home-section-heading">
			<div>
				<p class="home-eyebrow">三种表达方式</p><h2 id="home-channels-title">
					从你喜欢的方式开始
				</h2>
			</div>
			<a href="#home-feed">浏览全站动态 <span aria-hidden="true">→</span></a>
		</div>
		<div class="home-channel-grid">
			<a class="home-channel home-channel-featured" href="/weibo"
				><span>即时交流</span><h3>微博</h3><p>短小、及时，和朋友保持同频。</p></a
			>
			<a class="home-channel" href="/forum"
				><span>持续讨论</span><h3>论坛</h3><p>找到同好，把观点慢慢讲清楚。</p></a
			>
			<a class="home-channel" href="/blog"
				><span>深度沉淀</span><h3>博客</h3><p>阅读与写作，都有安静的空间。</p></a
			>
		</div>
	</section>

	<section class="home-feed" id="home-feed" aria-labelledby="home-feed-title">
		<div class="home-header">
			<h2 id="home-feed-title">正在被讨论</h2>
			<p>{currentUser ? '为你精选的全站好内容' : '全站热门内容，登录后获取个性化推荐'}</p>
		</div>

		{
			!hasPosts ? (
				<div class="empty-state">
					<p>还没有任何动态，注册后发第一条吧！</p>
				</div>
			) : (
				<div class="post-list">
					{posts.map(async (post) => {
						// 提取标签列表
						const postTags = post.tags.map((pt) => ({
							id: pt.tag.id,
							name: pt.tag.name
						}));
						// 点赞数和评论数
						const postLikeCount = post._count.likes;
						const postCommentCount = post._count.comments;
						const postLiked = likedPostIds.has(post.id);
						const postBookmarked = bookmarkedPostIds.has(post.id);

						// 检查当前用户是否有权查看帖子内容
						const isPostRestricted = !(await checkPostVisibility(
							{
								visibility: post.visibility,
								userId: post.userId,
								passwordHash: post.passwordHash,
								allowedUserIds: post.allowedUserIds
							},
							currentUser ? { userId: currentUser.userId } : null,
							{
								isFollower: followingIds.includes(post.userId),
								isFollowing: followerIds.includes(post.userId)
							}
						));

						return (
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: {
										id: post.user.id,
										username: post.user.username,
										displayName: post.user.displayName,
										avatarUrl: post.user.avatarUrl
									},
									media: post.media,
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={renderMarkdown(post.content)}
								likeCount={postLikeCount}
								liked={postLiked}
								commentCount={postCommentCount}
								bookmarkCount={post._count.bookmarks}
								bookmarked={postBookmarked}
								showFollow={!!currentUser}
								following={followingIds.includes(post.user.id)}
								isSelf={currentUser?.userId === post.user.id}
								tags={postTags}
								isRestricted={isPostRestricted}
							/>
						);
					})}
				</div>
			)
		}
	</section>

	{/* 为登录用户提供独立状态的帖子与用户推荐。 */}
	{
		canShowRecommendations && (
			<section class="recommend-section" aria-labelledby="recommend-title">
				<div class="recommend-section-header">
					<div>
						<p class="home-eyebrow">为你准备</p>
						<h2 id="recommend-title">从感兴趣的话题，认识这里的人</h2>
						<p class="recommend-section-lede">
							内容与创作者各自加载，不影响你继续浏览全站动态。
						</p>
					</div>
					<a class="recommend-all-link" href="#home-feed">
						全站动态 <span aria-hidden="true">→</span>
					</a>
				</div>
				{shouldShowInterestOnboarding && (
					<section
						class="interest-onboarding"
						id="interest-onboarding"
						aria-labelledby="interest-onboarding-title"
					>
						<div class="interest-onboarding-copy">
							<h3 id="interest-onboarding-title">先选几个感兴趣的话题？</h3>
							<p>可多选，也可以跳过；这不会阻止你浏览或发布。</p>
						</div>
						<div class="interest-option-groups">
							{interestTags.length > 0 && (
								<div class="interest-option-list">
									{interestTags.map((tag) => (
										<button
											type="button"
											class="interest-option"
											aria-pressed="false"
											data-interest-kind="tag"
											data-interest-id={tag.id}
										>
											#{tag.name}
										</button>
									))}
								</div>
							)}
							{interestCategories.length > 0 && (
								<div class="interest-option-list">
									{interestCategories.map((category) => (
										<button
											type="button"
											class="interest-option"
											aria-pressed="false"
											data-interest-kind="category"
											data-interest-id={category.id}
										>
											{category.name}
										</button>
									))}
								</div>
							)}
							{interestTags.length === 0 && interestCategories.length === 0 && (
								<p class="interest-options-empty">
									社区正在准备话题；你可以直接开始浏览。
								</p>
							)}
						</div>
						<div class="interest-onboarding-actions">
							<button type="button" class="btn btn-primary" data-interest-save>
								开始看看
							</button>
							<button type="button" class="btn btn-quiet" data-interest-skip>
								跳过
							</button>
						</div>
						<p
							class="interest-feedback"
							role="status"
							aria-live="polite"
							data-interest-feedback
						/>
					</section>
				)}
				<div class="recommend-grid">
					<section
						class="recommend-panel"
						id="recommend-posts-panel"
						aria-labelledby="recommend-posts-title"
					>
						<div class="recommend-panel-head">
							<>
								<h3 id="recommend-posts-title">内容推荐</h3>
								<span>依据你的兴趣与全站热度</span>
							</>
						</div>
						<div
							class="recommend-status"
							id="recommend-posts-status"
							role="status"
							aria-live="polite"
						>
							正在加载推荐帖子…
						</div>
						<div class="recommend-list" id="recommend-posts-list">
							{Array.from({ length: 4 }).map(() => (
								<div
									class="recommend-skeleton recommend-post-skeleton"
									aria-hidden="true"
								/>
							))}
						</div>
					</section>
					<section
						class="recommend-panel"
						id="recommend-users-panel"
						aria-labelledby="recommend-users-title"
					>
						<div class="recommend-panel-head">
							<>
								<h3 id="recommend-users-title">推荐创作者</h3>
								<span>可随时关注</span>
							</>
						</div>
						<div
							class="recommend-status"
							id="recommend-users-status"
							role="status"
							aria-live="polite"
						>
							正在加载推荐用户…
						</div>
						<div class="recommend-user-list" id="recommend-users-list">
							{Array.from({ length: 3 }).map(() => (
								<div
									class="recommend-skeleton recommend-user-skeleton"
									aria-hidden="true"
								/>
							))}
						</div>
						<p
							class="recommend-feedback"
							id="recommend-users-feedback"
							role="status"
							aria-live="polite"
						/>
					</section>
				</div>
			</section>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a href={`/?page=${safePage - 1}`} class="pagination-btn pagination-prev">
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a href={`/?page=${safePage + 1}`} class="pagination-btn pagination-next">
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</HomeLayout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
		padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
	}

	.home-eyebrow {
		margin: 0 0 var(--spacing-3);
		color: var(--color-primary);
		font-size: 0.8125rem;
		font-weight: 750;
		letter-spacing: 0.06em;
	}

	.home-title {
		max-width: 740px;
		font-size: clamp(2.625rem, 5.2vw, 4.75rem);
		font-weight: 800;
		letter-spacing: -0.075em;
		line-height: 1.04;
		text-wrap: balance;
	}

	.home-lede {
		max-width: 580px;
		margin: var(--spacing-5) 0 var(--spacing-6);
		color: var(--color-muted);
		font-size: 1.125rem;
		line-height: 1.7;
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.home-preview {
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-card-bg);
		box-shadow: var(--shadow-xl);
	}

	.home-preview-chrome {
		display: flex;
		gap: 6px;
		margin-bottom: var(--spacing-4);
	}
	.home-preview-chrome span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-border);
	}
	.home-preview-item {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr);
		gap: var(--spacing-3);
		padding: var(--spacing-4) 0;
		border-top: 1px solid var(--color-border);
	}
	.home-preview-item:first-of-type {
		border-top: 0;
	}
	.home-preview-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--color-primary) 10%, transparent);
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
	}
	.home-preview-item strong,
	.home-preview-item small {
		display: block;
	}
	.home-preview-item strong {
		font-size: 0.9375rem;
	}
	.home-preview-item small {
		margin-top: 2px;
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.home-channels {
		margin: 0 calc(50% - 50vw);
		padding: var(--spacing-10) max(var(--spacing-6), calc((100vw - var(--layout-home)) / 2));
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}
	.home-section-heading,
	.home-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: var(--spacing-4);
	}
	.home-section-heading {
		max-width: var(--layout-home);
		margin: 0 auto var(--spacing-5);
	}
	.home-section-heading h2,
	.home-header h2 {
		font-size: 1.5625rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	.home-section-heading a {
		font-size: 0.875rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.home-channel-grid {
		display: grid;
		grid-template-columns: 1.25fr 1fr 1fr;
		gap: var(--spacing-4);
		max-width: var(--layout-home);
		margin: 0 auto;
	}
	.home-channel {
		display: flex;
		min-height: 178px;
		flex-direction: column;
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-card-bg);
		color: var(--color-text);
	}
	.home-channel:hover {
		color: var(--color-text);
		border-color: var(--color-primary);
	}
	.home-channel > span {
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
	}
	.home-channel h3 {
		margin: auto 0 var(--spacing-1);
		font-size: 1.25rem;
		letter-spacing: -0.03em;
	}
	.home-channel p {
		color: var(--color-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.home-channel-featured {
		border-color: var(--color-primary);
		background: var(--color-primary);
		color: var(--color-primary-foreground);
	}
	.home-channel-featured > span,
	.home-channel-featured p {
		color: var(--color-primary-foreground);
	}

	.home-feed {
		max-width: 1000px;
		margin: 0 auto;
		padding: var(--spacing-10) 0 0;
	}
	/* 首页内容流标题 */
	.home-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border);
	}
	.home-header p {
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	/* 登录后的个性化推荐区域与首页内容轴对齐。 */
	.recommend-section {
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border);
	}
	.recommend-section-header {
		margin-bottom: var(--spacing-5);
	}
	.recommend-section-header h2 {
		font-size: 1.5625rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	.recommend-section-lede {
		max-width: 42rem;
		margin: var(--spacing-2) 0 0;
		color: var(--color-muted);
	}
	.interest-onboarding {
		display: grid;
		grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.5fr) auto;
		gap: var(--spacing-4);
		align-items: center;
		margin-bottom: var(--spacing-5);
		padding: var(--spacing-4) var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.interest-onboarding h3 {
		font-size: 1rem;
		font-weight: 800;
	}
	.interest-onboarding-copy .home-eyebrow {
		margin-bottom: var(--spacing-1);
	}
	.interest-onboarding-copy p:last-child {
		margin: var(--spacing-1) 0 0;
		color: var(--color-muted);
		font-size: 0.8125rem;
	}
	.interest-option-groups {
		display: grid;
