---
/**
 * 登录页面
 *
 * 纯 Astro 实现，不依赖 React 组件。
 * 表单提交逻辑通过 <script> 处理。
 */
import BaseLayout from '@/layouts/Base.astro';
import '@/styles/pages/login.css';
import { getPublicSiteCopy } from '@/services/site-copy.service';

const introCopy = await getPublicSiteCopy('auth.login.intro');
---

<BaseLayout title="登录" narrow>
	<div class="auth-page-shell">
		<section class="auth-page-intro">
			<!-- html 仅来自服务端受限 Markdown 渲染器，浏览器不解析原始 Markdown。 -->
			<div class="site-copy-content site-copy-content-auth" set:html={introCopy.html} />
		</section>
		<section class="auth-page" aria-labelledby="login-title">
			<h2 id="login-title" class="auth-title">登录</h2>
			<p class="auth-panel-lead">使用你的账号继续。</p>

			<form id="login-form" class="auth-form">
				<div class="form-group">
					<label for="email" class="form-label"> 邮箱 </label>
					<input
						type="email"
						id="email"
						name="email"
						class="form-input"
						placeholder="请输入邮箱"
						required
						autocomplete="username"
						aria-describedby="form-error"
					/>
				</div>

				<div class="form-group">
					<label for="password" class="form-label"> 密码 </label>
					<input
						type="password"
						id="password"
						name="password"
						class="form-input"
						placeholder="请输入密码"
						required
						autocomplete="current-password"
						aria-describedby="form-error"
					/>
				</div>

				<div id="form-error" class="form-error" role="alert" aria-live="assertive"></div>

				<button type="submit" id="submit-btn" class="btn btn-primary auth-submit">
					登录
				</button>
			</form>

			<section
				id="verification-help"
				class="verification-help"
				aria-labelledby="verification-help-title"
				hidden
			>
				<h2 id="verification-help-title">请先验证邮箱</h2>
				<p>
					未验证的账号暂不能登录或使用完整功能。请前往邮箱打开验证链接，或重新发送验证邮件。
				</p>
				<form id="login-resend-form" class="verification-resend-form">
					<label for="resend-email" class="form-label">邮箱</label>
					<div class="verification-resend-controls">
						<input
							type="email"
							id="resend-email"
							class="form-input"
							autocomplete="email"
							required
						/>
						<button type="submit" class="btn btn-outline">重新发送</button>
					</div>
					<p id="login-resend-status" class="form-hint" role="status" aria-live="polite">
					</p>
				</form>
			</section>

			<p class="auth-footer">
				<a href="/forgot-password">忘记密码？</a> · 还没有账号？<a href="/register"
					>立即注册</a
				>
			</p>
		</section>
	</div>
</BaseLayout>

<script src="../scripts/pages/login.ts"></script>
