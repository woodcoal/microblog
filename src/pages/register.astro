---
/**
 * 注册页面
 *
 * 读取 ALLOW_REGISTRATION 环境变量判断是否允许注册。
 * 如果注册已关闭，显示提示信息；否则显示注册表单。
 */
import BaseLayout from '@/layouts/Base.astro';
import { PASSWORD_MIN_LENGTH, ALLOW_REGISTRATION, SITE_TITLE } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';

// 从环境变量读取是否允许注册
const allowRegistration = ALLOW_REGISTRATION;
const introCopy = await getPublicSiteCopy('auth.register.intro');
---

<BaseLayout title="注册" narrow noindex>
	<div class="auth-page-shell">
		<section class="auth-page-intro">
			<!-- html 仅来自服务端受限 Markdown 渲染器，浏览器不解析原始 Markdown。 -->
			<div class="site-copy-content site-copy-content-auth" set:html={introCopy.html} />
		</section>
		<section class="auth-page" aria-labelledby="register-title">
			<h2 id="register-title" class="auth-title">创建账号</h2>
			<p class="auth-panel-lead">创建一个{SITE_TITLE}账号，开始参与讨论。</p>

			{
				allowRegistration ? (
					<>
						<form id="register-form" class="auth-form">
							<div class="form-group">
								<label for="username" class="form-label">
									用户名
								</label>
								<input
									type="text"
									id="username"
									name="username"
									class="form-input"
									placeholder="3-20 位字母、数字、下划线"
									minlength="3"
									maxlength="20"
									pattern="[a-zA-Z0-9_]{3,20}"
									autocomplete="off"
									aria-describedby="username-error username-hint"
								/>
								<div id="username-error" class="form-error" role="alert" />
								<div id="username-hint" class="form-hint" aria-live="polite">
									留空将由系统自动生成唯一用户名（如 u_xxxx）。
								</div>
							</div>

							<div class="form-group">
								<label for="displayName" class="form-label">
									显示名称
								</label>
								<input
									type="text"
									id="displayName"
									name="displayName"
									class="form-input"
									placeholder="你的昵称"
									required
									maxlength="50"
									autocomplete="off"
								/>
							</div>

							<div class="form-group">
								<label for="email" class="form-label">
									邮箱
								</label>
								<input
									type="email"
									id="email"
									name="email"
									class="form-input"
									placeholder="your@email.com"
									required
									autocomplete="email"
									aria-describedby="email-error"
								/>
								<div id="email-error" class="form-error" role="alert" />
							</div>

							<div class="form-group">
								<label for="password" class="form-label">
									密码
								</label>
								<input
									type="password"
									id="password"
									name="password"
									class="form-input"
									placeholder={`至少 ${PASSWORD_MIN_LENGTH} 位`}
									required
									minlength={PASSWORD_MIN_LENGTH}
									autocomplete="new-password"
									aria-describedby="password-hint"
								/>
								<div id="password-hint" class="form-hint" aria-live="polite" />
							</div>

							<div class="form-group">
								<label for="confirmPassword" class="form-label">
									确认密码
								</label>
								<input
									type="password"
									id="confirmPassword"
									name="confirmPassword"
									class="form-input"
									placeholder="再次输入密码"
									required
									autocomplete="new-password"
									aria-describedby="confirm-error confirm-hint"
								/>
								<div id="confirm-error" class="form-error" role="alert" />
								<div id="confirm-hint" class="form-hint" aria-live="polite" />
							</div>

							<div
								id="form-error"
								class="form-error"
								role="alert"
								aria-live="assertive"
							/>

							<button
								type="submit"
								id="submit-btn"
								class="btn btn-primary auth-submit"
							>
								注册
							</button>
						</form>

						<section
							id="registration-success"
							class="verification-panel"
							tabindex="-1"
							hidden
							aria-labelledby="registration-success-title"
						>
							<h3 id="registration-success-title">请验证你的邮箱</h3>
							<p>
								验证邮件已发送。账号在完成邮箱验证前无法登录或使用完整功能，请前往邮箱打开验证链接。
							</p>
							<form id="registration-resend-form" class="verification-resend-form">
								<label for="registration-resend-email" class="form-label">
									未收到邮件？
								</label>
								<div class="verification-resend-controls">
									<input
										type="email"
										id="registration-resend-email"
										class="form-input"
										autocomplete="email"
										required
									/>
									<button type="submit" class="btn btn-outline">
										重新发送
									</button>
								</div>
								<p
									id="registration-resend-status"
									class="form-hint"
									role="status"
									aria-live="polite"
								/>
							</form>
						</section>
					</>
				) : (
					<div class="registration-closed">
						<p class="registration-closed-title">注册已关闭</p>
						<p class="registration-closed-hint">
							管理员已关闭新用户注册，请联系管理员获取邀请。
						</p>
						<a href="/login" class="btn btn-outline">
							返回登录
						</a>
					</div>
				)
			}

			{
				allowRegistration && (
					<p class="auth-footer">
						已有账号？<a href="/login">登录</a>
					</p>
				)
			}
		</section>
	</div>
</BaseLayout>

<style>
	.form-hint {
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-top: 0.25rem;
		display: none;
	}
	.form-hint-visible {
		display: block;
	}
	.form-hint-ok {
		color: var(--color-success);
	}
	.form-hint-err {
		color: var(--color-danger);
	}

	.registration-closed {
		text-align: center;
		padding: var(--spacing-6) 0;
	}

	.registration-closed-title {
		font-size: 1.125rem;
		font-weight: 600;
		margin-bottom: var(--spacing-2);
	}

	.registration-closed-hint {
		font-size: 0.875rem;
		color: var(--color-muted);
		font-weight: 400;
		margin-bottom: var(--spacing-6);
	}

	.verification-panel {
		margin-top: var(--spacing-5);
		padding: var(--spacing-4);
		border: 1px solid color-mix(in srgb, var(--color-success) 45%, var(--color-border));
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--color-success) 7%, var(--color-card-bg));
	}

	.verification-panel h3 {
		margin: 0 0 var(--spacing-2);
		font-size: 1rem;
	}

	.verification-panel p {
		margin: 0;
		color: var(--color-muted);
	}

	.verification-resend-form {
		margin-top: var(--spacing-4);
	}

	.verification-resend-controls {
		display: flex;
		gap: var(--spacing-2);
		margin-top: var(--spacing-1);
	}

	.verification-resend-controls .form-input {
		min-width: 0;
	}

	@media (max-width: 480px) {
		.verification-resend-controls {
			flex-direction: column;
		}
	}
</style>

<script>
	import { actions } from 'astro:actions';

	const form = document.getElementById('register-form') as HTMLFormElement;

	// 字段引用
	const usernameInput = document.getElementById('username') as HTMLInputElement;
	const displayNameInput = document.getElementById('displayName') as HTMLInputElement;
	const emailInput = document.getElementById('email') as HTMLInputElement;
	const passwordInput = document.getElementById('password') as HTMLInputElement;
	const confirmInput = document.getElementById('confirmPassword') as HTMLInputElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const errorEl = document.getElementById('form-error')!;
	const usernameError = document.getElementById('username-error')!;
	const emailError = document.getElementById('email-error')!;
	const confirmError = document.getElementById('confirm-error')!;
	const usernameHint = document.getElementById('username-hint')!;
	const passwordHint = document.getElementById('password-hint')!;
	const confirmHint = document.getElementById('confirm-hint')!;
	const successPanel = document.getElementById('registration-success') as HTMLElement;
	const resendForm = document.getElementById('registration-resend-form') as HTMLFormElement;
	const resendEmailInput = document.getElementById(
		'registration-resend-email'
	) as HTMLInputElement;
	const resendStatus = document.getElementById('registration-resend-status')!;

	/**
	 * 清除指定字段的错误提示
	 */
	function clearFieldError(el: HTMLElement) {
		el.textContent = '';
		el.classList.remove('form-hint-ok', 'form-hint-err');
	}

	/**
	 * 显示字段提示信息
	 */
	function showFieldHint(el: HTMLElement, msg: string, ok: boolean) {
		el.textContent = msg;
		el.className = 'form-hint form-hint-visible' + (ok ? ' form-hint-ok' : ' form-hint-err');
	}

	// 用户名实时校验
	if (usernameInput) {
		usernameInput.addEventListener('input', () => {
			clearFieldError(usernameError);
			clearFieldError(usernameHint);
			const v = usernameInput.value.trim();
			if (!v) return;
			if (!/^[a-zA-Z0-9_]{3,20}$/.test(v)) {
				showFieldHint(usernameHint, '需为 3-20 位字母、数字或下划线', false);
			} else {
				showFieldHint(usernameHint, '格式符合要求，将由服务器确认是否可用', true);
			}
		});
	}

	// 密码强度即时提示
	if (passwordInput) {
		passwordInput.addEventListener('input', () => {
			const v = passwordInput.value;
			if (!v) {
				clearFieldError(passwordHint);
				return;
			}
			if (v.length < Number(passwordInput.getAttribute('minlength') || 6)) {
				showFieldHint(passwordHint, '密码长度不足', false);
			} else {
				showFieldHint(passwordHint, '密码强度足够', true);
			}
		});
	}

	// 确认密码即时校验
	if (confirmInput) {
		confirmInput.addEventListener('input', () => {
			clearFieldError(confirmError);
			const v = confirmInput.value;
			if (!v) {
				clearFieldError(confirmHint);
				return;
			}
			if (v !== passwordInput.value) {
				showFieldHint(confirmHint, '两次密码不一致', false);
			} else {
				showFieldHint(confirmHint, '密码一致', true);
			}
		});
	}

	// 失焦时清除 hint（减少干扰）
	[usernameInput, confirmInput].forEach((el) => {
		el?.addEventListener('blur', () => {
			const hintId = el.id === 'confirmPassword' ? 'confirm-hint' : el.id + '-hint';
			clearFieldError(document.getElementById(hintId) || el);
		});
	});
	if (passwordInput) {
		passwordInput.addEventListener('blur', () => clearFieldError(passwordHint));
	}

	// 聚焦显示名称
	if (displayNameInput) {
		displayNameInput.focus();
	}

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			const username = usernameInput.value.trim();
			const displayName = displayNameInput.value.trim();
			const email = emailInput.value.trim();
			const password = passwordInput.value;
			const confirmPassword = confirmInput.value;

			// 清除之前的错误
			clearFieldError(errorEl);
			clearFieldError(usernameError);
			clearFieldError(emailError);
			clearFieldError(confirmError);

			// 仅在填写时提供格式反馈；保留词、占用和最终可用性均由服务端裁决。
			if (username && !/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
				usernameError.textContent = '用户名需为 3-20 位字母、数字或下划线';
				usernameInput.focus();
				return;
			}

			// 前端验证：密码确认
			if (password !== confirmPassword) {
				confirmError.textContent = '两次输入的密码不一致';
				confirmInput.focus();
				return;
			}

			// 禁用按钮防重复提交
			submitBtn.disabled = true;
			submitBtn.textContent = '注册中...';

			try {
				// 调用 Astro Action 注册
				// Astro 6 Actions 返回 SafeResult：{ data, error }
				const result = await actions.register({
					username: username || undefined,
					displayName,
					email,
					password
				});

				// 检查是否返回错误
				if (result.error) {
					errorEl.textContent = result.error.message || '注册失败，请重试';
					return;
				}

				// 注册不会建立会话；邮箱验证完成后才能登录并使用完整能力。
				successPanel.hidden = false;
				resendEmailInput.value = email;
				form.reset();
				successPanel.focus();
			} catch (e) {
				// ActionError 通过 e.message 获取错误信息
				errorEl.textContent = e instanceof Error ? e.message : '注册失败，请重试';
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = '注册';
			}
		});
	}

	if (resendForm) {
		resendForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			const email = resendEmailInput.value.trim();
			const button = resendForm.querySelector('button') as HTMLButtonElement;
			resendStatus.textContent = '';
			if (!email) {
				resendStatus.textContent = '请输入邮箱地址。';
				resendEmailInput.focus();
				return;
			}
			button.disabled = true;
			button.textContent = '发送中...';
			try {
				const result = await actions.resendVerification({ email });
				resendStatus.textContent = result.error
					? result.error.message || '暂时无法发送，请稍后再试。'
					: result.data?.message || '若邮箱可用，验证邮件已发送。';
			} catch {
				resendStatus.textContent = '网络连接异常，请检查后重试。';
			} finally {
				button.disabled = false;
				button.textContent = '重新发送';
			}
		});
	}
</script>
