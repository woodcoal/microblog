---
/**
 * 注册页面
 *
 * 读取 ALLOW_REGISTRATION 环境变量判断是否允许注册。
 * 如果注册已关闭，显示提示信息；否则显示注册表单。
 */
import BaseLayout from '@/layouts/Base.astro';
import '@/styles/pages/register.css';
import { PASSWORD_MIN_LENGTH, ALLOW_REGISTRATION, SITE_TITLE } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';

// 从环境变量读取是否允许注册
const allowRegistration = ALLOW_REGISTRATION;
const introCopy = await getPublicSiteCopy('auth.register.intro');
---

<BaseLayout title="注册" narrow>
	<div class="auth-page-shell">
		<section class="auth-page-intro">
			<!-- html 仅来自服务端受限 Markdown 渲染器，浏览器不解析原始 Markdown。 -->
			<div class="site-copy-content site-copy-content-auth" set:html={introCopy.html} />
		</section>
		<section class="auth-page" aria-labelledby="register-title">
			<h2 id="register-title" class="auth-title">创建账号</h2>
			<p class="auth-panel-lead">创建一个{SITE_TITLE}账号，开始参与讨论。</p>

			{
				allowRegistration ? (
					<>
						<form id="register-form" class="auth-form">
							<div class="form-group">
								<label for="email" class="form-label">
									邮箱
								</label>
								<input
									type="email"
									id="email"
									name="email"
									class="form-input"
									placeholder="your@email.com"
									required
									autocomplete="email"
									aria-describedby="email-error"
								/>
								<div id="email-error" class="form-error" role="alert" />
							</div>

							<div class="form-group">
								<label for="password" class="form-label">
									密码
								</label>
								<input
									type="password"
									id="password"
									name="password"
									class="form-input"
									placeholder={`至少 ${PASSWORD_MIN_LENGTH} 位`}
									required
									minlength={PASSWORD_MIN_LENGTH}
									autocomplete="new-password"
									aria-describedby="password-hint"
								/>
								<div id="password-hint" class="form-hint" aria-live="polite" />
							</div>

							<div class="form-group">
								<label for="confirmPassword" class="form-label">
									确认密码
								</label>
								<input
									type="password"
									id="confirmPassword"
									name="confirmPassword"
									class="form-input"
									placeholder="再次输入密码"
									required
									autocomplete="new-password"
									aria-describedby="confirm-error confirm-hint"
								/>
								<div id="confirm-error" class="form-error" role="alert" />
								<div id="confirm-hint" class="form-hint" aria-live="polite" />
							</div>

							<details class="form-group username-optional">
								<summary>设置用户名（可选）</summary>
								<label for="username" class="form-label">
									用户名
								</label>
								<input
									type="text"
									id="username"
									name="username"
									class="form-input"
									placeholder="3-20 位字母、数字、下划线"
									minlength="3"
									maxlength="20"
									pattern="[a-zA-Z0-9_]{3,20}"
									autocomplete="off"
									aria-describedby="username-error username-hint"
								/>
								<div id="username-error" class="form-error" role="alert" />
								<div id="username-hint" class="form-hint" aria-live="polite">
									留空将由系统自动生成唯一用户名（如
									u_xxxx），不消耗后续一次自助改名机会。
								</div>
							</details>

							<div
								id="form-error"
								class="form-error"
								role="alert"
								aria-live="assertive"
							/>

							<button
								type="submit"
								id="submit-btn"
								class="btn btn-primary auth-submit"
							>
								注册
							</button>
						</form>

						<section
							id="registration-success"
							class="verification-panel"
							tabindex="-1"
							hidden
							aria-labelledby="registration-success-title"
						>
							<h3 id="registration-success-title">注册已受理</h3>
							<p id="registration-success-message">
								验证邮件已发送。账号在完成邮箱验证前无法登录或使用完整功能，请前往邮箱打开验证链接。
							</p>
							<form id="registration-resend-form" class="verification-resend-form">
								<label for="registration-resend-email" class="form-label">
									未收到邮件？
								</label>
								<div class="verification-resend-controls">
									<input
										type="email"
										id="registration-resend-email"
										class="form-input"
										autocomplete="email"
										required
									/>
									<button type="submit" class="btn btn-outline">
										重新发送
									</button>
								</div>
								<p
									id="registration-resend-status"
									class="form-hint"
									role="status"
									aria-live="polite"
								/>
								<p class="form-hint" style="margin-top: var(--spacing-2);">
									多次重发仍未收到邮件时，可能是站点邮件系统尚未配置，请联系站点管理员。
								</p>
							</form>
						</section>
					</>
				) : (
					<div class="registration-closed">
						<p class="registration-closed-title">注册已关闭</p>
						<p class="registration-closed-hint">
							管理员已关闭新用户注册，请联系管理员获取邀请。
						</p>
						<a href="/login" class="btn btn-outline">
							返回登录
						</a>
					</div>
				)
			}

			{
				allowRegistration && (
					<p class="auth-footer">
						已有账号？<a href="/login">登录</a>
					</p>
				)
			}
		</section>
	</div>
</BaseLayout>

<script src="../scripts/pages/register.ts"></script>
