---
/** 重置密码落地页。令牌有效性与单次消费均由服务端 Action 决定。 */
import BaseLayout from '@/layouts/Base.astro';
import { PASSWORD_MIN_LENGTH } from '@/lib/config';
import '@/styles/pages/reset-password.css';

const token = Astro.url.searchParams.get('token') ?? '';
---

<BaseLayout title="设置新密码" narrow noindex>
	<section
		class="auth-page password-reset-page"
		data-reset-token={token}
		aria-labelledby="reset-password-title"
	>
		<h1 id="reset-password-title" class="auth-title">设置新密码</h1>
		<section
			id="reset-password-action"
			class="password-reset-state"
			role="status"
			hidden
			tabindex="-1"
		>
			<h2>需要重置链接</h2>
			<p>请从重置邮件中打开完整链接，再设置新密码。</p>
			<a href="/forgot-password" class="btn btn-outline">请求新的重置链接</a>
		</section>

		<form
			id="reset-password-form"
			class="auth-form"
			aria-describedby="reset-password-status"
			hidden
		>
			<p class="auth-panel-lead">
				设置完成后，你需要使用新密码重新登录；其他设备和旧凭据将立即失效。
			</p>
			<div class="form-group">
				<label for="password" class="form-label">新密码</label>
				<input
					type="password"
					id="password"
					name="password"
					class="form-input"
					placeholder={`至少 ${PASSWORD_MIN_LENGTH} 位`}
					required
					minlength={PASSWORD_MIN_LENGTH}
					autocomplete="new-password"
				/>
			</div>
			<div class="form-group">
				<label for="confirm-password" class="form-label">确认新密码</label>
				<input
					type="password"
					id="confirm-password"
					name="confirmPassword"
					class="form-input"
					placeholder="再次输入新密码"
					required
					minlength={PASSWORD_MIN_LENGTH}
					autocomplete="new-password"
				/>
			</div>
			<button type="submit" id="reset-password-submit" class="btn btn-primary auth-submit">
				保存新密码
			</button>
		</form>

		<section
			id="reset-password-success"
			class="password-reset-state password-reset-success"
			role="status"
			hidden
			tabindex="-1"
		>
			<h2>密码已重置</h2>
			<p>
				请使用新密码重新登录。为保护账户，其他设备上的登录状态和旧的 API Token、Webhook
				凭据已失效。
			</p>
			<a href="/login" class="btn btn-primary">前往登录</a>
		</section>
		<section
			id="reset-password-invalid"
			class="password-reset-state password-reset-error"
			role="alert"
			hidden
			tabindex="-1"
		>
			<h2>重置链接无效或已失效</h2>
			<p>链接可能已过期、已使用或不完整。请请求新的重置链接后再试。</p>
			<a href="/forgot-password" class="btn btn-outline">请求新的重置链接</a>
		</section>
		<p id="reset-password-status" class="form-error" role="alert" aria-live="assertive"></p>
		<p class="auth-footer"><a href="/login">返回登录</a></p>
	</section>
</BaseLayout>

<script src="../scripts/pages/reset-password.ts"></script>
