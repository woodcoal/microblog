---
/** 重置密码落地页。令牌有效性与单次消费均由服务端 Action 决定。 */
import BaseLayout from '@/layouts/Base.astro';
import { PASSWORD_MIN_LENGTH } from '@/lib/config';

const token = Astro.url.searchParams.get('token') ?? '';
---

<BaseLayout title="设置新密码" narrow noindex>
	<section
		class="auth-page password-reset-page"
		data-reset-token={token}
		aria-labelledby="reset-password-title"
	>
		<h1 id="reset-password-title" class="auth-title">设置新密码</h1>
		<div id="reset-password-action" class="password-reset-state" hidden>
			<h2>需要重置链接</h2>
			<p>请从重置邮件中打开完整链接，再设置新密码。</p>
			<a href="/forgot-password" class="btn btn-outline">请求新的重置链接</a>
		</div>

		<form
			id="reset-password-form"
			class="auth-form"
			aria-describedby="reset-password-status"
			hidden
		>
			<p class="auth-panel-lead">
				设置完成后，你需要使用新密码重新登录；其他设备和旧凭据将立即失效。
			</p>
			<div class="form-group">
				<label for="password" class="form-label">新密码</label>
				<input
					type="password"
					id="password"
					name="password"
					class="form-input"
					placeholder={`至少 ${PASSWORD_MIN_LENGTH} 位`}
					required
					minlength={PASSWORD_MIN_LENGTH}
					autocomplete="new-password"
				/>
			</div>
			<div class="form-group">
				<label for="confirm-password" class="form-label">确认新密码</label>
				<input
					type="password"
					id="confirm-password"
					name="confirmPassword"
					class="form-input"
					placeholder="再次输入新密码"
					required
					minlength={PASSWORD_MIN_LENGTH}
					autocomplete="new-password"
				/>
			</div>
			<button type="submit" id="reset-password-submit" class="btn btn-primary auth-submit">
				保存新密码
			</button>
		</form>

		<section
			id="reset-password-success"
			class="password-reset-state password-reset-success"
			role="status"
			hidden
			tabindex="-1"
		>
			<h2>密码已重置</h2>
			<p>
				请使用新密码重新登录。为保护账户，其他设备上的登录状态和旧的 API Token、Webhook
				凭据已失效。
			</p>
			<a href="/login" class="btn btn-primary">前往登录</a>
		</section>
		<section
			id="reset-password-invalid"
			class="password-reset-state password-reset-error"
			role="alert"
			hidden
			tabindex="-1"
		>
			<h2>重置链接无效或已失效</h2>
			<p>链接可能已过期、已使用或不完整。请请求新的重置链接后再试。</p>
			<a href="/forgot-password" class="btn btn-outline">请求新的重置链接</a>
		</section>
		<p id="reset-password-status" class="form-error" role="alert" aria-live="assertive"></p>
		<p class="auth-footer"><a href="/login">返回登录</a></p>
	</section>
</BaseLayout>

<style>
	.password-reset-state {
		padding: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-card-bg);
	}

	.password-reset-state h2,
	.password-reset-state p {
		margin: 0;
	}

	.password-reset-state p + .btn,
	.password-reset-state .btn {
		display: inline-flex;
		margin-top: var(--spacing-4);
	}

	.password-reset-success {
		border-color: color-mix(in srgb, var(--color-success) 45%, var(--color-border));
	}

	.password-reset-error {
		border-color: color-mix(in srgb, var(--color-danger) 45%, var(--color-border));
	}
</style>

<script>
	import { actions } from 'astro:actions';

	const page = document.querySelector('.password-reset-page') as HTMLElement;
	const token = page.dataset.resetToken ?? '';
	const form = document.getElementById('reset-password-form') as HTMLFormElement;
	const action = document.getElementById('reset-password-action') as HTMLElement;
	const passwordInput = document.getElementById('password') as HTMLInputElement;
	const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
	const submitButton = document.getElementById('reset-password-submit') as HTMLButtonElement;
	const success = document.getElementById('reset-password-success') as HTMLElement;
	const invalid = document.getElementById('reset-password-invalid') as HTMLElement;
	const status = document.getElementById('reset-password-status') as HTMLElement;

	function showState(state: HTMLElement) {
		[action, form, success, invalid].forEach((element) => (element.hidden = element !== state));
		state.focus?.();
	}

	if (!token) showState(action);
	else form.hidden = false;

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		status.textContent = '';
		if (passwordInput.value !== confirmPasswordInput.value) {
			status.textContent = '两次输入的新密码不一致。';
			confirmPasswordInput.focus();
			return;
		}

		submitButton.disabled = true;
		submitButton.textContent = '保存中…';
		try {
			const result = await actions.confirmPasswordReset({
				token,
				password: passwordInput.value
			});
			if (result.error) {
				if (result.error.message === '重置链接无效或已失效') showState(invalid);
				else status.textContent = result.error.message || '暂时无法重置密码，请稍后再试。';
				return;
			}
			showState(success);
		} catch {
			status.textContent = '网络连接异常，请检查后重试。';
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = '保存新密码';
		}
	});
</script>
