---
/**
 * 全局搜索页面
 *
 * 分为"微博"和"用户"两个标签页，
 * 搜索框输入关键词后提交搜索。
 * URL 参数：?q=关键词&tab=posts|users&cursor=xxx&mode=xxx&categoryId=xxx
 * 默认显示微博搜索结果，切换标签页时保持搜索关键词。
 * 支持 mode 过滤（全部/微博/论坛/博客）和分类下拉选择器。
 * 使用 SearchBox 和 SearchResults Astro 组件，完全服务端渲染。
 */
import WeiboLayout from '@/layouts/WeiboLayout.astro';
import SearchBox from '@/components/SearchBox.astro';
import SearchResults from '@/components/SearchResults.astro';
import SearchSuggest from '@/components/SearchSuggest.astro';
import { prisma } from '@/lib/db';

// 解析 URL 参数
const q = Astro.url.searchParams.get('q')?.trim() || '';
const tab = Astro.url.searchParams.get('tab') === 'users' ? 'users' : 'posts';
const cursor = Astro.url.searchParams.get('cursor') || '';
// 排序方式：latest=按时间倒序（默认），popular=按点赞数倒序再按时间倒序
const sort = Astro.url.searchParams.get('sort') === 'popular' ? 'popular' : 'latest';
// mode 过滤：all（全部，默认）、weibo、forum、blog
const modeParam = Astro.url.searchParams.get('mode') || 'all';
const validModes = ['all', 'weibo', 'forum', 'blog'];
const modeFilter = validModes.includes(modeParam) ? modeParam : 'all';
// 分类过滤：categoryId 参数
const categoryIdParam = Astro.url.searchParams.get('categoryId')?.trim() || '';

// 查询分类列表：根据当前 mode 过滤，用于分类下拉选择器
// 当 mode=all 时显示所有分类，否则只显示对应 mode 的分类
const categoryList = await prisma.category.findMany({
	where: {
		...(modeFilter !== 'all' ? { mode: modeFilter } : {})
	},
	orderBy: [{ mode: 'asc' }, { sortOrder: 'asc' }],
	select: {
		id: true,
		name: true,
		slug: true,
		mode: true,
		icon: true,
		parentId: true
	}
});

// 验证 categoryId 是否合法（存在且 mode 匹配）
let categoryIdFilter = '';
if (categoryIdParam) {
	const cat = await prisma.category.findUnique({ where: { id: categoryIdParam } });
	if (cat && (modeFilter === 'all' || cat.mode === modeFilter)) {
		categoryIdFilter = categoryIdParam;
	}
}

// 帖子搜索结果
let posts: any[] = [];
let nextPostsCursor: string | null = null;

// 用户搜索结果
let users: any[] = [];
let nextUsersCursor: string | null = null;

if (q) {
	if (tab === 'posts') {
		// 查询帖子搜索结果
		const where = {
			visibility: 'public',
			isDeleted: false,
			content: { contains: q },
			// 游标分页：只取创建时间早于游标的帖子
			...(cursor ? { createdAt: { lt: new Date(cursor) } } : {}),
			// mode 过滤
			...(modeFilter !== 'all' ? { mode: modeFilter } : {}),
			// 分类过滤
			...(categoryIdFilter ? { categoryId: categoryIdFilter } : {})
		};

		// 根据排序方式决定排序规则
		const orderBy =
			sort === 'popular'
				? [{ likes: { _count: 'desc' as const } }, { createdAt: 'desc' as const }]
				: [{ createdAt: 'desc' as const }];

		const rawPosts = await prisma.post.findMany({
			where,
			orderBy,
			take: 21,
			include: {
				user: {
					select: {
						id: true,
						username: true,
						displayName: true,
						avatarUrl: true
					}
				},
				tags: {
					include: {
						tag: {
							select: {
								id: true,
								name: true
							}
						}
					}
				},
				category: {
					select: {
						id: true,
						name: true,
						slug: true,
						mode: true
					}
				},
				_count: {
					select: { likes: true }
				}
			}
		});

		const hasNextPage = rawPosts.length > 20;
		const items = hasNextPage ? rawPosts.slice(0, 20) : rawPosts;
		nextPostsCursor = hasNextPage ? items[items.length - 1].createdAt.toISOString() : null;

		posts = items.map((post) => ({
			id: post.id,
			content: post.content,
			createdAt: post.createdAt.toISOString(),
			isPinned: post.isPinned,
			isGlobalPinned: post.isGlobalPinned,
			likeCount: post._count.likes,
			mode: post.mode,
			title: post.title,
			categoryId: post.categoryId,
			category: post.category,
			user: {
				id: post.user.id,
				username: post.user.username,
				displayName: post.user.displayName,
				avatarUrl: post.user.avatarUrl
			},
			tags: post.tags.map((pt: any) => ({
				id: pt.tag.id,
				name: pt.tag.name
			}))
		}));
	} else {
		// 查询用户搜索结果
		const where = {
			isDisabled: false,
			OR: [{ username: { contains: q } }, { displayName: { contains: q } }],
			// 游标分页：只取创建时间早于游标的用户
			...(cursor ? { createdAt: { lt: new Date(cursor) } } : {})
		};

		const rawUsers = await prisma.user.findMany({
			where,
			orderBy: [{ createdAt: 'desc' }],
			take: 21,
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true,
				bio: true,
				createdAt: true,
				_count: {
					select: {
						followers: true,
						following: true,
						posts: {
							where: { isDeleted: false, visibility: 'public' }
						}
					}
				}
			}
		});

		const hasNextPage = rawUsers.length > 20;
		const items = hasNextPage ? rawUsers.slice(0, 20) : rawUsers;
		nextUsersCursor = hasNextPage ? items[items.length - 1].createdAt.toISOString() : null;

		users = items.map((user) => ({
			id: user.id,
			username: user.username,
			displayName: user.displayName,
			avatarUrl: user.avatarUrl,
			bio: user.bio,
			followerCount: user._count.followers,
			followingCount: user._count.following,
			postCount: user._count.posts
		}));
	}
}

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const isPostsTab = tab === 'posts';
const isUsersTab = tab === 'users';
const isSortLatest = sort === 'latest';
const isSortPopular = sort === 'popular';
const isModeAll = modeFilter === 'all';
const isModeWeibo = modeFilter === 'weibo';
const isModeForum = modeFilter === 'forum';
const isModeBlog = modeFilter === 'blog';
const hasCategories = categoryList.length > 0;
const hasCategoryId = !!categoryIdFilter;

/** 构建搜索 URL 的辅助函数，保持所有筛选参数 */
function buildSearchUrl(params: {
	q?: string;
	tab?: string;
	sort?: string;
	mode?: string;
	categoryId?: string;
	cursor?: string;
}): string {
	const sp = new URLSearchParams();
	if (params.q !== undefined) sp.set('q', params.q);
	else if (q) sp.set('q', q);
	if (params.tab !== undefined) sp.set('tab', params.tab);
	else if (tab) sp.set('tab', tab);
	if (params.sort !== undefined) sp.set('sort', params.sort);
	else if (sort) sp.set('sort', sort);
	if (params.mode !== undefined) sp.set('mode', params.mode);
	else if (modeFilter) sp.set('mode', modeFilter);
	if (params.categoryId !== undefined) {
		if (params.categoryId) sp.set('categoryId', params.categoryId);
	} else if (categoryIdFilter) {
		sp.set('categoryId', categoryIdFilter);
	}
	if (params.cursor !== undefined && params.cursor) sp.set('cursor', params.cursor);
	return `/search?${sp.toString()}`;
}
---

<WeiboLayout title={q ? `搜索: ${q}` : '搜索'}>
	<h1 class="page-title">搜索</h1>

	<!-- 搜索框 + 实时建议 -->
	<div class="search-box-wrapper">
		<SearchBox
			initialQuery={q}
			placeholder="搜索帖子或用户..."
			tab={tab}
			mode={modeFilter}
			categoryId={categoryIdFilter}
		/>
		<SearchSuggest initialQuery={q} />
	</div>

	<!-- 标签页切换 -->
	<div class="search-tabs">
		<a
			href={buildSearchUrl({ tab: 'posts' })}
			class:list={['search-tab', { 'search-tab-active': isPostsTab }]}
		>
			微博
		</a>
		<a
			href={buildSearchUrl({ tab: 'users' })}
			class:list={['search-tab', { 'search-tab-active': isUsersTab }]}
		>
			用户
		</a>
	</div>

	<!-- 排序切换 + mode 过滤 + 分类选择：仅在帖子标签页显示 -->
	{
		isPostsTab && (
			<div class="search-filters">
				<div class="search-sort">
					<a
						href={buildSearchUrl({ sort: 'latest' })}
						class:list={['search-sort-btn', { 'search-sort-active': isSortLatest }]}
					>
						最新
					</a>
					<a
						href={buildSearchUrl({ sort: 'popular' })}
						class:list={['search-sort-btn', { 'search-sort-active': isSortPopular }]}
					>
						热门
					</a>
				</div>
				<div class="search-mode-filter">
					<a
						href={buildSearchUrl({ mode: 'all', categoryId: '' })}
						class:list={['search-mode-btn', { 'search-mode-active': isModeAll }]}
					>
						全部
					</a>
					<a
						href={buildSearchUrl({ mode: 'weibo', categoryId: '' })}
						class:list={['search-mode-btn', { 'search-mode-active': isModeWeibo }]}
					>
						微博
					</a>
					<a
						href={buildSearchUrl({ mode: 'forum', categoryId: '' })}
						class:list={['search-mode-btn', { 'search-mode-active': isModeForum }]}
					>
						论坛
					</a>
					<a
						href={buildSearchUrl({ mode: 'blog', categoryId: '' })}
						class:list={['search-mode-btn', { 'search-mode-active': isModeBlog }]}
					>
						博客
					</a>
				</div>
			</div>
		)
	}

	<!-- 分类下拉选择器：仅在帖子标签页且有分类时显示 -->
	{
		isPostsTab && hasCategories && (
			<div class="search-category-filter">
				<label for="category-select" class="search-category-label">
					分类：
				</label>
				<select
					id="category-select"
					class="search-category-select"
					data-base-url={buildSearchUrl({ categoryId: '__CATEGORY_ID__' })}
				>
					<option value="" selected={!hasCategoryId}>
						全部分类
					</option>
					{categoryList.map((cat) => {
						const isSelected = cat.id === categoryIdFilter;
						/** 分类模式标签 */
						const modeLabel =
							cat.mode === 'forum' ? '论坛' : cat.mode === 'blog' ? '博客' : '微博';
						return (
							<option value={cat.id} selected={isSelected}>
								[{modeLabel}] {cat.icon ? cat.icon + ' ' : ''}
								{cat.name}
							</option>
						);
					})}
				</select>
			</div>
		)
	}

	<!-- 搜索结果 -->
	<SearchResults
		tab={tab}
		query={q}
		sort={sort}
		modeFilter={modeFilter}
		categoryIdFilter={categoryIdFilter}
		posts={posts}
		nextPostsCursor={nextPostsCursor}
		users={users}
		nextUsersCursor={nextUsersCursor}
	/>
</WeiboLayout>

<style>
	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}
	.search-tabs {
		display: flex;
		gap: 0;
		border-bottom: 2px solid var(--color-border);
		margin-bottom: 1rem;
	}
	.search-tab {
		padding: 0.5rem 1.25rem;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -2px;
		transition:
			color 0.2s,
			border-color 0.2s;
	}
	.search-tab:hover {
		color: var(--color-text);
	}
	.search-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
	}
	.search-sort {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.search-sort-btn {
		padding: 0.25rem 0.75rem;
		font-size: 0.8125rem;
		color: var(--color-muted);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 9999px;
		transition:
			color 0.2s,
			border-color 0.2s,
			background-color 0.2s;
	}
	.search-sort-btn:hover {
		color: var(--color-text);
		border-color: var(--color-text);
	}
	.search-sort-active {
		color: #fff;
		background-color: var(--color-primary);
		border-color: var(--color-primary);
	}
	.search-filters {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 0.75rem;
	}
	.search-mode-filter {
		display: flex;
		gap: 0.375rem;
	}
	.search-mode-btn {
		padding: 0.25rem 0.625rem;
		font-size: 0.8125rem;
		color: var(--color-muted);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 9999px;
		transition:
			color 0.2s,
			border-color 0.2s,
			background-color 0.2s;
	}
	.search-mode-btn:hover {
		color: var(--color-text);
		border-color: var(--color-text);
	}
	.search-mode-active {
		color: #fff;
		background-color: var(--color-primary);
		border-color: var(--color-primary);
	}
	.search-box-wrapper {
		position: relative;
		margin-bottom: 1rem;
	}
	.search-category-filter {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.search-category-label {
		font-size: 0.875rem;
		color: var(--color-muted);
		white-space: nowrap;
	}
	.search-category-select {
		flex: 1;
		max-width: 280px;
		padding: 0.375rem 0.75rem;
		font-size: 0.8125rem;
		color: var(--color-text);
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		outline: none;
		transition: border-color 0.2s;
	}
	.search-category-select:focus {
		border-color: var(--color-primary);
	}
</style>

<script>
	/**
	 * 分类下拉选择器交互
	 *
	 * 选择分类后跳转到对应的搜索 URL，清除分类则跳转到无 categoryId 的 URL。
	 */
	const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
	if (categorySelect) {
		const baseUrl = categorySelect.dataset.baseUrl || '';
		categorySelect.addEventListener('change', () => {
			const selectedId = categorySelect.value;
			if (selectedId) {
				// 替换占位符为实际分类 ID
				window.location.href = baseUrl.replace('__CATEGORY_ID__', selectedId);
			} else {
				// 清除分类：跳转到无 categoryId 的 URL
				window.location.href = baseUrl
					.replace('__CATEGORY_ID__', '')
					.replace(/&?categoryId=$/, '')
					.replace(/\?$/, '');
			}
		});
	}
</script>
