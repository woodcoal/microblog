---
/**
 * 全局搜索页面
 *
 * 分为"微博"和"用户"两个标签页，
 * 搜索框输入关键词后提交搜索。
 * URL 参数：?q=关键词&tab=posts|users&cursor=xxx&mode=xxx&categoryId=xxx
 * 默认显示微博搜索结果，切换标签页时保持搜索关键词。
 * 支持 mode 过滤（全部/微博/论坛/博客）和分类下拉选择器。
 * 使用 SearchBox 和 SearchResults Astro 组件，完全服务端渲染。
 */
import BaseLayout from '@/layouts/Base.astro';
import SearchBox from '@/components/SearchBox.astro';
import SearchResults from '@/components/SearchResults.astro';
import { prisma } from '@/lib/db';
import { getModeLabel } from '@/lib/config';

interface PostResult {
	id: string;
	content: string;
	createdAt: string;
	isPinned: boolean;
	isGlobalPinned: boolean;
	likeCount: number;
	commentCount: number;
	mode: string;
	title: string | null;
	customCategory: string | null;
	categoryId: string | null;
	category: { id: string; name: string; slug: string; mode: string } | null;
	user: { id: string; username: string; displayName: string; avatarUrl: string };
	tags: Array<{ id: string; name: string }>;
}
interface UserResult {
	id: string;
	username: string;
	displayName: string;
	avatarUrl: string;
	bio: string;
	followerCount: number;
	followingCount: number;
	postCount: number;
	createdAt: string;
}

type AllResult =
	| { type: 'post'; createdAt: string; value: PostResult }
	| { type: 'user'; createdAt: string; value: UserResult };

// 解析 URL 参数
const q = Astro.url.searchParams.get('q')?.trim() || '';
const tabParam = Astro.url.searchParams.get('tab');
const tab = tabParam === 'users' ? 'users' : tabParam === 'posts' ? 'posts' : 'all';
const cursor = Astro.url.searchParams.get('cursor') || '';
// 排序方式：latest=按时间倒序（默认），popular=按点赞数倒序再按时间倒序
const sort = Astro.url.searchParams.get('sort') === 'popular' ? 'popular' : 'latest';
// mode 过滤：all（全部，默认）、weibo、forum、blog
const modeParam = Astro.url.searchParams.get('mode') || 'all';
const validModes = ['all', 'weibo', 'forum', 'blog'];
const modeFilter = validModes.includes(modeParam) ? modeParam : 'all';
// 分类过滤：categoryId 参数
const categoryIdParam = Astro.url.searchParams.get('categoryId')?.trim() || '';

// 兼容旧链接中的分类参数，并验证其与频道过滤匹配。
let categoryIdFilter = '';
if (categoryIdParam) {
	const cat = await prisma.category.findUnique({ where: { id: categoryIdParam } });
	if (cat && (modeFilter === 'all' || cat.mode === modeFilter)) {
		categoryIdFilter = categoryIdParam;
	}
}

// 帖子搜索结果
let posts: PostResult[] = [];
let nextPostsCursor: string | null = null;

// 用户搜索结果
let users: UserResult[] = [];
let nextUsersCursor: string | null = null;
let allResults: AllResult[] = [];
let nextAllCursor: string | null = null;

if (q) {
	if (tab !== 'users') {
		// 查询帖子搜索结果
		const where = {
			visibility: 'public',
			isDeleted: false,
			content: { contains: q },
			// 游标分页：只取创建时间早于游标的帖子
			...(cursor ? { createdAt: { lt: new Date(cursor) } } : {}),
			// mode 过滤
			...(modeFilter !== 'all' ? { mode: modeFilter } : {}),
			// 分类过滤
			...(categoryIdFilter ? { categoryId: categoryIdFilter } : {})
		};

		// 根据排序方式决定排序规则
		const orderBy =
			tab !== 'all' && sort === 'popular'
				? [{ likes: { _count: 'desc' as const } }, { createdAt: 'desc' as const }]
				: [{ createdAt: 'desc' as const }];

		const rawPosts = await prisma.post.findMany({
			where,
			orderBy,
			take: 21,
			include: {
				user: {
					select: {
						id: true,
						username: true,
						displayName: true,
						avatarUrl: true
					}
				},
				tags: {
					include: {
						tag: {
							select: {
								id: true,
								name: true
							}
						}
					}
				},
				category: {
					select: {
						id: true,
						name: true,
						slug: true,
						mode: true
					}
				},
				_count: {
					select: { likes: true, comments: true }
				}
			}
		});

		const hasNextPage = rawPosts.length > 20;
		const items = hasNextPage ? rawPosts.slice(0, 20) : rawPosts;
		nextPostsCursor = hasNextPage ? items[items.length - 1].createdAt.toISOString() : null;

		posts = items.map((post) => ({
			id: post.id,
			content: post.content,
			createdAt: post.createdAt.toISOString(),
			isPinned: post.isPinned,
			isGlobalPinned: post.isGlobalPinned,
			likeCount: post._count.likes,
			commentCount: post._count.comments,
			mode: post.mode,
			title: post.title,
			customCategory: post.customCategory,
			categoryId: post.categoryId,
			category: post.category,
			user: {
				id: post.user.id,
				username: post.user.username,
				displayName: post.user.displayName,
				avatarUrl: post.user.avatarUrl
			},
			tags: post.tags.map((pt) => ({
				id: pt.tag.id,
				name: pt.tag.name
			}))
		}));
	}

	if (tab !== 'posts') {
		// 查询用户搜索结果
		const where = {
			isDisabled: false,
			OR: [{ username: { contains: q } }, { displayName: { contains: q } }],
			// 游标分页：只取创建时间早于游标的用户
			...(cursor ? { createdAt: { lt: new Date(cursor) } } : {})
		};

		const rawUsers = await prisma.user.findMany({
			where,
			orderBy: [{ createdAt: 'desc' }],
			take: 21,
			select: {
				id: true,
				username: true,
				displayName: true,
				avatarUrl: true,
				bio: true,
				createdAt: true,
				_count: {
					select: {
						followers: true,
						following: true,
						posts: {
							where: { isDeleted: false, visibility: 'public' }
						}
					}
				}
			}
		});

		const hasNextPage = rawUsers.length > 20;
		const items = hasNextPage ? rawUsers.slice(0, 20) : rawUsers;
		nextUsersCursor = hasNextPage ? items[items.length - 1].createdAt.toISOString() : null;

		users = items.map((user) => ({
			id: user.id,
			username: user.username,
			displayName: user.displayName,
			avatarUrl: user.avatarUrl,
			bio: user.bio,
			followerCount: user._count.followers,
			followingCount: user._count.following,
			postCount: user._count.posts,
			createdAt: user.createdAt.toISOString()
		}));
	}

	// 综合页将帖子与用户按创建时间合并，保持单一的时间线阅读顺序。
	if (tab === 'all') {
		const orderedResults: AllResult[] = [
			...posts.map((post) => ({
				type: 'post' as const,
				createdAt: post.createdAt,
				value: post
			})),
			...users.map((user) => ({
				type: 'user' as const,
				createdAt: user.createdAt,
				value: user
			}))
		].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
		allResults = orderedResults.slice(0, 20);
		const hasMoreResults =
			orderedResults.length > allResults.length || !!nextPostsCursor || !!nextUsersCursor;
		nextAllCursor = hasMoreResults ? (allResults.at(-1)?.createdAt ?? null) : null;
	}
}

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const isAllTab = tab === 'all';
const isPostsTab = tab === 'posts';
const isUsersTab = tab === 'users';
const isModeAll = modeFilter === 'all';
const isModeWeibo = modeFilter === 'weibo';
const isModeForum = modeFilter === 'forum';
const isModeBlog = modeFilter === 'blog';
/** 构建搜索 URL 的辅助函数，保持所有筛选参数 */
function buildSearchUrl(params: {
	q?: string;
	tab?: string;
	sort?: string;
	mode?: string;
	categoryId?: string;
	cursor?: string;
}): string {
	const sp = new URLSearchParams();
	if (params.q !== undefined) sp.set('q', params.q);
	else if (q) sp.set('q', q);
	if (params.tab !== undefined) sp.set('tab', params.tab);
	else if (tab) sp.set('tab', tab);
	if (params.sort !== undefined) sp.set('sort', params.sort);
	else if (sort) sp.set('sort', sort);
	if (params.mode !== undefined) sp.set('mode', params.mode);
	else if (modeFilter) sp.set('mode', modeFilter);
	if (params.categoryId !== undefined) {
		if (params.categoryId) sp.set('categoryId', params.categoryId);
	} else if (categoryIdFilter) {
		sp.set('categoryId', categoryIdFilter);
	}
	if (params.cursor !== undefined && params.cursor) sp.set('cursor', params.cursor);
	return `/search?${sp.toString()}`;
}
---

<BaseLayout title={q ? `搜索: ${q}` : '搜索'}>
	<section class="search-template" aria-labelledby="search-page-title">
		<h1 id="search-page-title">搜索</h1>

		<!-- search-a 的简洁搜索框 -->
		<div class="search-box-wrapper">
			<SearchBox
				initialQuery={q}
				placeholder="搜索帖子或用户..."
				tab={tab}
				mode={modeFilter}
				categoryId={categoryIdFilter}
			/>
		</div>

		<!-- 标签页切换 -->
		<div class="search-tabs">
			<a
				href={buildSearchUrl({ tab: 'all', mode: 'all', categoryId: '' })}
				class:list={['search-tab', { 'search-tab-active': isAllTab && isModeAll }]}
			>
				综合
			</a>
			<a
				href={buildSearchUrl({ tab: 'posts', mode: 'weibo', categoryId: '' })}
				class:list={['search-tab', { 'search-tab-active': isPostsTab && isModeWeibo }]}
				>{getModeLabel('weibo')}</a
			>
			<a
				href={buildSearchUrl({ tab: 'posts', mode: 'forum', categoryId: '' })}
				class:list={['search-tab', { 'search-tab-active': isPostsTab && isModeForum }]}
				>{getModeLabel('forum')}</a
			>
			<a
				href={buildSearchUrl({ tab: 'posts', mode: 'blog', categoryId: '' })}
				class:list={['search-tab', { 'search-tab-active': isPostsTab && isModeBlog }]}
				>{getModeLabel('blog')}</a
			>
			<a
				href={buildSearchUrl({ tab: 'users', categoryId: '' })}
				class:list={['search-tab', { 'search-tab-active': isUsersTab }]}
			>
				用户
			</a>
		</div>

		<!-- 搜索结果 -->
		<SearchResults
			tab={tab}
			query={q}
			sort={sort}
			modeFilter={modeFilter}
			categoryIdFilter={categoryIdFilter}
			posts={posts}
			nextPostsCursor={nextPostsCursor}
			users={users}
			nextUsersCursor={nextUsersCursor}
			allResults={allResults}
			nextAllCursor={nextAllCursor}
		/>
	</section>
</BaseLayout>

<style>
	.search-template {
		width: min(100% - 2 * var(--spacing-4), 980px);
		margin: 0 auto;
		padding: clamp(var(--spacing-6), 5vw, 2.5rem) 0 var(--spacing-12);
	}

	.search-template > h1 {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 1.75rem);
		letter-spacing: -0.04em;
	}

	.search-tabs {
		display: flex;
		gap: 0;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--spacing-2);
		overflow-x: auto;
	}
	.search-tab {
		flex: 0 0 auto;
		padding: 0.625rem 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		border-radius: 0;
		margin-bottom: -1px;
		transition:
			color 0.2s,
			border-color 0.2s;
	}
	.search-tab:hover {
		color: var(--color-text);
	}
	.search-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
		font-weight: 700;
	}
	.search-box-wrapper {
		position: relative;
		margin: var(--spacing-5) 0 var(--spacing-3);
	}
</style>
