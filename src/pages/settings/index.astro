---
/**
 * 个人设置页面
 *
 * SSR 分页设置，通过 URL 查询参数 ?tab= 切换各选项卡。
 * 每次只渲染当前选项卡内容，避免客户端隐藏 React 岛屿导致的水合问题。
 *
 * 支持选项卡：
 * - profile    — 个人资料
 * - security   — 账号安全
 * - appearance — 外观
 * - notification — 通知 + Webhook
 * - tokens     — API Token
 * - note       — 用户记录
 */
import WeiboLayout from '@/layouts/WeiboLayout.astro';
import TokenManager from '@/components/TokenManager.astro';
import WebhookManager from '@/components/WebhookManager.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { THEMES, DEFAULT_THEME } from '@/lib/theme';

// 需要认证，未登录重定向
const currentUser = await getUserFromRequest(Astro);
if (!currentUser) {
	return Astro.redirect('/login');
}

// 当前选项卡（默认 profile）
const tab = Astro.url.searchParams.get('tab') || 'profile';
const validTabs = ['profile', 'security', 'appearance', 'notification', 'tokens', 'note'];

// 并行查询用户设置、用户信息、Token 列表、Webhook 列表
const [settings, user, tokens, webhooks] = await Promise.all([
	prisma.userSettings.findUnique({
		where: { userId: currentUser.userId }
	}),
	prisma.user.findUnique({
		where: { id: currentUser.userId },
		select: {
			displayName: true,
			bio: true,
			avatarUrl: true,
			note: true
		}
	}),
	prisma.apiToken.findMany({
		where: { userId: currentUser.userId },
		select: {
			id: true,
			name: true,
			lastUsedAt: true,
			createdAt: true
		},
		orderBy: { createdAt: 'desc' }
	}),
	prisma.webhook.findMany({
		where: { userId: currentUser.userId },
		orderBy: { createdAt: 'desc' }
	})
]);

// 当前主题（设置不存在时使用默认值）
const currentTheme = settings?.theme ?? DEFAULT_THEME;
// 当前评论排序偏好
const currentSortOrder = settings?.commentSortOrder ?? 'asc';
// 当前通知开关状态
const notificationsEnabled = settings?.notificationsEnabled ?? true;

// 用户基本信息
const displayName = user?.displayName ?? '';
const bio = user?.bio ?? '';
const avatarUrl = user?.avatarUrl ?? '';
const note = user?.note ?? '';

// 序列化数据（将 Date 对象转为字符串，供 React 组件使用）
const serializedTokens = tokens.map((t: any) => ({
	...t,
	lastUsedAt: t.lastUsedAt ? t.lastUsedAt.toISOString() : null,
	createdAt: t.createdAt.toISOString()
}));

// Webhook 列表 secret 脱敏
const serializedWebhooks = webhooks.map((w: any) => ({
	...w,
	secret: w.secret.slice(0, 8) + '***',
	createdAt: w.createdAt.toISOString(),
	updatedAt: w.updatedAt.toISOString()
}));

// 选项卡定义
const tabs = [
	{ id: 'profile', label: '个人资料' },
	{ id: 'security', label: '账号安全' },
	{ id: 'appearance', label: '外观' },
	{ id: 'notification', label: '通知' },
	{ id: 'tokens', label: 'API Token' },
	{ id: 'note', label: '用户记录' }
];

// 简写构建选项卡链接
const tabUrl = (id: string) => (id === 'profile' ? '/settings' : `/settings?tab=${id}`);
---

<WeiboLayout title="设置">
	<div class="settings-page">
		<h1 class="page-title">个人设置</h1>

		<nav class="settings-tabs">
			{
				tabs.map((t) => (
					<a href={tabUrl(t.id)} class:list={['settings-tab', { active: tab === t.id }]}>
						{t.label}
					</a>
				))
			}
		</nav>

		<div class="settings-content">
			{
				tab === 'profile' && (
					<section class="settings-section">
						<h2 class="section-title">个人资料</h2>
						<p class="section-desc">管理你的公开个人信息</p>
						<form id="profile-form" class="settings-form">
							<div class="form-group">
								<label for="displayName" class="form-label">
									显示名
								</label>
								<input
									type="text"
									id="displayName"
									name="displayName"
									class="form-input"
									value={displayName}
									maxlength="50"
									placeholder="输入显示名"
								/>
								<span class="form-hint">1-50 个字符</span>
							</div>
							<div class="form-group">
								<label for="bio" class="form-label">
									简介
								</label>
								<textarea
									id="bio"
									name="bio"
									class="form-input form-textarea"
									maxlength="160"
									rows="3"
									placeholder="介绍一下自己"
								>
									{bio}
								</textarea>
								<span class="form-hint">最多 160 个字符</span>
							</div>
							<div class="form-group">
								<label class="form-label">头像</label>
								<div class="avatar-upload">
									<div class="avatar-preview" id="avatar-preview">
										{avatarUrl ? (
											<img
												src={avatarUrl}
												alt="当前头像"
												class="avatar-img"
											/>
										) : (
											<span class="avatar-placeholder">
												{displayName.charAt(0).toUpperCase() || 'U'}
											</span>
										)}
									</div>
									<div class="avatar-actions">
										<label
											for="avatar-file"
											class="btn btn-outline avatar-upload-btn"
										>
											选择图片
										</label>
										<input
											type="file"
											id="avatar-file"
											name="avatar-file"
											accept="image/jpeg,image/png,image/gif,image/webp"
											class="avatar-file-input"
										/>
										<span class="avatar-hint">
											支持 JPG/PNG/GIF/WebP，最大 2MB
										</span>
									</div>
								</div>
								<input
									type="hidden"
									id="avatarUrl"
									name="avatarUrl"
									value={avatarUrl}
								/>
							</div>
							<div class="form-actions">
								<button type="submit" class="btn btn-primary">
									保存资料
								</button>
								<span id="profile-msg" class="form-msg" />
							</div>
						</form>
					</section>
				)
			}

			{
				tab === 'security' && (
					<section class="settings-section">
						<h2 class="section-title">账号安全</h2>
						<p class="section-desc">修改你的登录密码</p>
						<form id="password-form" class="settings-form">
							<div class="form-group">
								<label for="oldPassword" class="form-label">
									旧密码
								</label>
								<input
									type="password"
									id="oldPassword"
									name="oldPassword"
									class="form-input"
									placeholder="输入当前密码"
									autocomplete="current-password"
								/>
							</div>
							<div class="form-group">
								<label for="newPassword" class="form-label">
									新密码
								</label>
								<input
									type="password"
									id="newPassword"
									name="newPassword"
									class="form-input"
									placeholder="输入新密码"
									autocomplete="new-password"
								/>
								<span class="form-hint">至少 8 个字符</span>
							</div>
							<div class="form-group">
								<label for="confirmPassword" class="form-label">
									确认新密码
								</label>
								<input
									type="password"
									id="confirmPassword"
									name="confirmPassword"
									class="form-input"
									placeholder="再次输入新密码"
									autocomplete="new-password"
								/>
							</div>
							<div class="form-actions">
								<button type="submit" class="btn btn-primary">
									修改密码
								</button>
								<span id="password-msg" class="form-msg" />
							</div>
						</form>
					</section>
				)
			}

			{
				tab === 'appearance' && (
					<section class="settings-section">
						<h2 class="section-title">外观</h2>
						<p class="section-desc">自定义界面显示偏好</p>

						<div class="form-group">
							<span class="form-label" aria-label="主题偏好">
								主题
							</span>
							<div class="theme-buttons">
								{THEMES.map((theme) => {
									const isActive = theme.id === currentTheme;
									return (
										<button
											type="button"
											class:list={['theme-btn', { active: isActive }]}
											data-theme-id={theme.id}
										>
											{theme.name}
										</button>
									);
								})}
							</div>
						</div>

						<div class="form-group">
							<label for="commentSortOrder" class="form-label">
								评论排序
							</label>
							<select id="commentSortOrder" class="form-input form-select">
								<option value="asc" selected={currentSortOrder === 'asc'}>
									正序（最早优先）
								</option>
								<option value="desc" selected={currentSortOrder === 'desc'}>
									倒序（最新优先）
								</option>
							</select>
						</div>
						<div class="form-actions">
							<button type="button" id="save-appearance" class="btn btn-primary">
								保存偏好
							</button>
							<span id="appearance-msg" class="form-msg" />
						</div>
					</section>
				)
			}

			{
				tab === 'notification' && (
					<section class="settings-section">
						<h2 class="section-title">通知</h2>
						<p class="section-desc">管理通知接收偏好</p>
						<div class="form-group">
							<label class="toggle-label">
								<input
									type="checkbox"
									id="notificationsEnabled"
									name="notificationsEnabled"
									checked={notificationsEnabled}
								/>
								<span>接收通知</span>
							</label>
							<span class="form-hint">
								关闭后将不再接收任何通知，通知栏目也会隐藏
							</span>
						</div>
						<div class="form-actions">
							<button type="button" id="save-notification" class="btn btn-primary">
								保存设置
							</button>
							<span id="notification-msg" class="form-msg" />
						</div>

						<hr class="settings-divider" />

						<WebhookManager initialWebhooks={JSON.stringify(serializedWebhooks)} />
					</section>
				)
			}

			{
				tab === 'tokens' && (
					<section class="settings-section">
						<TokenManager initialTokens={JSON.stringify(serializedTokens)} />
					</section>
				)
			}

			{
				tab === 'note' && (
					<section class="settings-section">
						<h2 class="section-title">用户记录</h2>
						<p class="section-desc">记录私人信息，仅自己可见</p>
						<form id="note-form" class="settings-form">
							<div class="form-group">
								<textarea
									id="note"
									name="note"
									class="form-input form-textarea note-textarea"
									maxlength="2000"
									placeholder="记录一些私人信息，仅自己可见"
								>
									{note}
								</textarea>
								<span class="form-hint">最多 2000 个字符，仅自己可见</span>
							</div>
							<div class="form-actions">
								<button type="submit" class="btn btn-primary">
									保存记录
								</button>
								<span id="note-msg" class="form-msg" />
							</div>
						</form>
					</section>
				)
			}
		</div><!-- /.settings-content -->
	</div>
</WeiboLayout>

<script>
	import { actions } from 'astro:actions';

	/**
	 * 设置页面客户端交互逻辑
	 *
	 * 处理个人资料、密码修改、外观偏好、通知、用户记录的表单提交。
	 * 选项卡切换由服务端渲染完成（?tab= 参数），客户端无需处理。
	 */

	/** 显示提示消息 */
	function showMsg(el: HTMLElement, text: string, isError: boolean) {
		el.textContent = text;
		el.className = isError ? 'form-msg msg-error' : 'form-msg msg-success';
		setTimeout(() => {
			el.textContent = '';
		}, 3000);
	}

	// ===== 头像上传 =====
	const avatarFileInput = document.getElementById('avatar-file') as HTMLInputElement;
	const avatarPreview = document.getElementById('avatar-preview') as HTMLElement;
	const avatarUrlInput = document.getElementById('avatarUrl') as HTMLInputElement;

	avatarFileInput?.addEventListener('change', async () => {
		const file = avatarFileInput.files?.[0];
		if (!file) return;

		if (file.size > 2 * 1024 * 1024) {
			await MutanDialog.alert('头像图片大小不能超过 2MB', { title: '提示' });
			avatarFileInput.value = '';
			return;
		}

		const reader = new FileReader();
		reader.onload = (e) => {
			const imgSrc = e.target?.result as string;
			avatarPreview.innerHTML = `<img src="${imgSrc}" alt="头像预览" class="avatar-img" />`;
		};
		reader.readAsDataURL(file);

		const formData = new FormData();
		formData.append('image', file);
		const result = await actions.uploadAvatar(formData);
		if (result.error) {
			await MutanDialog.alert(result.error.message || '头像上传失败');
			avatarFileInput.value = '';
		} else {
			avatarUrlInput.value = result.data.avatarUrl;
			showMsg(profileMsg, '头像已更新', false);
		}
	});

	// ===== 个人资料表单 =====
	const profileForm = document.getElementById('profile-form') as HTMLFormElement;
	const profileMsg = document.getElementById('profile-msg') as HTMLElement;

	profileForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const formData = new FormData(profileForm);
		const displayName = formData.get('displayName') as string;
		const bio = formData.get('bio') as string;
		const avatarUrl = formData.get('avatarUrl') as string;

		const result = await actions.updateProfile({ displayName, bio, avatarUrl });
		if (result.error) {
			showMsg(profileMsg, result.error.message ?? '更新失败', true);
		} else {
			showMsg(profileMsg, '资料已更新', false);
		}
	});

	// ===== 密码修改表单 =====
	const passwordForm = document.getElementById('password-form') as HTMLFormElement;
	const passwordMsg = document.getElementById('password-msg') as HTMLElement;

	passwordForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const formData = new FormData(passwordForm);
		const oldPassword = formData.get('oldPassword') as string;
		const newPassword = formData.get('newPassword') as string;
		const confirmPassword = formData.get('confirmPassword') as string;

		if (newPassword !== confirmPassword) {
			showMsg(passwordMsg, '两次输入的新密码不一致', true);
			return;
		}

		const result = await actions.changePassword({ oldPassword, newPassword });
		if (result.error) {
			showMsg(passwordMsg, result.error.message ?? '修改失败', true);
		} else {
			showMsg(passwordMsg, '密码修改成功', false);
			passwordForm.reset();
		}
	});

	// ===== 外观偏好 =====
	let selectedTheme: string | null = null;
	const themeButtons = document.querySelectorAll('.theme-btn');
	const sortOrderSelect = document.getElementById('commentSortOrder') as HTMLSelectElement;
	const saveAppearanceBtn = document.getElementById('save-appearance');
	const appearanceMsg = document.getElementById('appearance-msg') as HTMLElement;

	themeButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			themeButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			selectedTheme = (btn as HTMLElement).dataset.themeId ?? null;
		});
	});

	saveAppearanceBtn?.addEventListener('click', async () => {
		const commentSortOrder = sortOrderSelect?.value;
		const body: Record<string, string> = {};
		if (selectedTheme) body.theme = selectedTheme;
		if (commentSortOrder) body.commentSortOrder = commentSortOrder;

		const result = await actions.updateSettings(body);
		if (result.error) {
			showMsg(appearanceMsg, result.error.message ?? '保存失败', true);
		} else {
			showMsg(appearanceMsg, '偏好已保存', false);
			if (selectedTheme) {
				document.documentElement.setAttribute('data-theme', selectedTheme);
			}
		}
	});

	// ===== 通知设置 =====
	const notificationsCheckbox = document.getElementById(
		'notificationsEnabled'
	) as HTMLInputElement;
	const saveNotificationBtn = document.getElementById('save-notification');
	const notificationMsg = document.getElementById('notification-msg') as HTMLElement;

	saveNotificationBtn?.addEventListener('click', async () => {
		const enabled = notificationsCheckbox?.checked ?? true;
		const result = await actions.updateSettings({ notificationsEnabled: enabled });
		if (result.error) {
			showMsg(notificationMsg, result.error.message ?? '保存失败', true);
		} else {
			showMsg(notificationMsg, '通知设置已保存', false);
		}
	});

	// ===== 用户记录：文本域自适应高度 =====
	const noteTextarea = document.getElementById('note') as HTMLTextAreaElement;
	const autoResize = (el: HTMLTextAreaElement) => {
		el.style.height = 'auto';
		el.style.height = el.scrollHeight + 'px';
	};
	noteTextarea?.addEventListener('input', () => autoResize(noteTextarea));
	// 初始设置高度
	if (noteTextarea) autoResize(noteTextarea);

	// ===== 用户记录表单 =====
	const noteForm = document.getElementById('note-form') as HTMLFormElement;
	const noteMsg = document.getElementById('note-msg') as HTMLElement;

	noteForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const formData = new FormData(noteForm);
		const note = formData.get('note') as string;

		const result = await actions.updateProfile({ note });
		if (result.error) {
			showMsg(noteMsg, result.error.message ?? '保存失败', true);
		} else {
			showMsg(noteMsg, '记录已保存', false);
		}
	});
</script>

<style is:global>
	/* 设置页面 */
	.settings-page {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--spacing-6) var(--spacing-4);
	}

	.settings-page .page-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: var(--spacing-6);
	}

	/* 顶部选项卡导航 */
	.settings-tabs {
		display: flex;
		gap: 2px;
		margin-bottom: var(--spacing-6);
		padding: var(--spacing-1);
		background: var(--color-card-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow-x: auto;
	}

	.settings-tab {
		flex-shrink: 0;
		padding: 0.5rem 0.875rem;
		font-size: 0.875rem;
		color: var(--color-text);
		background: none;
		border: none;
		border-radius: var(--radius-sm);
		cursor: pointer;
		white-space: nowrap;
		text-decoration: none;
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.settings-tab:hover {
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
	}

	.settings-tab.active {
		background: var(--color-primary);
		color: #fff;
		font-weight: 600;
	}

	/* 设置区块 */
	.settings-section {
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.settings-section .section-title {
		font-size: 1.0625rem;
		font-weight: 700;
		margin-bottom: var(--spacing-1);
	}

	.settings-section .section-desc {
		font-size: 0.8125rem;
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.settings-section .settings-section {
		border: none;
		padding: 0;
	}

	.settings-section .settings-section .section-title {
		font-size: 1rem;
	}

	/* 区块内分割线 */
	.settings-divider {
		margin: var(--spacing-5) 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}

	/* 表单布局 */
	.settings-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.settings-form .form-textarea {
		resize: vertical;
		min-height: 60px;
	}

	.settings-form .form-select {
		appearance: auto;
		max-width: 240px;
	}

	.form-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.form-msg {
		font-size: 0.8125rem;
	}

	.msg-success {
		color: var(--color-success);
	}

	.msg-error {
		color: var(--color-danger);
	}

	/* 主题按钮组 */
	.theme-buttons {
		display: flex;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.theme-btn {
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		font-size: 0.875rem;
		background: var(--color-card-bg);
		color: var(--color-text);
		cursor: pointer;
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast);
	}

	.theme-btn:hover {
		border-color: var(--color-primary);
	}

	.theme-btn.active {
		border-color: var(--color-primary);
		background: var(--color-primary);
		color: #fff;
	}

	/* 通知开关标签 */
	.toggle-label {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: 0.9375rem;
		cursor: pointer;
	}

	.toggle-label input[type='checkbox'] {
		accent-color: var(--color-primary);
		width: 18px;
		height: 18px;
	}

	/* 头像上传 */
	.avatar-upload {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.avatar-preview {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		border: 2px solid var(--color-border);
	}

	.avatar-img {
		width: 100%;
		height: 100%;
