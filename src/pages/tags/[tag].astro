---
/**
 * 标签聚合页面
 *
 * 展示使用该标签的所有帖子。
 * 标签不存在或已隐藏时显示 404。
 */
import WeiboLayout from '@/layouts/WeiboLayout.astro';
import PostCard from '@/components/PostCard.astro';
import InfinitePostList from '@/components/InfinitePostList.astro';
import { prisma } from '@/lib/db';
import { renderMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getBookmarkedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { getUserFromRequest } from '@/lib/auth';
import ChannelAside from '@/components/ChannelAside.astro';
import { getPopularTagItems } from '@/lib/discovery';

// 路由参数
const tag = Astro.params.tag;

// 标签不存在返回 404
if (!tag) {
	return Astro.redirect('/404');
}

// 查询标签记录
const tagRecord = await prisma.tag.findUnique({ where: { name: tag } });

// 标签不存在或已隐藏时显示 404
if (!tagRecord || tagRecord.isHidden) {
	return Astro.redirect('/404');
}

// 获取当前登录用户（标签页可能需要检查帖子可见度）
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

/** 每页显示微博数量。 */
const PAGE_SIZE = 20;

// 解析排序参数：latest（最新，默认）、popular（热门）、oldest（最早）
const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const validSorts = ['latest', 'popular', 'oldest'];
const sort = validSorts.includes(sortParam) ? sortParam : 'latest';

// 根据排序方式构建 orderBy 条件
const orderBy: Record<string, unknown>[] = [{ isPinned: 'desc' }];
if (sort === 'popular') {
	orderBy.push({ likes: { _count: 'desc' } });
} else if (sort === 'oldest') {
	orderBy.push({ createdAt: 'asc' });
} else {
	orderBy.push({ createdAt: 'desc' });
}

const tagPostWhere = {
	isDeleted: false,
	mode: 'weibo',
	tags: { some: { tagId: tagRecord.id } },
	...visibilityFilter
};
const postCount = await prisma.post.count({ where: tagPostWhere });
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const totalPages = Math.max(1, Math.ceil(postCount / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);

// 标签页只查询微博，避免论坛/博客中同名标签混入。
const posts = await prisma.post.findMany({
	where: tagPostWhere,
	orderBy,
	skip: (safePage - 1) * PAGE_SIZE,
	take: PAGE_SIZE,
	include: {
		...POST_CARD_INCLUDE,
		likes: { select: { id: true } },
		comments: { select: { id: true } },
		bookmarks: { select: { id: true } }
	}
});

// 预计算每个帖子的可见度限制状态（避免在模板表达式中使用 await）
const restrictedMap = new Map<string, boolean>();
for (const post of posts) {
	const visible = await checkPostVisibility(
		{
			visibility: post.visibility,
			userId: post.userId,
			passwordHash: post.passwordHash,
			allowedUserIds: post.allowedUserIds
		},
		currentUser ? { userId: currentUser.userId } : null,
		{
			isFollower: followingIds.includes(post.userId),
			isFollowing: followerIds.includes(post.userId)
		}
	);
	restrictedMap.set(post.id, !visible);
}

// 判断帖子列表是否为空
const hasPosts = posts.length > 0;
const hasNextPage = safePage < totalPages;
const querySort = `sort=${encodeURIComponent(sort)}`;
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	posts.map((post) => post.id)
);
const discoveryItems = await getPopularTagItems({ excludeTagId: tagRecord.id });
const discoverySections =
	discoveryItems.length > 0
		? [
				{
					title: '更多热门话题',
					description: '继续浏览其他正在发生的讨论。',
					items: discoveryItems
				}
			]
		: [];
---

<WeiboLayout title={`#${tag}# - 标签`} hasAside={true}>
	<section class="tag-page ux-channel-page" aria-labelledby="tag-page-title">
		<div class="tag-page-header">
			<div class="tag-page-header-left">
				<p class="ux-eyebrow">主题标签</p>
				<h1 class="tag-page-title" id="tag-page-title">{tag}</h1>
				<span class="tag-page-count">{postCount} 条动态</span>
			</div>
			<div class="sort-tabs">
				<a
					href={`/tags/${tag}?sort=latest`}
					class:list={['sort-tab', { 'sort-tab-active': sort === 'latest' }]}
				>
					最新
				</a>
				<a
					href={`/tags/${tag}?sort=popular`}
					class:list={['sort-tab', { 'sort-tab-active': sort === 'popular' }]}
				>
					热门
				</a>
				<a
					href={`/tags/${tag}?sort=oldest`}
					class:list={['sort-tab', { 'sort-tab-active': sort === 'oldest' }]}
				>
					最早
				</a>
			</div>
		</div>

		{
			hasPosts ? (
				<div class="tag-page-posts" id="tag-post-list">
					{posts.map((post) => {
						// 提取标签列表
						const postTags = post.tags.map((pt) => ({
							id: pt.tag.id,
							name: pt.tag.name
						}));
						// 渲染 Markdown 内容
						const htmlContent = renderMarkdown(post.content);
						// 点赞数
						const likeCount = post.likes.length;
						// 从预计算结果中获取帖子可见度限制状态
						const isPostRestricted = restrictedMap.get(post.id) ?? false;
						const postBookmarked = bookmarkedPostIds.has(post.id);

						return (
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: {
										id: post.user.id,
										username: post.user.username,
										displayName: post.user.displayName,
										avatarUrl: post.user.avatarUrl
									},
									media: post.media.map((m) => ({
										id: m.id,
										fileType: m.fileType,
										fileStorage: {
											id: m.fileStorage.id,
											filePath: m.fileStorage.filePath,
											fileSize: m.fileStorage.fileSize,
											mimeType: m.fileStorage.mimeType,
											fileType: m.fileStorage.fileType
										}
									})),
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={htmlContent}
								likeCount={likeCount}
								commentCount={post._count.comments}
								bookmarkCount={post._count.bookmarks}
								bookmarked={postBookmarked}
								showFollow={!!currentUser}
								following={followingIds.includes(post.user.id)}
								isSelf={currentUser?.userId === post.user.id}
								tags={postTags}
								isRestricted={isPostRestricted}
							/>
						);
					})}
				</div>
			) : (
				<p class="tag-page-empty">该标签下暂无动态</p>
			)
		}
		<InfinitePostList
			listId="tag-post-list"
			nextUrl={hasNextPage
				? `/tags/${encodeURIComponent(tag)}?${querySort}&page=${safePage + 1}`
				: null}
		/>
	</section>
	<ChannelAside slot="aside" sections={discoverySections} />
</WeiboLayout>

<style>
	.tag-page {
		padding: 1rem 0;
	}
	.tag-page-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}
	.tag-page-header-left {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}
	.tag-page-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0;
	}
	.tag-page-count {
		font-size: 0.875rem;
		color: var(--color-muted);
	}
	.tag-page-posts {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.tag-page-empty {
		text-align: center;
		color: var(--color-muted);
		padding: 2rem 0;
	}

	/* 排序选项卡 — 普通下划线状态 */
	.sort-tabs {
		display: flex;
		gap: 0.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.sort-tab {
		padding: 0.5rem 0.75rem;
		font-size: 0.8125rem;
		color: var(--color-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.sort-tab:hover {
		color: var(--color-text);
		background: transparent;
	}

	.sort-tab-active {
		color: var(--color-primary);
		border-bottom-color: var(--color-primary);
		font-weight: 600;
	}
</style>
