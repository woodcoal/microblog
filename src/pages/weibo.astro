---
/**
 * 微博频道页
 *
 * 仅在 SITE_MODES 包含 weibo 时可访问，否则返回 404。
 * 时间线布局，顶部内嵌简单发布框（textarea + 可见度选择 + 发布按钮）。
 * 发布时 mode 自动设为 'weibo'，只显示 weibo 模式的帖子。
 * 支持分页浏览。
 */
import BaseLayout from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, POST_CONTENT_MAX_LENGTH } from '@/lib/config';

// 模式未启用时返回 404
if (!isModeEnabled('weibo')) {
	return Astro.redirect('/404');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 从 URL 查询参数获取当前页码，默认第 1 页
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 查询全局置顶帖（weibo 模式，始终在最前面）
const pinnedPosts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		isGlobalPinned: true,
		mode: 'weibo',
		...visibilityFilter
	},
	orderBy: [{ createdAt: 'desc' }],
	include: {
		...POST_CARD_INCLUDE,
		likes: { select: { id: true, userId: true } },
		comments: { select: { id: true } }
	}
});

// 查询非置顶 weibo 帖子总数
const totalPosts = await prisma.post.count({
	where: {
		isDeleted: false,
		isGlobalPinned: false,
		mode: 'weibo',
		...visibilityFilter
	}
});

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const skip = (safePage - 1) * PAGE_SIZE;

// 查询当前页的 weibo 帖子（按时间倒序）
const posts = await prisma.post.findMany({
	where: {
		isDeleted: false,
		isGlobalPinned: false,
		mode: 'weibo',
		...visibilityFilter
	},
	orderBy: [{ createdAt: 'desc' }],
	include: {
		...POST_CARD_INCLUDE,
		likes: { select: { id: true, userId: true } },
		comments: { select: { id: true } }
	},
	skip,
	take: PAGE_SIZE
});

// 合并置顶帖和当前页帖子（仅第一页显示置顶帖）
const allPosts = safePage === 1 ? [...pinnedPosts, ...posts] : posts;

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	allPosts.map((p) => p.id)
);

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = allPosts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
---

<BaseLayout title="微博">
	<div class="page-header">
		<h1 class="page-title">💬 微博</h1>
		<p class="page-desc">分享你的想法，随时随地说点什么</p>
	</div>

	{/* 内嵌发布框（仅已登录用户显示） */}
	{
		currentUser && (
			<div class="channel-compose">
				<form class="channel-compose-form" id="weibo-compose-form">
					<textarea
						class="form-input channel-compose-textarea"
						id="weibo-compose-content"
						placeholder="分享你的想法..."
						maxlength={POST_CONTENT_MAX_LENGTH}
						rows="3"
					/>
					<div class="channel-compose-footer">
						<div class="channel-compose-options">
							<select
								class="form-input channel-compose-visibility"
								id="weibo-compose-visibility"
							>
								<option value="public">🌐 公开</option>
								<option value="logged_in">🔐 登录用户可见</option>
								<option value="followers">👥 粉丝可见</option>
								<option value="following">🤝 我关注的人可见</option>
								<option value="private">🔒 仅自己可见</option>
							</select>
							<span class="channel-compose-count" id="weibo-char-count">
								0/{POST_CONTENT_MAX_LENGTH}
							</span>
						</div>
						<button
							class="btn btn-primary"
							type="submit"
							id="weibo-submit-btn"
							disabled
						>
							发布
						</button>
					</div>
					<p class="form-error" id="weibo-form-error" style="display:none" />
				</form>
			</div>
		)
	}

	{
		!hasPosts ? (
			<div class="empty-state">
				<p>还没有微博动态，注册后发第一条吧！</p>
			</div>
		) : (
			<div class="post-list">
				{allPosts.map(async (post) => {
					const postTags = post.tags.map((pt) => ({
						id: pt.tag.id,
						name: pt.tag.name
					}));
					const postLikeCount = post._count.likes;
					const postCommentCount = post._count.comments;
					const postLiked = likedPostIds.has(post.id);

					// 检查当前用户是否有权查看帖子内容
					const isPostRestricted = !(await checkPostVisibility(
						{
							visibility: post.visibility,
							userId: post.userId,
							passwordHash: post.passwordHash,
							allowedUserIds: post.allowedUserIds
						},
						currentUser ? { userId: currentUser.userId } : null,
						{
							isFollower: followingIds.includes(post.userId),
							isFollowing: followerIds.includes(post.userId)
						}
					));

					return (
						<PostCard
							post={{
								id: post.id,
								content: post.content,
								createdAt: post.createdAt.toISOString(),
								isPinned: post.isPinned,
								isGlobalPinned: post.isGlobalPinned,
								user: {
									id: post.user.id,
									username: post.user.username,
									displayName: post.user.displayName,
									avatarUrl: post.user.avatarUrl
								},
								media: post.media,
								visibility: post.visibility,
								mode: post.mode,
								title: post.title,
								categoryId: post.categoryId,
								category: post.category
							}}
							htmlContent={renderMarkdown(post.content)}
							likeCount={postLikeCount}
							liked={postLiked}
							commentCount={postCommentCount}
							tags={postTags}
							isRestricted={isPostRestricted}
						/>
					);
				})}
			</div>
		)
	}

	{/* 分页导航 */}
	{
		hasPagination && (
			<nav class="pagination" aria-label="分页导航">
				<div class="pagination-inner">
					{hasPrevPage ? (
						<a
							href={`/weibo?page=${safePage - 1}`}
							class="pagination-btn pagination-prev"
						>
							← 上一页
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">← 上一页</span>
					)}

					<span class="pagination-info">
						第 {safePage} / {totalPages} 页
					</span>

					{hasNextPage ? (
						<a
							href={`/weibo?page=${safePage + 1}`}
							class="pagination-btn pagination-next"
						>
							下一页 →
						</a>
					) : (
						<span class="pagination-btn pagination-disabled">下一页 →</span>
					)}
				</div>
			</nav>
		)
	}
</BaseLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* 频道内嵌发布框 */
	.channel-compose {
		margin-bottom: var(--spacing-6);
		padding: var(--spacing-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.channel-compose-textarea {
		min-height: 80px;
		resize: vertical;
	}

	.channel-compose-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: var(--spacing-3);
		gap: var(--spacing-3);
	}

	.channel-compose-options {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.channel-compose-visibility {
		width: auto;
		font-size: 0.8125rem;
		padding: 0.375rem 0.75rem;
	}

	.channel-compose-count {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
</style>

<script>
	/**
	 * 微博频道内嵌发布框客户端脚本
	 *
	 * 处理微博频道的快速发布功能：
	 * - 字数统计实时更新
	 * - 表单提交调用 actions.createPost（mode=weibo）
	 * - 发布成功后刷新页面
	 */
	import { actions } from 'astro:actions';

	const form = document.getElementById('weibo-compose-form') as HTMLFormElement | null;
	if (form) {
		const textarea = form.querySelector('#weibo-compose-content') as HTMLTextAreaElement;
		const visibilitySelect = form.querySelector(
			'#weibo-compose-visibility'
		) as HTMLSelectElement;
		const charCount = form.querySelector('#weibo-char-count') as HTMLSpanElement;
		const submitBtn = form.querySelector('#weibo-submit-btn') as HTMLButtonElement;
		const formError = form.querySelector('#weibo-form-error') as HTMLParagraphElement;
		const CONTENT_MAX_LENGTH = 1000;
		let loading = false;

		/**
		 * 更新字数统计和按钮状态
		 */
		function updateUI(): void {
			const len = textarea.value.length;
			const isNearLimit = len > CONTENT_MAX_LENGTH * 0.9;
			charCount.textContent = `${len}/${CONTENT_MAX_LENGTH}`;
			charCount.className = `channel-compose-count${isNearLimit ? ' text-danger' : ''}`;
			submitBtn.disabled = loading || !textarea.value.trim();
			submitBtn.textContent = loading ? '发布中...' : '发布';
		}

		/**
		 * 显示错误信息
		 *
		 * @param msg - 错误消息
		 */
		function showError(msg: string): void {
			formError.textContent = msg;
			formError.style.display = '';
		}

		// 输入事件
		textarea.addEventListener('input', updateUI);

		// 表单提交
		form.addEventListener('submit', async (e: Event) => {
			e.preventDefault();
			if (loading) return;

			const content = textarea.value.trim();
			if (!content) {
				showError('请输入内容');
				return;
			}
			if (content.length > CONTENT_MAX_LENGTH) {
				showError(`内容不能超过 ${CONTENT_MAX_LENGTH} 个字符`);
				return;
			}

			loading = true;
			updateUI();
			formError.style.display = 'none';

			try {
				const result = await actions.createPost({
					content,
					visibility: visibilitySelect.value,
					mode: 'weibo'
				});

				if (result.error) {
					showError(result.error.message || '发布失败');
					return;
				}

				// 发布成功，刷新页面
				window.location.reload();
			} catch {
				showError('网络错误，请稍后重试');
			} finally {
				loading = false;
				updateUI();
			}
		});
	}
</script>
