---
/**
 * 微博频道页
 *
 * 仅在 SITE_MODES 包含 weibo 时可访问，否则返回 404。
 * 时间线布局，只显示 weibo 模式的帖子。
 * 发布功能通过页面标题旁的"发布"按钮（ComposeModal）完成。
 * 支持分页浏览。
 */
import WeiboLayout from '@/layouts/WeiboLayout.astro';
import PostCard from '@/components/PostCard.astro';
import InfinitePostList from '@/components/InfinitePostList.astro';
import ChannelAside from '@/components/ChannelAside.astro';
import { prisma } from '@/lib/db';
import { getUserFromRequest } from '@/lib/auth';
import { renderMarkdown } from '@/lib/markdown';
import { POST_CARD_INCLUDE, getBookmarkedPostIds, getLikedPostIds } from '@/lib/queries';
import { getVisibilityFilter, checkPostVisibility } from '@/lib/visibility';
import { isModeEnabled, getModeLabel } from '@/lib/config';
import { getPublicSiteCopy } from '@/services/site-copy.service';
import { getPopularTagItems } from '@/lib/discovery';
import type { Prisma } from '../../generated/prisma/client';
import { getTrendingFeed } from '@/services/recommend.service';

// 模式未启用时返回 404
if (!isModeEnabled('weibo')) {
	return Astro.redirect('/404');
}

/** 每页显示帖子数量 */
const PAGE_SIZE = 20;

// 获取当前登录用户
const currentUser = await getUserFromRequest(Astro);

// 查询当前用户的关注关系，用于可见度过滤
const followingIds: string[] = [];
const followerIds: string[] = [];
if (currentUser) {
	const follows = await prisma.follow.findMany({
		where: { followerId: currentUser.userId },
		select: { followingId: true }
	});
	followingIds.push(...follows.map((f) => f.followingId));
	const followers = await prisma.follow.findMany({
		where: { followingId: currentUser.userId },
		select: { followerId: true }
	});
	followerIds.push(...followers.map((f) => f.followerId));
}
const visibilityFilter = getVisibilityFilter(currentUser ? { userId: currentUser.userId } : null, {
	followingIds,
	followerIds
});

// 从 URL 查询参数获取当前页码，默认第 1 页
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const isPopularSort = Astro.url.searchParams.get('sort') === 'popular';
const unifiedTrending = isPopularSort
	? await getTrendingFeed({
			viewerId: currentUser?.userId,
			page: currentPage,
			pageSize: PAGE_SIZE,
			mode: 'weibo',
			includeGlobalPinned: true
		})
	: null;
const timelineOrderBy: Prisma.PostOrderByWithRelationInput[] = [{ createdAt: 'desc' }];

// 查询全局置顶帖（weibo 模式，始终在最前面）
const pinnedPosts = unifiedTrending
	? []
	: await prisma.post.findMany({
			where: {
				isDeleted: false,
				user: { deletedAt: null },
				isGlobalPinned: true,
				mode: 'weibo',
				...visibilityFilter
			},
			orderBy: [{ createdAt: 'desc' }],
			include: {
				...POST_CARD_INCLUDE,
				likes: { select: { id: true, userId: true } },
				comments: { select: { id: true } },
				bookmarks: { select: { id: true } }
			}
		});

// 查询非置顶 weibo 帖子总数
const totalPosts =
	unifiedTrending?.total ??
	(await prisma.post.count({
		where: {
			isDeleted: false,
			user: { deletedAt: null },
			isGlobalPinned: false,
			mode: 'weibo',
			...visibilityFilter
		}
	}));

// 计算总页数
const totalPages = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const skip = (safePage - 1) * PAGE_SIZE;

// 查询当前页的微博帖子。热门视图复用既有互动计数排序，不改变数据契约。
const legacyPosts = unifiedTrending
	? []
	: await prisma.post.findMany({
			where: {
				isDeleted: false,
				user: { deletedAt: null },
				isGlobalPinned: false,
				mode: 'weibo',
				...visibilityFilter
			},
			orderBy: timelineOrderBy,
			include: {
				...POST_CARD_INCLUDE,
				likes: { select: { id: true, userId: true } },
				comments: { select: { id: true } },
				bookmarks: { select: { id: true } }
			},
			skip,
			take: PAGE_SIZE
		});

// 合并置顶帖和当前页帖子（仅第一页显示置顶帖）
const posts = unifiedTrending?.items ?? legacyPosts;
const allPosts = unifiedTrending?.items ?? (safePage === 1 ? [...pinnedPosts, ...posts] : posts);

// 查询当前用户对帖子的点赞状态
const likedPostIds = await getLikedPostIds(
	currentUser?.userId ?? null,
	allPosts.map((p) => p.id)
);
const bookmarkedPostIds = await getBookmarkedPostIds(
	currentUser?.userId ?? null,
	allPosts.map((p) => p.id)
);

const discoveryItems = await getPopularTagItems();
const discoverySections =
	discoveryItems.length > 0
		? [
				{
					title: '热门话题',
					description: '从正在被讨论的标签进入内容流。',
					items: discoveryItems
				}
			]
		: [];

// 在 frontmatter 中提取变量，避免模板表达式中使用比较运算符
const hasPosts = allPosts.length > 0;
const hasPrevPage = safePage > 1;
const hasNextPage = safePage < totalPages;
const hasPagination = totalPages > 1;
const heroCopy = await getPublicSiteCopy('channel.weibo.hero');
---

<WeiboLayout title={getModeLabel('weibo')} hasAside={true}>
	<section class="ux-channel-page ux-weibo-page" aria-labelledby="weibo-page-title">
		<div class="page-header">
			<div class="page-header-row">
				<div
					id="weibo-page-title"
					class="site-copy-content site-copy-content-channel"
					set:html={heroCopy.html}
				/>
				{
					currentUser && (
						<button
							type="button"
							class="btn btn-primary"
							onclick="document.dispatchEvent(new CustomEvent('open-compose-modal'))"
						>
							✏️ 发布
						</button>
					)
				}
			</div>
		</div>

		{
			!hasPosts ? (
				<div class="empty-state">
					<p>还没有{getModeLabel('weibo')}动态，注册后发第一条吧！</p>
				</div>
			) : (
				<div class="post-list" id="weibo-post-list">
					{allPosts.map(async (post) => {
						const postTags = post.tags.map((pt) => ({
							id: pt.tag.id,
							name: pt.tag.name
						}));
						const postLikeCount = post._count.likes;
						const postCommentCount = post._count.comments;
						const postLiked = likedPostIds.has(post.id);
						const postBookmarked = bookmarkedPostIds.has(post.id);

						// 检查当前用户是否有权查看帖子内容
						const isPostRestricted = !(await checkPostVisibility(
							{
								visibility: post.visibility,
								userId: post.userId,
								passwordHash: post.passwordHash,
								allowedUserIds: post.allowedUserIds
							},
							currentUser ? { userId: currentUser.userId } : null,
							{
								isFollower: followingIds.includes(post.userId),
								isFollowing: followerIds.includes(post.userId)
							}
						));

						return (
							<PostCard
								post={{
									id: post.id,
									content: post.content,
									createdAt: post.createdAt.toISOString(),
									isPinned: post.isPinned,
									isGlobalPinned: post.isGlobalPinned,
									user: {
										id: post.user.id,
										username: post.user.username,
										displayName: post.user.displayName,
										avatarUrl: post.user.avatarUrl
									},
									media: post.media,
									visibility: post.visibility,
									mode: post.mode,
									title: post.title,
									categoryId: post.categoryId,
									category: post.category
								}}
								htmlContent={renderMarkdown(post.content)}
								likeCount={postLikeCount}
								liked={postLiked}
								commentCount={postCommentCount}
								bookmarkCount={post._count.bookmarks}
								bookmarked={postBookmarked}
								showFollow={!!currentUser}
								following={followingIds.includes(post.user.id)}
								isSelf={currentUser?.userId === post.user.id}
								tags={postTags}
								isRestricted={isPostRestricted}
							/>
						);
					})}
				</div>
			)
		}
		<InfinitePostList
			listId="weibo-post-list"
			nextUrl={hasNextPage
				? `/weibo?page=${safePage + 1}${isPopularSort ? '&sort=popular' : ''}`
				: null}
		/>

		{/* 分页导航 */}
		{
			hasPagination && (
				<nav
					class="pagination"
					data-infinite-pagination="weibo-post-list"
					aria-label="分页导航"
				>
					<div class="pagination-inner">
						{hasPrevPage ? (
							<a
								href={`/weibo?page=${safePage - 1}${isPopularSort ? '&sort=popular' : ''}`}
								class="pagination-btn pagination-prev"
							>
								← 上一页
							</a>
						) : (
							<span class="pagination-btn pagination-disabled">← 上一页</span>
						)}

						<span class="pagination-info">
							第 {safePage} / {totalPages} 页
						</span>

						{hasNextPage ? (
							<a
								href={`/weibo?page=${safePage + 1}${isPopularSort ? '&sort=popular' : ''}`}
								class="pagination-btn pagination-next"
							>
								下一页 →
							</a>
						) : (
							<span class="pagination-btn pagination-disabled">下一页 →</span>
						)}
					</div>
				</nav>
			)
		}
	</section>
	<ChannelAside slot="aside" sections={discoverySections} />
</WeiboLayout>

<style>
	/* 页面头部 */
	.page-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.page-header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-4);
	}

	.page-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.page-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}
</style>
